rules_version = '2';
// =============================================================
// Firestore Security Rules — Multi-tenant School Isolation
// Project: schoolmanagementsaas-a7bad
// Tenancy: each user belongs to ONE school via school_admins/{email}.
// Every tenant record carries a `schoolId`. A user can never read or
// write a record whose schoolId differs from their own school.
// Owners (emails below) may access every school.
// =============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

        function isOwner() {
      // Platform accounts live in the `users` collection (document ID = email).
      // A user is a Super Owner when their account carries role 'owner'
      // ('super_owner' kept for backward compatibility) and is not inactive.
      // Authoritative server-side gate — no emails hardcoded anywhere.
      return signedIn() && request.auth.token.email != null
        && exists(/databases/$(database)/documents/users/$(request.auth.token.email))
        && get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role in ['owner', 'super_owner']
        && get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.status != 'inactive';
    }

    function userSchoolId() {
      let adminPath = /databases/$(database)/documents/school_admins/$(request.auth.token.email);
      let ownerPath  = /databases/$(database)/documents/school_owners/$(request.auth.token.email);
      return exists(adminPath) ? get(adminPath).data.schoolId
           : exists(ownerPath) ? get(ownerPath).data.schoolId
           : null;
    }

    function userRole() {
      let adminPath = /databases/$(database)/documents/school_admins/$(request.auth.token.email);
      // School owners (school_owners collection) are treated as admins of their school.
      return exists(adminPath) ? get(adminPath).data.role : 'admin';
    }

    function isStaffOf(schoolId) {
      return signedIn() && (isOwner() || userSchoolId() == schoolId);
    }

    function isAdminOf(schoolId) {
      return signedIn() && (isOwner() || (userSchoolId() == schoolId && userRole() in ['admin']));
    }

    function ownedBy(data, schoolId) {
      return data != null && data.schoolId != null && data.schoolId == schoolId;
    }

        // ---- Super Owners ----
    // Platform accounts (`users`). Document ID is the account email. A
    // signed-in user may GET its OWN document (the login role gate reads it);
    // listing or mutating any account requires Master Owner (isOwner).
    // Self-delete is blocked so an owner cannot lock themselves out.
    match /users/{email} {
      allow get: if signedIn() && (request.auth.token.email == email || isOwner());
      allow list: if isOwner();
      allow create, update: if isOwner();
      allow delete: if isOwner() && request.auth.token.email != email;
    }

    // ---- School Owners ----
    // The document ID is the School Owner's email (managed from the Master panel
    // under "School Owners"). A signed-in user may read its OWN document so the
    // dashboard login gate can recognise school owners; listing or mutating any
    // document requires Master Owner (isOwner) access.
    match /school_owners/{email} {
      allow read: if signedIn() && request.auth.token.email == email;
      allow list, create, update, delete: if isOwner();
    }

    // ---- Tenant registry ----
    // A School Owner / Administrator can manage the admins belonging to
    // their own school only. Owners may manage every school.
    match /school_admins/{email} {
      allow read:   if isOwner() || request.auth.token.email == email
                        || (signedIn() && resource != null && userSchoolId() == resource.data.schoolId);
      allow create: if isOwner()
                        || (isAdminOf(userSchoolId()) && ownedBy(request.resource.data, userSchoolId()));
      allow update: if isOwner()
                        || (isAdminOf(resource.data.schoolId)
                            && ownedBy(request.resource.data, resource.data.schoolId));
      allow delete: if isOwner() || isAdminOf(resource.data.schoolId);
    }

    // School profiles: staff read own school, admin updates own school.
    // The document ID *is* the schoolId; admins may update their own school doc.
    match /schools/{schoolId} {
      allow read:   if isStaffOf(schoolId);
      allow create: if isOwner();
      allow update: if isOwner() || (isAdminOf(schoolId)
                        && (!('schoolId' in request.resource.data)
                            || request.resource.data.schoolId == schoolId));
      allow delete: if isOwner();
    }

    // ---- Tenant collections ----
    // read: staff of the record's school
    // create: admin/teacher (or owner) of the NEW record's school
    // update: staff of the existing record's school; schoolId cannot change
    // delete: admin (or owner) of the record's school

    match /students/{docId} {
      allow read:   if isStaffOf(resource.data.schoolId);
      allow create: if isOwner() || (userRole() in ['admin', 'teacher'] && ownedBy(request.resource.data, userSchoolId()));
      allow update: if isOwner() || (userRole() in ['admin', 'teacher']
                        && isStaffOf(resource.data.schoolId)
                        && ownedBy(request.resource.data, resource.data.schoolId));
      allow delete: if isOwner() || isAdminOf(resource.data.schoolId);
    }

    match /teachers/{docId} {
      allow read:   if isStaffOf(resource.data.schoolId);
      allow create: if isOwner() || (isAdminOf(userSchoolId()) && ownedBy(request.resource.data, userSchoolId()));
      allow update: if isOwner() || (isAdminOf(resource.data.schoolId)
                        && ownedBy(request.resource.data, resource.data.schoolId));
      allow delete: if isOwner() || isAdminOf(resource.data.schoolId);
    }

    match /classes/{docId} {
      allow read:   if isStaffOf(resource.data.schoolId);
      allow create: if isOwner() || (isAdminOf(userSchoolId()) && ownedBy(request.resource.data, userSchoolId()));
      allow update: if isOwner() || (isAdminOf(resource.data.schoolId)
                        && ownedBy(request.resource.data, resource.data.schoolId));
      allow delete: if isOwner() || isAdminOf(resource.data.schoolId);
    }

    match /attendance/{docId} {
      allow read:   if isStaffOf(resource.data.schoolId);
      allow create: if isOwner() || (userRole() in ['admin', 'teacher'] && ownedBy(request.resource.data, userSchoolId()));
      allow update: if isOwner() || (userRole() in ['admin', 'teacher']
                        && isStaffOf(resource.data.schoolId)
                        && ownedBy(request.resource.data, resource.data.schoolId));
      allow delete: if isOwner() || isAdminOf(resource.data.schoolId);
    }

    match /exams/{docId} {
      allow read:   if isStaffOf(resource.data.schoolId);
      allow create: if isOwner() || (userRole() in ['admin', 'teacher'] && ownedBy(request.resource.data, userSchoolId()));
      allow update: if isOwner() || (userRole() in ['admin', 'teacher']
                        && isStaffOf(resource.data.schoolId)
                        && ownedBy(request.resource.data, resource.data.schoolId));
      allow delete: if isOwner() || isAdminOf(resource.data.schoolId);
    }

    match /announcements/{docId} {
      allow read:   if isStaffOf(resource.data.schoolId);
      allow create: if isOwner() || (userRole() in ['admin', 'teacher'] && ownedBy(request.resource.data, userSchoolId()));
      allow update: if isOwner() || (userRole() in ['admin', 'teacher']
                        && isStaffOf(resource.data.schoolId)
                        && ownedBy(request.resource.data, resource.data.schoolId));
      allow delete: if isOwner() || isAdminOf(resource.data.schoolId);
    }

    match /fees/{docId} {
      allow read:   if isStaffOf(resource.data.schoolId);
      allow create: if isOwner() || (isAdminOf(userSchoolId()) && ownedBy(request.resource.data, userSchoolId()));
      allow update: if isOwner() || (isAdminOf(resource.data.schoolId)
                        && ownedBy(request.resource.data, resource.data.schoolId));
      allow delete: if isOwner() || isAdminOf(resource.data.schoolId);
    }

    match /fee_structures/{docId} {
      allow read:   if isStaffOf(resource.data.schoolId);
      allow create: if isOwner() || (isAdminOf(userSchoolId()) && ownedBy(request.resource.data, userSchoolId()));
      allow update: if isOwner() || (isAdminOf(resource.data.schoolId)
                        && ownedBy(request.resource.data, resource.data.schoolId));
      allow delete: if isOwner() || isAdminOf(resource.data.schoolId);
    }

    match /timetables/{docId} {
      allow read:   if isStaffOf(resource.data.schoolId);
      allow create: if isOwner() || (isAdminOf(userSchoolId()) && ownedBy(request.resource.data, userSchoolId()));
      allow update: if isOwner() || (isAdminOf(resource.data.schoolId)
                        && ownedBy(request.resource.data, resource.data.schoolId));
      allow delete: if isOwner() || isAdminOf(resource.data.schoolId);
    }

    match /books/{docId} {
      allow read:   if isStaffOf(resource.data.schoolId);
      allow create: if isOwner() || (isAdminOf(userSchoolId()) && ownedBy(request.resource.data, userSchoolId()));
      allow update: if isOwner() || (isAdminOf(resource.data.schoolId)
                        && ownedBy(request.resource.data, resource.data.schoolId));
      allow delete: if isOwner() || isAdminOf(resource.data.schoolId);
    }

    match /borrowings/{docId} {
      allow read:   if isStaffOf(resource.data.schoolId);
      allow create: if isOwner() || (isAdminOf(userSchoolId()) && ownedBy(request.resource.data, userSchoolId()));
      allow update: if isOwner() || (isAdminOf(resource.data.schoolId)
                        && ownedBy(request.resource.data, resource.data.schoolId));
      allow delete: if isOwner() || isAdminOf(resource.data.schoolId);
    }

    match /vehicles/{docId} {
      allow read:   if isStaffOf(resource.data.schoolId);
      allow create: if isOwner() || (isAdminOf(userSchoolId()) && ownedBy(request.resource.data, userSchoolId()));
      allow update: if isOwner() || (isAdminOf(resource.data.schoolId)
                        && ownedBy(request.resource.data, resource.data.schoolId));
      allow delete: if isOwner() || isAdminOf(resource.data.schoolId);
    }

    match /student_routes/{docId} {
      allow read:   if isStaffOf(resource.data.schoolId);
      allow create: if isOwner() || (isAdminOf(userSchoolId()) && ownedBy(request.resource.data, userSchoolId()));
      allow update: if isOwner() || (isAdminOf(resource.data.schoolId)
                        && ownedBy(request.resource.data, resource.data.schoolId));
      allow delete: if isOwner() || isAdminOf(resource.data.schoolId);
    }

    match /dormitories/{docId} {
      allow read:   if isStaffOf(resource.data.schoolId);
      allow create: if isOwner() || (isAdminOf(userSchoolId()) && ownedBy(request.resource.data, userSchoolId()));
      allow update: if isOwner() || (isAdminOf(resource.data.schoolId)
                        && ownedBy(request.resource.data, resource.data.schoolId));
      allow delete: if isOwner() || isAdminOf(resource.data.schoolId);
    }

    match /bed_assignments/{docId} {
      allow read:   if isStaffOf(resource.data.schoolId);
      allow create: if isOwner() || (isAdminOf(userSchoolId()) && ownedBy(request.resource.data, userSchoolId()));
      allow update: if isOwner() || (isAdminOf(resource.data.schoolId)
                        && ownedBy(request.resource.data, resource.data.schoolId));
      allow delete: if isOwner() || isAdminOf(resource.data.schoolId);
    }

    match /inventory_items/{docId} {
      allow read:   if isStaffOf(resource.data.schoolId);
      allow create: if isOwner() || (isAdminOf(userSchoolId()) && ownedBy(request.resource.data, userSchoolId()));
      allow update: if isOwner() || (isAdminOf(resource.data.schoolId)
                        && ownedBy(request.resource.data, resource.data.schoolId));
      allow delete: if isOwner() || isAdminOf(resource.data.schoolId);
    }

    match /stock_moves/{docId} {
      allow read:   if isStaffOf(resource.data.schoolId);
      allow create: if isOwner() || (isAdminOf(userSchoolId()) && ownedBy(request.resource.data, userSchoolId()));
      allow update: if isOwner() || (isAdminOf(resource.data.schoolId)
                        && ownedBy(request.resource.data, resource.data.schoolId));
      allow delete: if isOwner() || isAdminOf(resource.data.schoolId);
    }

    // ===== School Operations extensions =====
    // Academic years, terms, streams, subjects & teacher assignments are
    // configured per school by its admin/owner (read for any staff member).
    match /academic_years/{docId} {
      allow read:   if isStaffOf(resource.data.schoolId);
      allow create: if isOwner() || (isAdminOf(userSchoolId()) && ownedBy(request.resource.data, userSchoolId()));
      allow update: if isOwner() || (isAdminOf(resource.data.schoolId)
                        && ownedBy(request.resource.data, resource.data.schoolId));
      allow delete: if isOwner() || isAdminOf(resource.data.schoolId);
    }

    match /terms/{docId} {
      allow read:   if isStaffOf(resource.data.schoolId);
      allow create: if isOwner() || (isAdminOf(userSchoolId()) && ownedBy(request.resource.data, userSchoolId()));
      allow update: if isOwner() || (isAdminOf(resource.data.schoolId)
                        && ownedBy(request.resource.data, resource.data.schoolId));
      allow delete: if isOwner() || isAdminOf(resource.data.schoolId);
    }

    match /streams/{docId} {
      allow read:   if isStaffOf(resource.data.schoolId);
      allow create: if isOwner() || (isAdminOf(userSchoolId()) && ownedBy(request.resource.data, userSchoolId()));
      allow update: if isOwner() || (isAdminOf(resource.data.schoolId)
                        && ownedBy(request.resource.data, resource.data.schoolId));
      allow delete: if isOwner() || isAdminOf(resource.data.schoolId);
    }

    match /subjects/{docId} {
      allow read:   if isStaffOf(resource.data.schoolId);
      allow create: if isOwner() || (isAdminOf(userSchoolId()) && ownedBy(request.resource.data, userSchoolId()));
      allow update: if isOwner() || (isAdminOf(resource.data.schoolId)
                        && ownedBy(request.resource.data, resource.data.schoolId));
      allow delete: if isOwner() || isAdminOf(resource.data.schoolId);
    }

    match /teacher_assignments/{docId} {
      allow read:   if isStaffOf(resource.data.schoolId);
      allow create: if isOwner() || (isAdminOf(userSchoolId()) && ownedBy(request.resource.data, userSchoolId()));
      allow update: if isOwner() || (isAdminOf(resource.data.schoolId)
                        && ownedBy(request.resource.data, resource.data.schoolId));
      allow delete: if isOwner() || isAdminOf(resource.data.schoolId);
    }

    // Student academic history is append-mostly. It captures promotions,
    // transfers and placement changes without overwriting prior records.
    match /student_histories/{docId} {
      allow read:   if isStaffOf(resource.data.schoolId);
      allow create: if isOwner() || (userRole() in ['admin', 'teacher']
                        && ownedBy(request.resource.data, userSchoolId()));
      allow update: if isOwner() || isAdminOf(resource.data.schoolId);
      allow delete: if isOwner() || isAdminOf(resource.data.schoolId);
    }

    // Audit logs are append-only and school-scoped. Only admins/owner may read.
    match /audit_logs/{docId} {
      allow read:   if isOwner() || isAdminOf(resource.data.schoolId);
      allow create: if isOwner() || (userRole() in ['admin', 'teacher']
                        && ownedBy(request.resource.data, userSchoolId()));
      allow update: if false;
      allow delete: if isOwner();
    }

    // Deny everything not matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

