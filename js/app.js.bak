        window.assignBed = async (e) => {
            e.preventDefault();
            if(!canOp()) return showToast("Permission denied", "error");
            const studentId = document.getElementById('bed-student').value;
            const dormId = document.getElementById('bed-dorm').value;
            if(!studentId || !dormId) return showToast("Select student and dormitory", "warning");
            try {
                const ownStudent = await getScopedDoc('students', studentId);
                const ownDorm = await getScopedDoc('dormitories', dormId);
                if(!ownStudent || !ownDorm) return showToast("Student/dormitory not found in your school", "error");

                // Remove any existing active bed assignment for this student
                const existing = await getDocs(query(collection(db, 'bed_assignments'),
                    where('schoolId', '==', currentSchoolId), where('studentId', '==', studentId), where('status', '==', 'active')));
                for(const docSnap of existing.docs) {
                    await updateDoc(doc(db, 'bed_assignments', docSnap.id), { status: 'removed', updatedAt: new Date().toISOString() });
                }

                await addDoc(collection(db, 'bed_assignments'), {
                    schoolId: currentSchoolId,
                    studentId,
                    dormId,
                    room: document.getElementById('bed-room').value.trim(),
                    bed: document.getElementById('bed-number').value.trim(),
                    status: 'active',
                    assignedAt: new Date().toISOString()
                });
