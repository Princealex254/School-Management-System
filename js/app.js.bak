        window.openStockMove = () => {
            openModal('modal-stock-move');
        };

        window.saveStockMove = async (e) => {
            e.preventDefault();
            if(!canOp()) return showToast("Permission denied", "error");
            const itemId = document.getElementById('sm-item').value;
            const type = document.getElementById('sm-type').value.toLowerCase();
            const qty = parseInt(document.getElementById('sm-qty').value) || 0;
            if(!itemId) return showToast("Select an item", "warning");
            if(qty <= 0) return showToast("Quantity must be positive", "warning");
            try {
                const own = await getScopedDoc('inventory_items', itemId);
                if(!own) return showToast("Item not found in your school", "error");
                const item = own.data;
                if (type === 'out' && qty > (item.stock || 0)) return showToast("Not enough stock for this movement", "warning");
                const newStock = type === 'in' ? (item.stock || 0) + qty : Math.max(0, (item.stock || 0) - qty);
                await updateDoc(doc(db, 'inventory_items', itemId), { stock: newStock, updatedAt: new Date().toISOString() });
                await addDoc(collection(db, 'stock_moves'), {
                    schoolId: currentSchoolId,
                    itemId,
                    type,
                    qty,
                    note: document.getElementById('sm-note').value.trim(),
                    date: new Date().toISOString()
                });
                closeModal('modal-stock-move');
                showToast("Stock movement recorded", "success");
            } catch (err) { showToast(getFriendlyErrorMessage(err), "error"); }
        };

        /* @@OSLIB2@@ */

        function initRealtimeListeners() {
            // Students
            onSnapshot(query(collection(db, "students"), where("schoolId", "==", currentSchoolId)), async snap => {
                document.getElementById('count-students').innerText = snap.size;
                const tbody = document.getElementById('student-list-body');
                tbody.innerHTML = "";

                // Realtime cache and dropdown update
                allStudents = snap.docs.map(d => ({ docId: d.id, ...d.data() }));
                const studOptions = snap.docs.map(d => `<option value="${d.id}">${d.data().name}</option>`).join('');
                ['fee-student-select', 'exam-student-select'].forEach(id => {
                    const el = document.getElementById(id);
                    if(el) el.innerHTML = `<option value="">Select Student</option>${studOptions}`;
                });

                // Get class names for display
                const classSnap = await getDocs(query(collection(db, "classes"), where("schoolId", "==", currentSchoolId)));
                window.__opsClassMap = {};
                classSnap.forEach(d => window.__opsClassMap[d.id] = d.data().name);
                const __streamMap = {};
                (allStreams || []).forEach(s => { __streamMap[s.id] = s.name; });
                window.__opsStreamMap = __streamMap;
                populateStudentFilters();
                renderStudentList();
            });

            // Helper for quick financial lookup from student directory
            window.quickViewFinancials = (studentId) => {
                const student = allStudents.find(s => s.docId === studentId);
                if(student) {
                    document.getElementById('lookup-student-id').value = studentId;
                    document.getElementById('lookup-selected-display').innerText = `Selected: ${student.name}`;
                    document.getElementById('lookup-selected-display').classList.remove('hidden');
                    document.getElementById('lookup-student-search-group').classList.add('hidden');
                    document.getElementById('lookup-year').value = currentAcademicYear;
                    openModal('modal-lookup-params');
                }
            };

            // Global search for financials in Fees view
            window.openStudentLookup = () => {
                document.getElementById('lookup-student-search').value = '';
                document.getElementById('lookup-student-id').value = '';
                document.getElementById('lookup-search-results').style.display = 'none';
                document.getElementById('lookup-selected-display').classList.add('hidden');
                document.getElementById('lookup-student-search-group').classList.remove('hidden');
                document.getElementById('lookup-year').value = currentAcademicYear;
                openModal('modal-lookup-params');
            };

            window.searchStudentForLookup = (queryInput) => {
                const resultsDiv = document.getElementById('lookup-search-results');
                if(!queryInput || queryInput.length < 2) {
                    resultsDiv.style.display = 'none';
                    return;
                }
                const filtered = allStudents.filter(s => 
                    (s.name && s.name.toLowerCase().includes(queryInput.toLowerCase())) || 
                    (s.studentId && s.studentId.toLowerCase().includes(queryInput.toLowerCase()))
                );
                if(filtered.length > 0) {
                    resultsDiv.innerHTML = filtered.map(s => `
                        <div style="padding: 10px; cursor: pointer; border-bottom: 1px solid var(--border);" onclick="selectStudentForLookup('${s.docId}', '${s.name.replace(/'/g, "\\'")}')">
                            <b>${s.name}</b> (${s.studentId})
                        </div>
                    `).join('');
                    resultsDiv.style.display = 'block';
                } else {
                    resultsDiv.innerHTML = '<div style="padding: 10px;">No matching students found</div>';
                    resultsDiv.style.display = 'block';
                }
            };

            window.selectStudentForLookup = (id, name) => {
                document.getElementById('lookup-student-id').value = id;
                document.getElementById('lookup-student-search').value = name;
                document.getElementById('lookup-search-results').style.display = 'none';
                const display = document.getElementById('lookup-selected-display');
                display.innerText = `Selected: ${name}`;
                display.classList.remove('hidden');
            };

            window.copyOutput = () => {
                navigator.clipboard.writeText(document.getElementById('bulk-report-output-content').innerText);
                showToast("Content copied to clipboard!", "success");
            };

            window.handleLookupSubmit = (e) => {
                e.preventDefault();
                const studentId = document.getElementById('lookup-student-id').value;
                const term = document.getElementById('lookup-term').value;
                const year = document.getElementById('lookup-year').value;
                if(!studentId) return showToast("Please select a student first", "error");
                closeModal('modal-lookup-params');
                viewFeeStatement(studentId, term, parseInt(year));
            };

            // Teachers
            onSnapshot(query(collection(db, "teachers"), where("schoolId", "==", currentSchoolId)), snap => {
                // Realtime cache and dropdown update
                allTeachers = snap.docs.map(d => ({ id: d.id, ...d.data() }));
                const teachOptions = snap.docs.map(d => `<option value="${d.id}">${d.data().name}</option>`).join('');
                teacherOptionsHTML = teachOptions;
                const ts = document.getElementById('class-teacher-select');
                if(ts) ts.innerHTML = `<option value="">Select Class Teacher</option>${teachOptions}`;

                getDocs(query(collection(db, "classes"), where("schoolId", "==", currentSchoolId))).then(classSnap => {
                    const teacherLoadMap = {};
                    classSnap.forEach(cd => {
                        const c = cd.data();
                        (c.subjects || []).forEach(s => {
                            if(!teacherLoadMap[s.teacherId]) teacherLoadMap[s.teacherId] = [];
                            teacherLoadMap[s.teacherId].push(c.name);
                        });
                    });

                    document.getElementById('count-teachers').innerText = snap.size;
                    const tbody = document.getElementById('teacher-list-body');
                    tbody.innerHTML = "";
                    snap.forEach(d => {
                        const t = d.data();
                        const load = [...new Set(teacherLoadMap[d.id] || [])];
                        tbody.innerHTML += `
                            <tr>
                                <td><span style="font-family:'Space Mono'; font-size:0.8rem;">${t.employeeId || 'N/A'}</span></td>
                                <td><b>${t.name}</b><br><small class="text-muted">${t.email || ''}</small></td>
                                <td>${(t.subjects || []).map(s => `<span class="badge badge-info">${s}</span>`).join(' ')}</td>
                                <td>${load.map(c => `<span class="badge" style="background:#e0f2f1; color:#00695c;">${c}</span>`).join(' ')}</td>
                                <td>${t.phone}</td>
                                <td>
                                    <i class="fas fa-edit" style="color:var(--primary); cursor:pointer; margin-right:12px;" onclick="editTeacher('${d.id}')"></i>
                                    ${hasPermission('delete') ? `<i class="fas fa-trash" style="color:var(--danger); cursor:pointer;" onclick="deleteTeacher('${d.id}')"></i>` : ''}
                                </td>
                            </tr>
                        `;
                    });
                });
            });

            // Classes
            onSnapshot(query(collection(db, "classes"), where("schoolId", "==", currentSchoolId)), async snap => {
                allClasses = snap.docs.map(d => ({ id: d.id, ...d.data() }));
                // Keep the school-scoped class map for ops views (streams, subjects, etc.)
                window.__opsClassMap = {};
                snap.docs.forEach(d => { window.__opsClassMap[d.id] = d.data().name; });
                renderStreams();
                renderTeacherAssignments();
                document.getElementById('count-classes').innerText = snap.size;
                const tbody = document.getElementById('class-list-body');
                tbody.innerHTML = "";
                
                // Realtime dropdown update
                const classOptions = snap.docs.map(d => `<option value="${d.id}">${d.data().name}</option>`).join('');
                ['student-class', 'attendance-class-select', 'fs-class', 'filter-fee-class', 'tt-class-select', 'fee-summary-class', 'attendance-report-class', 'exam-filter-class'].forEach(id => {
                    const el = document.getElementById(id);
                    if(el) el.innerHTML = `<option value="">Select Class</option>${classOptions}`;
                });
                const attDateEl = document.getElementById('attendance-date');
                if (attDateEl && !attDateEl.value) attDateEl.value = todayStr();
                // Refresh attendance history/report once class names are available
                renderAttendanceHistory();

                const teachSnap = await getDocs(query(collection(db, "teachers"), where("schoolId", "==", currentSchoolId)));
                const teachMap = {};
                teachSnap.forEach(d => teachMap[d.id] = d.data().name);

                snap.forEach(d => {
                    const c = d.data();
                    tbody.innerHTML += `
                        <tr>
                            <td><b>${c.name}</b></td>
                            <td>${teachMap[c.classTeacherId] || 'Not Set'}</td>
                            <td>${(c.subjects || []).map(s => `<div style="font-size:0.75rem;"><b>${s.name}</b>: ${teachMap[s.teacherId] || 'Unassigned'}</div>`).join('')}</td>
                            <td>
                                ${(c.subjects || []).map(s => `<div style="font-size:0.75rem;"><b>${s.name}</b>: ${teachMap[s.teacherId] || 'Unassigned'}</div>`).join('')}
                            </td>
                            <td><i class="fas fa-edit" style="color:var(--primary); cursor:pointer; margin-right:12px;" onclick="editClass('${d.id}')"></i></td>
                            <td><span class="btn btn-outline btn-xs">View Students</span></td> 
                            <td>
                                ${hasPermission('delete') ? `<i class="fas fa-trash" style="color:var(--danger); cursor:pointer;" onclick="deleteClass('${d.id}')"></i>` : ''}
                            </td>
                        </tr>
                    `;
                });
            });

            // Fees & Finance Dashboard
            onSnapshot(query(collection(db, "fees"), where("schoolId", "==", currentSchoolId)), async snap => {
                lastFeesSnap = snap;
                window.refreshFeesTable();
            });

            window.refreshFeesTable = async () => {
                if (!lastFeesSnap) return;
                let totalCollected = 0;
                const tbody = document.getElementById('fee-history-body');
                if (tbody) tbody.innerHTML = "";
                const filterClass = document.getElementById('filter-fee-class')?.value || '';
                const filterText = document.getElementById('fee-search-input')?.value.toLowerCase() || '';
                
                const studSnap = await getDocs(query(collection(db, "students"), where("schoolId", "==", currentSchoolId)));
                const studMap = {};
                studSnap.forEach(d => studMap[d.id] = d.data());

                for (const d of lastFeesSnap.docs) {
                    const f = d.data();
                    const student = studMap[f.studentId] || { name: 'Unknown', classId: '' };
                    if (filterClass && student.classId !== filterClass) continue;
                    if (filterText && !student.name.toLowerCase().includes(filterText)) continue;

                    if (!tbody) continue;
                    totalCollected += f.amount;
                    
                    // Use stored snapshots if available to avoid slow sub-queries
                    const expectedVal = f.expected !== undefined ? f.expected : 0;
                    const balanceVal = f.balance !== undefined ? f.balance : 0;

                    tbody.innerHTML += `
                        <tr>
                            <td>${new Date(f.date).toLocaleDateString()}</td>
                            <td><b>${student.name}</b></td>
                            <td>${f.term} ${f.year}</td>
                            <td>${expectedVal.toLocaleString()}</td>
                            <td style="color:var(--success); font-weight:700;">${f.amount.toLocaleString()}</td>
                            <td style="color:${balanceVal > 0 ? 'var(--danger)' : 'var(--success)'}; font-weight:700;">${balanceVal.toLocaleString()}</td>
                            <td>
                                <span class="badge badge-success">${f.method}</span>
                                <i class="fas fa-edit" style="color:var(--primary); cursor:pointer; margin-left:10px;" title="Edit Payment" onclick="editFeeRecord('${d.id}')"></i>
                            </td>
                            <td><i class="fas fa-file-invoice-dollar" style="color:var(--blue); cursor:pointer;" title="View Full Statement" onclick="viewFeeStatement('${f.studentId}', '${f.term}', ${f.year})"></i></td>
                            <td><i class="fas fa-file-pdf" style="color:var(--primary); cursor:pointer;" title="Reprint Receipt" onclick="reprintFeeReceipt('${d.id}')"></i></td>
                        </tr>
                    `;
                }
                document.getElementById('dash-fees-collected').innerText = fmtKES(totalCollected);

                // Calc Expected & Balance for the school's current term/year
                const fsSnap = await getDocs(query(collection(db, "fee_structures"), where("schoolId", "==", currentSchoolId), where("year", "==", currentAcademicYear)));
                const structMap = {};
                fsSnap.forEach(d => structMap[`${d.data().classId}_${d.data().term}`] = d.data().total);
                
                let totalExpected = 0;
                studSnap.forEach(d => { totalExpected += (structMap[`${d.data().classId}_${currentTerm}`] || 0); });
                document.getElementById('dash-fees-expected').innerText = fmtKES(totalExpected);
                document.getElementById('dash-fees-balance').innerText = fmtKES(totalExpected - totalCollected);
            };

            // Fee Structures
            onSnapshot(query(collection(db, "fee_structures"), where("schoolId", "==", currentSchoolId)), async snap => {
                const tbody = document.getElementById('fee-structure-list-body');
                if (tbody) tbody.innerHTML = "";
                const classSnap = await getDocs(query(collection(db, "classes"), where("schoolId", "==", currentSchoolId)));
                const classMap = {};
                classSnap.forEach(d => classMap[d.id] = d.data().name);

                snap.forEach(d => {
                    const fs = d.data();
                    if (!tbody) return;
                    tbody.innerHTML += `
                        <tr>
                            <td><b>${classMap[fs.classId] || '-'}</b></td>
                            <td>${fs.term}</td>
                            <td>${fs.year}</td>
                            <td>${fs.tuition.toLocaleString()}</td>
                            <td>${fs.extra.toLocaleString()}</td>
                            <td style="font-weight:700; color:var(--primary);">${fs.total.toLocaleString()}</td>
                            <td>
                                <i class="fas fa-edit" style="color:var(--primary); cursor:pointer; margin-right:12px;" onclick="editFeeStructure('${d.id}')"></i>
                                <i class="fas fa-trash" style="color:var(--danger); cursor:pointer;" onclick="deleteFeeStructure('${d.id}')"></i>
                            </td>
                        </tr>
                    `;
                });
            });


            // Attendance summary for the dashboard (today's records)
            onSnapshot(query(collection(db, "attendance"), where("schoolId", "==", currentSchoolId)), snap => {
                // Keep the Attendance view's records/history + student report live
                renderAttendanceHistory();
                const now = new Date();
                const today = now.getFullYear() + '-' + String(now.getMonth() + 1).padStart(2, '0') + '-' + String(now.getDate()).padStart(2, '0');
                let marked = 0, present = 0;
                const byClass = {};
                snap.forEach(d => {
                    const a = d.data();
                    if (a.date !== today) return;
                    const rec = a.records || {};
                    Object.values(rec).forEach(v => { marked++; if (v === 'Present' || v === 'Late') present++; });
                    const cls = a.classId || 'Unassigned';
                    if (!byClass[cls]) byClass[cls] = { present: 0, total: 0 };
                    Object.values(rec).forEach(v => { byClass[cls].total++; if (v === 'Present' || v === 'Late') byClass[cls].present++; });
                });
                const el = document.getElementById('dash-attendance-chart');
                if (!el) return;
                if (marked === 0) {
                    el.innerHTML = `<p class="text-muted">No attendance recorded today yet. Go to Attendance to mark it.</p>`;
                    return;
                }
                const pct = Math.round((present / marked) * 100);
                const classKeys = Object.keys(byClass);
                el.innerHTML = `
                    <div style="display:flex; align-items:center; gap:16px; margin-bottom:12px;">
                        <div style="width:74px; height:74px; border-radius:50%; display:grid; place-items:center; font-weight:800; font-size:1.1rem; color:${pct >= 80 ? 'var(--success)' : 'var(--warning)'}; background:${pct >= 80 ? 'rgba(46,204,113,0.12)' : 'rgba(241,196,15,0.13)'};">${pct}%</div>
                        <div>
                            <b style="display:block;">${present} / ${marked} present</b>
                            <small class="text-muted">Today Ã‚Â· ${classKeys.length} class${classKeys.length === 1 ? '' : 'es'} recorded</small>
                        </div>
                    </div>
                    <div style="display:flex; flex-wrap:wrap; gap:6px;">
                        ${classKeys.map(c => `<span class="status-pill status-present">${byClass[c].present}/${byClass[c].total}</span>`).join('') || ''}
                    </div>`;
            });

            // Announcements
            onSnapshot(query(collection(db, "announcements"), where("schoolId", "==", currentSchoolId), orderBy("date", "desc")), snap => {
                const dashList = document.getElementById('dash-announcements-list');
                const fullList = document.getElementById('announcement-list');
                dashList.innerHTML = "";
                fullList.innerHTML = "";

                snap.forEach(d => {
                    const a = d.data();
                    const html = `
                        <div style="border-left: 4px solid var(--primary); padding: 10px; background: var(--bg-light); border-radius: 4px; margin-bottom: 10px;">
                            <div class="flex justify-between">
                                <h5 style="color:var(--primary)">${a.title}</h5>
                                <span class="status-pill status-present" style="font-size:0.6rem;">${a.type}</span>
                            </div>
                            <p style="font-size: 0.8rem; margin: 5px 0;">${a.content}</p>
                            <small class="text-muted">${new Date(a.date).toLocaleDateString()}</small>
                        </div>
                    `;
                    dashList.innerHTML += html;
                    fullList.innerHTML += html;
                });
                if(fullList.innerHTML !== "") {
                    fullList.innerHTML += `<button class="btn btn-outline" style="width:100%; margin-top:10px;" onclick="generateNewsletterPDF()"><i class="fas fa-file-pdf"></i> Download Newsletter PDF</button>`;
                }
            });

            // Exams
            const gradeBadgeClass = (m) => m >= 70 ? 'badge-success' : (m >= 50 ? 'badge-warning' : 'badge-danger');
            onSnapshot(query(collection(db, "exams"), where("schoolId", "==", currentSchoolId)), async snap => {
                const tbody = document.getElementById('exam-list-body');
                if (!tbody) return;

                const studSnap = await getDocs(query(collection(db, "students"), where("schoolId", "==", currentSchoolId)));
                const studMap = {};
                studSnap.forEach(d => studMap[d.id] = { name: d.data().name, cid: d.data().classId, sid: d.data().studentId });
                const classMap = {}; allClasses.forEach(c => classMap[c.id] = c.name);

                // Populate exam-name filter once (keep any user-selected value)
                const examFilterEl = document.getElementById('exam-filter-name');
                if (examFilterEl) {
                    const existing = new Set(Array.from(examFilterEl.options).map(o => o.value));
                    const names = [];
                    snap.forEach(d => { const n = d.data().examName; if (n && !existing.has(n) && !names.includes(n)) names.push(n); });
                    names.forEach(n => { const o = document.createElement('option'); o.value = n; o.textContent = n; examFilterEl.appendChild(o); });
                }

                // Group by exam + student + term + year
                const groups = {};
                snap.forEach(d => {
                    const e = d.data();
                    const key = examKeyOf(e.examName || 'Exam', e.studentId, e.term || 'Term 1', e.year);
                    if (!groups[key]) groups[key] = { docs: [], meta: { examName: e.examName || 'Exam', studentId: e.studentId, term: e.term || 'Term 1', year: e.year, date: e.date } };
                    groups[key].docs.push({ id: d.id, ...e });
                });
                window.__examGroups = groups;

                tbody.innerHTML = "";
                const keys = Object.keys(groups);
                if (keys.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="7" style="text-align:center; color:var(--text-muted);">No exam results recorded yet. Click â€œ+ Add Exam Recordâ€ to begin.</td></tr>';
                }

                keys.sort((a, b) => String(groups[b].meta.date || '').localeCompare(String(groups[a].meta.date || '')) || String(a).localeCompare(String(b)));

                keys.forEach(key => {
                    const g = groups[key];
                    const sInfo = studMap[g.meta.studentId] || { name: 'Unknown', cid: '', sid: '' };
                    const subjects = g.docs.map(d => ({ subject: d.subject, marks: d.marks, grade: d.grade || getGrade(d.marks) }));
                    const total = subjects.reduce((s, x) => s + (x.marks || 0), 0);
                    const avg = subjects.length ? Math.round(total / subjects.length) : 0;
                    const overall = getGrade(avg);
                    const dateTxt = g.meta.date ? (isNaN(new Date(g.meta.date).getTime()) ? 'â€”' : new Date(g.meta.date).toLocaleDateString()) : 'â€”';
                    const enc = examKeyEncode(g.meta.examName, g.meta.studentId, g.meta.term, g.meta.year);
                    tbody.innerHTML += `
                        <tr data-student="${(sInfo.name || '').toLowerCase()}" data-sid="${(sInfo.sid || '').toLowerCase()}" data-exam="${(g.meta.examName || '').toLowerCase()}" data-class="${(classMap[sInfo.cid] || '').toLowerCase()}">
                            <td style="min-width:140px;"><b>${g.meta.examName}</b><br><small class="text-muted">${g.meta.term} Â· ${g.meta.year}</small></td>
                            <td><b>${sInfo.name}</b><br><small class="text-muted">${sInfo.sid || ''}</small></td>
                            <td>${classMap[sInfo.cid] || '-'}</td>
                            <td style="white-space:nowrap;"><b>${total}</b> / ${subjects.length * 100}<br><small class="text-muted">Avg ${avg}%</small></td>
                            ${gradesEnabled() ? `<td><span class="badge ${gradeBadgeClass(avg)}">${overall}</span></td>` : ''}
                            <td style="white-space:nowrap;">${dateTxt}</td>
                            <td style="white-space:nowrap;">
                                <i class="fas fa-file-pdf" style="color:var(--success); cursor:pointer; margin-right:10px;" title="Generate Full Report Card" onclick="openReportModal('${g.meta.studentId}', '${g.meta.term}', ${g.meta.year})"></i>
                                <i class="fas fa-edit" style="color:var(--primary); cursor:pointer; margin-right:10px;" title="View / Edit this exam" onclick="viewExamGroup('${enc}')"></i>
                                ${hasPermission('delete') ? `<i class="fas fa-trash" style="color:var(--danger); cursor:pointer;" title="Delete all records in this exam" onclick="deleteExamGroup('${enc}')"></i>` : ''}
                            </td>
                        </tr>`;
                });
            });

            // Library - Books
            onSnapshot(query(collection(db, 'books'), where('schoolId', '==', currentSchoolId)), snap => {
                allBooks = snap.docs.map(d => ({ id: d.id, ...d.data() }));
                const tbody = document.getElementById('book-list-body');
                if (!tbody) return;
                tbody.innerHTML = "";
                snap.forEach(d => {
                    const b = d.data();
                    const avail = b.availableCopies !== undefined ? b.availableCopies : (b.totalCopies || 0);
                    tbody.innerHTML += `
                        <tr>
                            <td><b>${b.title}</b></td>
                            <td>${b.author || '-'}</td>
                            <td>${b.category || '-'}</td>
                            <td>${b.totalCopies || 0}</td>
                            <td>${avail}</td>
                            <td>${b.shelf || '-'}</td>
                            <td>
                                <i class="fas fa-edit" style="color:var(--primary); cursor:pointer; margin-right:10px;" onclick="editBook('${d.id}')"></i>
                                <i class="fas fa-trash" style="color:var(--danger); cursor:pointer;" onclick="deleteBook('${d.id}')"></i>
                            </td>
                        </tr>
                    `;
                });
                if (snap.empty) tbody.innerHTML = '<tr><td colspan="7" style="text-align:center; color:var(--text-muted);">No books in the catalogue yet.</td></tr>';
            });

            // Library - Borrowing ledger
            onSnapshot(query(collection(db, 'borrowings'), where('schoolId', '==', currentSchoolId)), snap => {
                const tbody = document.getElementById('borrow-list-body');
                if (!tbody) return;
                tbody.innerHTML = "";
                const bookMap = {}; allBooks.forEach(b => bookMap[b.id] = b.title);
                const studMap = {}; allStudents.forEach(s => studMap[s.docId] = s.name);
                snap.forEach(d => {
                    const br = d.data();
                    const active = (br.status || 'active') === 'active';
                    tbody.innerHTML += `
                        <tr>
                            <td><b>${bookMap[br.bookId] || 'Unknown book'}</b></td>
                            <td>${studMap[br.studentId] || 'Unknown student'}</td>
                            <td>${new Date(br.borrowDate).toLocaleDateString()}</td>
                            <td>${new Date(br.dueDate).toLocaleDateString()}</td>
                            <td><span class="badge ${active ? 'badge-success' : 'badge-warning'}">${active ? 'Active' : 'Returned'}</span></td>
                            <td>${active ? `<i class="fas fa-undo-alt" style="color:var(--success); cursor:pointer;" title="Mark returned" onclick="returnBook('${d.id}')"></i>` : '-'}</td>
                        </tr>
                    `;
                });
                if (snap.empty) tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; color:var(--text-muted);">No borrowing records.</td></tr>';
            });

            // Transport - Vehicles
            onSnapshot(query(collection(db, 'vehicles'), where('schoolId', '==', currentSchoolId)), async snap => {
                allVehicles = snap.docs.map(d => ({ id: d.id, ...d.data() }));
                const tbody = document.getElementById('vehicle-list-body');
                if (!tbody) return;
                const routeSnap = await getDocs(query(collection(db, 'student_routes'), where('schoolId', '==', currentSchoolId), where('status', '==', 'active')));
                const assignedCounts = {};
                routeSnap.forEach(d => { const r = d.data(); assignedCounts[r.vehicleId] = (assignedCounts[r.vehicleId] || 0) + 1; });
                tbody.innerHTML = "";
                snap.forEach(d => {
                    const v = d.data();
                    tbody.innerHTML += `
                        <tr>
                            <td><code>${v.plate}</code></td>
                            <td>${v.route || '-'}</td>
                            <td>${v.driver || '-'}${v.driverPhone ? `<br><small class="text-muted">${v.driverPhone}</small>` : ''}</td>
                            <td>${v.capacity || '-'}</td>
                            <td>${assignedCounts[d.id] || 0}</td>
                            <td>
                                <i class="fas fa-edit" style="color:var(--primary); cursor:pointer; margin-right:10px;" onclick="editVehicle('${d.id}')"></i>
                                <i class="fas fa-trash" style="color:var(--danger); cursor:pointer;" onclick="deleteVehicle('${d.id}')"></i>
                            </td>
                        </tr>
                    `;
                });
                if (snap.empty) tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; color:var(--text-muted);">No vehicles/routes configured.</td></tr>';
            });

            // Transport - Route assignments
            onSnapshot(query(collection(db, 'student_routes'), where('schoolId', '==', currentSchoolId)), snap => {
                const tbody = document.getElementById('route-assign-body');
                if (!tbody) return;
                const classMap = {}; allClasses.forEach(c => classMap[c.id] = c.name);
                const studMap = {}; allStudents.forEach(s => studMap[s.docId] = s.name);
                const vehMap = {}; allVehicles.forEach(v => vehMap[v.id] = v.plate + ' (' + (v.route || '-') + ')');
                tbody.innerHTML = "";
                snap.forEach(d => {
                    const r = d.data();
                    if ((r.status || 'active') !== 'active') return;
                    const st = allStudents.find(s => s.docId === r.studentId);
                    tbody.innerHTML += `
                        <tr>
                            <td><b>${studMap[r.studentId] || 'Unknown student'}</b></td>
                            <td>${(st && classMap[st.classId]) || '-'}</td>
                            <td>${vehMap[r.vehicleId] || '-'}</td>
                            <td>${r.term || '-'} ${r.year || ''}</td>
                            <td><i class="fas fa-times" style="color:var(--danger); cursor:pointer;" title="Remove from route" onclick="unassignRoute('${d.id}')"></i></td>
                        </tr>
                    `;
                });
                if (snap.empty) tbody.innerHTML = '<tr><td colspan="5" style="text-align:center; color:var(--text-muted);">No active route assignments.</td></tr>';
            });

            // Hostel - Dormitories
            onSnapshot(query(collection(db, 'dormitories'), where('schoolId', '==', currentSchoolId)), async snap => {
                allDormitories = snap.docs.map(d => ({ id: d.id, ...d.data() }));
                const tbody = document.getElementById('dorm-list-body');
                if (!tbody) return;
                const bedSnap = await getDocs(query(collection(db, 'bed_assignments'), where('schoolId', '==', currentSchoolId), where('status', '==', 'active')));
                const occupied = {};
                bedSnap.forEach(d => { const b = d.data(); occupied[b.dormId] = (occupied[b.dormId] || 0) + 1; });
                tbody.innerHTML = "";
                snap.forEach(d => {
                    const dm = d.data();
                    const occ = occupied[d.id] || 0;
                    tbody.innerHTML += `
                        <tr>
                            <td><b>${dm.name}</b></td>
                            <td>${dm.type || '-'}</td>
                            <td>${dm.capacity || '-'}</td>
                            <td>${occ} / ${dm.capacity || 0}</td>
                            <td>${dm.patron || '-'}</td>
                            <td>
                                <i class="fas fa-edit" style="color:var(--primary); cursor:pointer; margin-right:10px;" onclick="editDorm('${d.id}')"></i>
                                <i class="fas fa-trash" style="color:var(--danger); cursor:pointer;" onclick="deleteDorm('${d.id}')"></i>
                            </td>
                        </tr>
                    `;
                });
                if (snap.empty) tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; color:var(--text-muted);">No dormitories yet.</td></tr>';
            });

            // Hostel - Bed assignments
            onSnapshot(query(collection(db, 'bed_assignments'), where('schoolId', '==', currentSchoolId)), async snap => {
                const tbody = document.getElementById('bed-list-body');
                if (!tbody) return;
                const dormMap = {}; allDormitories.forEach(d => dormMap[d.id] = d.name);
                const studMap = {}; allStudents.forEach(s => studMap[s.docId] = s.name);
                const classMap = {}; allClasses.forEach(c => classMap[c.id] = c.name);
                tbody.innerHTML = "";
                snap.forEach(d => {
                    const b = d.data();
                    if ((b.status || 'active') !== 'active') return;
                    const st = allStudents.find(s => s.docId === b.studentId);
                    tbody.innerHTML += `
                        <tr>
                            <td><b>${studMap[b.studentId] || 'Unknown student'}</b></td>
                            <td>${(st && classMap[st.classId]) || '-'}</td>
                            <td>${dormMap[b.dormId] || '-'}</td>
                            <td>${b.room || '-'}</td>
                            <td>${b.bed || '-'}</td>
                            <td><i class="fas fa-times" style="color:var(--danger); cursor:pointer;" title="Unassign bed" onclick="unassignBed('${d.id}')"></i></td>
                        </tr>
                    `;
                });
                if (snap.empty) tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; color:var(--text-muted);">No active bed assignments.</td></tr>';
            });

            // Inventory - Items
            onSnapshot(query(collection(db, 'inventory_items'), where('schoolId', '==', currentSchoolId)), snap => {
                allInventoryItems = snap.docs.map(d => ({ id: d.id, ...d.data() }));
                const tbody = document.getElementById('inventory-list-body');
                if (!tbody) return;
                tbody.innerHTML = "";
                snap.forEach(d => {
                    const it = d.data();
                    const low = it.stock <= (it.minStock || 0);
                    tbody.innerHTML += `
                        <tr>
                            <td><b>${it.name}</b></td>
                            <td>${it.category || '-'}</td>
                            <td>${it.unit || '-'}</td>
                            <td>${it.stock || 0}</td>
                            <td>${it.minStock || 0}</td>
                            <td><span class="status-pill ${low ? 'status-absent' : 'status-present'}">${low ? 'LOW STOCK' : 'OK'}</span></td>
                            <td>
                                <i class="fas fa-edit" style="color:var(--primary); cursor:pointer; margin-right:10px;" onclick="editInventoryItem('${d.id}')"></i>
                                <i class="fas fa-trash" style="color:var(--danger); cursor:pointer;" onclick="deleteInventoryItem('${d.id}')"></i>
                            </td>
                        </tr>
                    `;
                });
                if (snap.empty) tbody.innerHTML = '<tr><td colspan="7" style="text-align:center; color:var(--text-muted);">No inventory items yet.</td></tr>';
            });

            // Inventory - Stock movements (most recent first, sorted client-side)
            onSnapshot(query(collection(db, 'stock_moves'), where('schoolId', '==', currentSchoolId)), snap => {
                const tbody = document.getElementById('stock-move-body');
                if (!tbody) return;
                const itemMap = {}; allInventoryItems.forEach(i => itemMap[i.id] = i.name);
                const moves = snap.docs.map(d => ({ id: d.id, ...d.data() }))
                    .sort((a, b) => (new Date(b.date)) - (new Date(a.date)))
                    .slice(0, 100);
                tbody.innerHTML = "";
                moves.forEach(m => {
                    const isIn = m.type === 'in';
                    tbody.innerHTML += `
                        <tr>
                            <td>${new Date(m.date).toLocaleDateString()}</td>
                            <td>${itemMap[m.itemId] || 'Unknown item'}</td>
                            <td><span class="status-pill ${isIn ? 'status-present' : 'status-absent'}">${isIn ? 'IN' : 'OUT'}</span></td>
                            <td>${m.qty}</td>
                            <td>${m.note || '-'}</td>
                        </tr>
                    `;
                });
                if (moves.length === 0) tbody.innerHTML = '<tr><td colspan="5" style="text-align:center; color:var(--text-muted);">No stock movements recorded.</td></tr>';
            });
        }

        // --- UTILS ---
        window.openModal = (id) => {
            if(id === 'modal-student' || id === 'modal-teacher' || id === 'modal-class' || id === 'modal-fee' || id === 'modal-exam' || id === 'modal-announcement' || id === 'modal-fee-structure' || id === 'modal-bulk-newsletter' || id === 'modal-lookup-params' || id === 'modal-bulk-term-reports') {
                if(!hasPermission('edit')) {
                    showToast("Permission denied", "error");
                    return;
                }
                // Clear dynamic subject-teacher rows when opening class modal for new entry
                if (id === 'modal-class') {
                    document.getElementById('class-subject-teacher-rows').innerHTML = '';
                }
                if (id === 'modal-bulk-newsletter') {
                    document.getElementById('bulk-news-year').value = currentAcademicYear;
                }
                if (id === 'modal-fee-structure') {
                    document.getElementById('fs-extra-fees-container').innerHTML = '';
                }
                if (id === 'modal-bulk-term-reports') {
                    window.populateBulkReportForm();
                    document.getElementById('bulk-report-output').style.display = 'none';
                }
                // Default year fields to the school's current academic year
                const yearFields = {
                    'modal-fee': 'fee-year',
                    'modal-fee-structure': 'fs-year',
                    'modal-exam': 'exam-year',
                    'modal-report-params': 'report-year',
                    'modal-lookup-params': 'lookup-year',
                    'modal-bulk-term-reports': 'bulk-report-year'
                };
                if (yearFields[id]) {
                    const yEl = document.getElementById(yearFields[id]);
                    if (yEl && !yEl.value) yEl.value = currentAcademicYear;
                }
            }
            // Admin-only modules (Library / Transport / Hostel / Inventory)
            if(['modal-book', 'modal-borrow', 'modal-vehicle', 'modal-route', 'modal-dorm', 'modal-bed', 'modal-inventory-item', 'modal-stock-move'].includes(id)) {
                if(!canOp()) {
                    showToast("Permission denied", "error");
                    return;
                }
                if (id === 'modal-borrow') {
                    const bookSel = document.getElementById('borrow-book');
                    if (bookSel) bookSel.innerHTML = allBooks.length
                        ? allBooks.map(b => `<option value="${b.id}">${b.title} (${b.availableCopies !== undefined ? b.availableCopies : b.totalCopies || 0} available)</option>`).join('')
                        : '<option value="">No books available</option>';
                    const studSel = document.getElementById('borrow-student');
                    if (studSel) studSel.innerHTML = allStudents.map(s => `<option value="${s.docId}">${s.name}</option>`).join('');
                    const due = document.getElementById('borrow-due');
                    if (due && !due.value) {
                        const d = new Date(); d.setDate(d.getDate() + 14);
                        due.value = d.toISOString().slice(0, 10);
                    }
                }
                if (id === 'modal-route') {
                    const studSel = document.getElementById('route-student');
                    if (studSel) studSel.innerHTML = allStudents.map(s => `<option value="${s.docId}">${s.name}</option>`).join('');
                    const vehSel = document.getElementById('route-vehicle');
                    if (vehSel) vehSel.innerHTML = allVehicles.map(v => `<option value="${v.id}">${v.plate} â€” ${v.route || 'No route'}</option>`).join('');
                    const yEl = document.getElementById('route-year');
                    if (yEl && !yEl.value) yEl.value = currentAcademicYear;
                }
                if (id === 'modal-bed') {
                    const studSel = document.getElementById('bed-student');
                    if (studSel) studSel.innerHTML = allStudents.map(s => `<option value="${s.docId}">${s.name}</option>`).join('');
                    const dormSel = document.getElementById('bed-dorm');
                    if (dormSel) dormSel.innerHTML = allDormitories.length
                        ? allDormitories.map(dm => `<option value="${dm.id}">${dm.name} (${dm.type || ''})</option>`).join('')
                        : '<option value="">No dormitories â€” add one first</option>';
                }
                if (id === 'modal-stock-move') {
                    const sel = document.getElementById('sm-item');
                    if (sel) sel.innerHTML = allInventoryItems.length
                        ? allInventoryItems.map(i => `<option value="${i.id}">${i.name} (${i.stock} ${i.unit || 'in stock'})</option>`).join('')
                        : '<option value="">No items yet â€” add an item first</option>';
                }
                if (id === 'modal-dorm') {
                    document.getElementById('dorm-modal-title').innerText = "Add Dormitory";
                }
                if (id === 'modal-inventory-item') {
                    document.getElementById('item-modal-title').innerText = "Add Inventory Item";
                }
            }
            document.getElementById(id).classList.add('active');
        };

        window.closeModal = (id) => {
            document.getElementById(id).classList.remove('active');
            // Reset forms
            const form = document.querySelector(`#${id} form`);
            if(form) form.reset();
            // Clear dynamic subject-teacher rows when closing class modal
            if (id === 'modal-class') {
                document.getElementById('class-subject-teacher-rows').innerHTML = '';
            }
            if (id === 'modal-fee-structure') {
                document.getElementById('fs-extra-fees-container').innerHTML = '';
            }
        };

        window.previewImage = (input, previewId) => {
            const preview = document.getElementById(previewId);
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = (e) => {
                    preview.innerHTML = `<img src="${e.target.result}">`;
                }
                reader.readAsDataURL(input.files[0]);
            }
        };

        window.filterTable = (tableId, query) => {
            const rows = document.querySelectorAll(`#${tableId} tbody tr`);
            rows.forEach(row => {
                const text = row.innerText.toLowerCase();
                row.style.display = text.includes(query.toLowerCase()) ? "" : "none";
            });
        };

        window.exportToCSV = (tableId, filename) => {
            let csv = [];
            const rows = document.querySelectorAll(`#${tableId} tr`);
            for (const row of rows) {
                let cols = Array.from(row.cells).map(c => `"${c.innerText}"`);
                csv.push(cols.join(","));
            }
            const csvContent = "data:text/csv;charset=utf-8," + csv.join("\n");
            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", `${filename}.csv`);
            document.body.appendChild(link);
            link.click();
        };

        // --- PDF GENERATION ENGINE ---

        async function getSchoolInfo() {
            const snap = await getDoc(doc(db, "schools", currentSchoolId));
            return snap.exists() ? snap.data() : {};
        }


        window.generateFeeReceiptPDF = async (student, amount, method, term, year, studentDocId) => {
            const { jsPDF } = window.jspdf;
            const docPdf = new jsPDF();
            const school = await getSchoolInfo();
            const feeSummary = await getStudentFeeSummary(studentDocId, student.classId, term, year);
            const primaryColor = hexToRgb(schoolThemeColor);

            // Branded Header
            docPdf.setFillColor(...primaryColor);
            docPdf.rect(0, 0, 210, 40, 'F');
            docPdf.setTextColor(255, 255, 255);
            docPdf.setFontSize(22);
            docPdf.setFont("helvetica", "bold");
            docPdf.text(school.name || "OFFICIAL FEE RECEIPT", 105, 18, { align: "center" });
            docPdf.setFontSize(10);
            docPdf.setFont("helvetica", "italic");
            docPdf.text(school.motto || "", 105, 26, { align: "center" });
            docPdf.setFontSize(9);
            docPdf.setFont("helvetica", "normal");
            docPdf.text(school.contact || "", 105, 32, { align: "center" });

            // Document Info
            docPdf.setTextColor(0, 0, 0);
            docPdf.text(`Receipt No: RCP-${Date.now().toString().slice(-6)}`, 20, 50);
            docPdf.text(`Date: ${new Date().toLocaleDateString()}`, 190, 50, { align: "right" });

            // Student Info Box
            docPdf.setDrawColor(200, 200, 200);
            docPdf.rect(20, 55, 170, 30);
            docPdf.setFontSize(12);
            docPdf.setFont("helvetica", "bold");
            docPdf.text("STUDENT DETAILS", 25, 62);
            docPdf.setFont("helvetica", "normal");
            docPdf.setFontSize(10);
            docPdf.text(`Name: ${student.name}`, 25, 70);
            docPdf.text(`Student ID: ${student.studentId}`, 25, 77);
            docPdf.text(`Period: ${term} ${year}`, 120, 70);

            docPdf.autoTable({
                startY: 90,
                head: [['Description', 'Payment Method', 'Amount Paid (KES)']],
                body: [[`School Fee Installment - ${term} ${year}`, method, amount.toLocaleString()]],
                theme: 'grid',
                headStyles: { fillColor: primaryColor }
            });

            // Summary Section
            let finalY = docPdf.lastAutoTable.finalY + 12;
            docPdf.setFont("helvetica", "bold");
            docPdf.text(`Payment Summary:`, 20, finalY);
            docPdf.setFont("helvetica", "normal");
            docPdf.text(`Total Term Fees: ${fmtKES(feeSummary.total)}`, 20, finalY + 7);
            docPdf.text(`Total Paid to Date: ${fmtKES(feeSummary.paid)}`, 20, finalY + 14);
            docPdf.setTextColor(...(feeSummary.balance > 0 ? [231, 76, 60] : [46, 204, 113]));
            docPdf.setFont("helvetica", "bold");
            docPdf.text(`Outstanding Balance: ${fmtKES(feeSummary.balance)}`, 20, finalY + 21);

            docPdf.setTextColor(0, 0, 0);
            const signY = finalY + 45;
            docPdf.text("Authorized Signature: _______________________", 20, signY);
            docPdf.text("Official School Stamp", 140, signY);
            docPdf.save(`${student.name.replace(/\s/g, '_')}_Receipt.pdf`);
        };

        window.reprintFeeReceipt = async (feeId) => {
            const fee = await getScopedDoc("fees", feeId);
            if(!fee) return showToast("Payment record not found in your school", "error");
            const f = fee.data;
            const stud = await getScopedDoc("students", f.studentId);
            if(!stud) return showToast("Student not found in your school", "error");
            await generateFeeReceiptPDF(stud.data, f.amount, f.method, f.term, f.year, f.studentId);
        };


        // Generate a printable PDF of the student's fee statement.
        window.generateFeeStatementPDF = async (student, className, feeSummary, paymentsSnap, term, year, school, fsData) => {
            const { jsPDF } = window.jspdf;
            const docPdf = new jsPDF();
            const primaryColor = hexToRgb(schoolThemeColor);

            // Branded Header
            docPdf.setFillColor(...primaryColor);
            docPdf.rect(0, 0, 210, 40, 'F');
            docPdf.setTextColor(255, 255, 255);
            docPdf.setFontSize(22);
            docPdf.setFont("helvetica", "bold");
            docPdf.text(school.name || school.schoolName || "OFFICIAL FEE STATEMENT", 105, 18, { align: "center" });
            docPdf.setFontSize(10);
            docPdf.setFont("helvetica", "italic");
            docPdf.text(school.motto || "", 105, 26, { align: "center" });
            docPdf.setFontSize(9);
            docPdf.setFont("helvetica", "normal");
            docPdf.text(school.contact || "", 105, 32, { align: "center" });

            // Document Info
            docPdf.setTextColor(0, 0, 0);
            docPdf.text("STUDENT FEE STATEMENT", 105, 50, { align: "center" });
            docPdf.setFontSize(9);
            docPdf.text(`Period: ${term} - Academic Year ${year}`, 20, 57);
            docPdf.text(`Date: ${new Date().toLocaleDateString()}`, 190, 57, { align: "right" });

            // Student Info Box
            docPdf.setDrawColor(200, 200, 200);
            docPdf.rect(20, 62, 170, 28);
            docPdf.setFontSize(11);
            docPdf.setFont("helvetica", "bold");
            docPdf.text("STUDENT DETAILS", 25, 69);
            docPdf.setFont("helvetica", "normal");
            docPdf.setFontSize(10);
            docPdf.text(`Name: ${student.name || ''}`, 25, 76);
            docPdf.text(`Student ID: ${student.studentId || ''}`, 25, 83);
            docPdf.text(`Class: ${className || 'N/A'}`, 130, 76);

            // Payment history table
            const payments = paymentsSnap ? paymentsSnap.docs.map(d => d.data()) : [];
            const body = payments.length
                ? payments.map(p => [
                    p.date ? new Date(p.date).toLocaleDateString() : 'N/A',
                    p.method || '-',
                    p.reference || 'N/A',
                    `KES ${(p.amount || 0).toLocaleString()}`
                  ])
                : [['-', '-', '-', 'KES 0']];

            docPdf.autoTable({
                startY: 100,
                head: [['Date', 'Method', 'Reference', 'Amount (KES)']],
                body,
                theme: 'grid',
                headStyles: { fillColor: primaryColor },
                styles: { fontSize: 9 }
            });

            // Fee Breakdown table
            const extraFees = (fsData && Array.isArray(fsData.extraFees)) ? fsData.extraFees : [];
            const breakdownRows = [
                ['Tuition Fee', `KES ${(fsData?.tuition || 0).toLocaleString()}`],
                ...extraFees.map(ef => [ef.name || 'Fee', `KES ${(ef.amount || 0).toLocaleString()}`])
            ];
            docPdf.autoTable({
                startY: docPdf.lastAutoTable.finalY + 10,
                head: [['Fee Breakdown', 'Amount (KES)']],
                body: breakdownRows,
                theme: 'grid',
                headStyles: { fillColor: primaryColor },
                styles: { fontSize: 9 }
            });

            // Summary Section
            let finalY = docPdf.lastAutoTable.finalY + 12;
            docPdf.setFont("helvetica", "bold");
            docPdf.setFontSize(11);
            docPdf.text(`Fee Summary (${term} ${year})`, 20, finalY);
            docPdf.setFont("helvetica", "normal");
            docPdf.setFontSize(10);
            docPdf.text(`Total Expected Fees: ${fmtKES(feeSummary.total)}`, 20, finalY + 8);
            docPdf.text(`Total Paid: ${fmtKES(feeSummary.paid)}`, 20, finalY + 15);
            docPdf.setTextColor(...(feeSummary.balance > 0 ? [231, 76, 60] : [46, 204, 113]));
            docPdf.setFont("helvetica", "bold");
            docPdf.text(`Balance Due: ${fmtKES(feeSummary.balance)}`, 20, finalY + 22);

            docPdf.setTextColor(0, 0, 0);
            const signY = finalY + 45;
            docPdf.text("Authorized Signature: _______________________", 20, signY);
            docPdf.text("Official School Stamp", 140, signY);
            docPdf.save(`${(student.name || 'Student').replace(/\s/g, '_')}_Fee_Statement.pdf`);
        };

        // New: View Fee Statement (Overlay)
        window.viewFeeStatement = async (studentId, term, year) => {
            openModal('modal-fee-statement');
            document.getElementById('fee-statement-body').innerHTML = `
                <div class="loading-state"><div class="spinner"></div><p>Loading fee statement...</p></div>`;
            
            try {
                const studentSnap = await getDoc(doc(db, "students", studentId));
                if (!studentSnap.exists()) { throw new Error("Student not found."); }
                if (!(studentSnap.data().schoolId && studentSnap.data().schoolId === currentSchoolId)) throw new Error("Student not found in your school.");
                const student = studentSnap.data();

                const classSnap = await getScopedDoc("classes", student.classId);
                const className = classSnap ? classSnap.data.name : "N/A";
                const school = await getSchoolInfo();

                const feeSummary = await getStudentFeeSummary(studentId, student.classId, term, year);

                const fsQuery = query(collection(db, "fee_structures"), 
                    where("schoolId", "==", currentSchoolId), 
                    where("classId", "==", student.classId), 
                    where("term", "==", term), 
                    where("year", "==", year)
                );
                const fsSnap = await getDocs(fsQuery);
                const fsData = fsSnap.docs[0]?.data();

                const paymentsSnap = await getDocs(query(collection(db, "fees"),
                    where("schoolId", "==", currentSchoolId),
                    where("studentId", "==", studentId),
                    where("term", "==", term),
                    where("year", "==", year),
                    orderBy("date", "asc")
                ));

                let paymentsHtml = "";
                paymentsSnap.forEach(d => {
                    const p = d.data();
                    paymentsHtml += `
                        <tr>
                            <td>${new Date(p.date).toLocaleDateString()}</td>
                            <td>${p.method}</td>
                            <td>${p.reference || 'N/A'}</td>
                            <td style="text-align:right;">${fmtKES(p.amount)}</td>
                        </tr>
                    `;
                });

                document.getElementById('fee-statement-body').innerHTML = `
                    <div style="font-family:'Space Mono',monospace; font-size:0.8rem; text-align:center; margin-bottom:1.5rem;">
                        <h4 style="color:var(--primary); font-size:1.5rem; margin-bottom:0.5rem;">${school.name || school.schoolName}</h4>
                        <p style="color:var(--text-muted); font-size:0.9rem;">${school.motto || ''} | ${school.contact || ''}</p>
                        <h5 style="margin-top:1.5rem; font-size:1.2rem; color:var(--primary-dark);">STUDENT FEE STATEMENT</h5>
                        <p style="font-weight:bold;">${term} - Academic Year ${year}</p>
                    </div>
                    
                    <div class="grid gap-10" style="grid-template-columns:1fr 1fr; margin-bottom:1.5rem; padding-bottom:1rem; border-bottom:1px solid var(--border);">
                        <div>
                            <p style="font-weight:bold;">Student Name: <span style="font-weight:normal;">${student.name}</span></p>
                            <p style="font-weight:bold;">Student ID: <span style="font-weight:normal;">${student.studentId}</span></p>
                        </div>
                        <div style="text-align:right;">
                            <p style="font-weight:bold;">Class: <span style="font-weight:normal;">${className}</span></p>
                            <p style="font-weight:bold;">Date: <span style="font-weight:normal;">${new Date().toLocaleDateString()}</span></p>
                        </div>
                    </div>

                    <h4 style="color:var(--primary); margin-bottom:1rem;">Payment History</h4>
                    <table class="table-responsive" style="margin-bottom:1.5rem;">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Method</th>
                                <th>Reference</th>
                                <th style="text-align:right;">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${paymentsHtml || '<tr><td colspan="4" style="text-align:center;">No payments found for this period.</td></tr>'}
                        </tbody>
                    </table>

                    <div id="statement-breakdown" style="margin-bottom:1.5rem; padding:15px; background:var(--bg-light); border-radius:12px; border:1px solid var(--border);">
                        <h4 style="color:var(--primary); margin-bottom:10px; font-size:0.9rem;">Fee Breakdown</h4>
                        <div class="flex justify-between" style="margin-bottom:5px; font-size:0.85rem;">
                            <span>Tuition Fee:</span>
                            <span>${fmtKES(fsData?.tuition || 0)}</span>
                        </div>
                        ${(fsData?.extraFees || []).map(ef => `
                            <div class="flex justify-between" style="margin-bottom:5px; font-size:0.85rem;">
                                <span>${ef.name}:</span>
                                <span>${fmtKES(ef.amount)}</span>
                            </div>
                        `).join('')}
                    </div>

                    <div class="card" style="background:var(--bg-light); border:1px solid var(--border);">
                        <div class="flex justify-between align-center" style="margin-bottom:5px;">
                            <span>Total Expected Fees:</span>
                            <span style="font-weight:bold;">${fmtKES(feeSummary.total)}</span>
                        </div>
                        <div class="flex justify-between align-center" style="margin-bottom:5px;">
                            <span>Total Paid:</span>
                            <span style="font-weight:bold; color:var(--success);">${fmtKES(feeSummary.paid)}</span>
                        </div>
                        <div class="flex justify-between align-center" style="border-top:1.5px solid var(--border); margin-top:10px; padding-top:10px;">
                            <span style="font-weight:bold;">Balance Due:</span>
                            <span style="font-weight:800; color:${feeSummary.balance > 0 ? 'var(--danger)' : 'var(--success)'};">${fmtKES(feeSummary.balance)}</span>
                        </div>
                    </div>
                `;

                // Link the print button in the modal to generate a PDF
                document.getElementById('print-fee-statement-btn').onclick = () => {
                    generateFeeStatementPDF(student, className, feeSummary, paymentsSnap, term, year, school, fsData);
                };

            } catch (err) {
                showToast(err.message, "error");
                closeModal('modal-fee-statement');
            }
        };

        // --- NEWSLETTER PDF ENGINE ---
        window.openReportModal = (studentId, term = null, year = null) => {
            document.getElementById('report-student-id').value = studentId;
            document.getElementById('report-year').value = year || currentAcademicYear;
            // Default the term to the school's current term (or the exam's term) so the
            // report shows true data instead of always defaulting to "Term 1".
            const termEl = document.getElementById('report-term');
            if (termEl) termEl.value = term || currentTerm || termEl.options[0].value;
            openModal('modal-report-params');
        };

        window.generateNewsletterPDF = async () => {
            const { jsPDF } = window.jspdf;
            const docPdf = new jsPDF();
            const school = await getSchoolInfo();
            const primaryColor = hexToRgb(schoolThemeColor);

            showLoader(true);
            try {
                // Branded Header
                docPdf.setFillColor(...primaryColor);
                docPdf.rect(0, 0, 210, 40, 'F');
                docPdf.setTextColor(255, 255, 255);
                docPdf.setFontSize(22);
                docPdf.setFont("helvetica", "bold");
                docPdf.text(school.name || "SCHOOL NEWSLETTER", 105, 20, { align: "center" });
                docPdf.setFontSize(10);
                docPdf.setFont("helvetica", "italic");
                docPdf.text(school.motto || "", 105, 28, { align: "center" });
                docPdf.setFont("helvetica", "normal");
                docPdf.text(school.contact || "", 105, 34, { align: "center" });

                docPdf.setTextColor(0, 0, 0);
                docPdf.setFontSize(16);
                docPdf.text("Recent Announcements", 20, 55);
                docPdf.setDrawColor(...primaryColor);
                docPdf.line(20, 57, 80, 57);

                // Content
                const annSnap = await getDocs(query(collection(db, "announcements"), where("schoolId", "==", currentSchoolId), orderBy("date", "desc"), limit(10)));
                let y = 70;
                annSnap.forEach(d => {
                    const a = d.data();
                    if (y > 260) { docPdf.addPage(); y = 20; }
                    
                    docPdf.setFontSize(12);
                    docPdf.setFont("helvetica", "bold");
                    docPdf.text(a.title, 20, y);
                    docPdf.setFontSize(9);
                    docPdf.setTextColor(100, 100, 100);
                    docPdf.text(new Date(a.date).toLocaleDateString(), 190, y, { align: "right" });
                    
                    y += 7;
                    docPdf.setTextColor(50, 50, 50);
                    docPdf.setFont("helvetica", "normal");
                    const splitText = docPdf.splitTextToSize(a.content, 170);
                    docPdf.text(splitText, 20, y);
                    
                    y += (splitText.length * 5) + 10;
                });

                docPdf.save(`Newsletter_${new Date().toLocaleDateString()}.pdf`);
            } catch (err) {
                console.error(err);
                showToast("Error generating newsletter: " + err.message, "error");
            } finally {
                showLoader(false);
            }
        };

        // --- REPORT CARD ENGINE ---
        window.generateReportFormPDF = async () => {
            const studentId = document.getElementById('report-student-id').value;
            const term = document.getElementById('report-term').value;
            const year = parseInt(document.getElementById('report-year').value);
            if(!studentId || !term || !year) return showToast("Invalid report parameters", "error");

            showLoader(true);
            try {
                const { jsPDF } = window.jspdf;
                const docPdf = new jsPDF();
                const school = await getSchoolInfo();
                const primaryColor = hexToRgb(schoolThemeColor);

                const studentSnap = await getDoc(doc(db, "students", studentId));
                if(!studentSnap.exists()) throw new Error("Student not found");
                if (!(studentSnap.data().schoolId && studentSnap.data().schoolId === currentSchoolId)) throw new Error("Student not found in your school.");
                const student = studentSnap.data();

                const classSnap = await getScopedDoc("classes", student.classId);
                const className = classSnap ? classSnap.data.name : "N/A";

                // Rank Calculation
                const rankings = [];
                const studSnap = await getDocs(query(collection(db, "students"), where("schoolId", "==", currentSchoolId), where("classId", "==", student.classId)));
                for(let s of studSnap.docs) {
                    const exSnap = await getDocs(query(collection(db, "exams"), where("schoolId", "==", currentSchoolId), where("studentId", "==", s.id), where("term", "==", term), where("year", "==", year)));
                    let total = 0; let count = 0;
                    exSnap.forEach(ed => { total += (ed.data().marks || 0); count++; });
                    rankings.push({ id: s.id, avg: count > 0 ? (total/count) : 0 });
                }
                rankings.sort((a,b) => b.avg - a.avg);
                const position = rankings.findIndex(r => r.id === studentId) + 1;
                const totalInClass = rankings.length;

                // Fetch fee summary for the student
                const feeSummary = await getStudentFeeSummary(studentId, student.classId, term, year);

                // Branded Header
                docPdf.setFillColor(...primaryColor);
                docPdf.rect(0, 0, 210, 40, 'F');
                docPdf.setTextColor(255, 255, 255);
                docPdf.setFontSize(22);
                docPdf.setFont("helvetica", "bold");
                docPdf.text(school.name || "STUDENT REPORT", 105, 18, { align: "center" });
                docPdf.setFontSize(10);
                docPdf.setFont("helvetica", "italic");
                docPdf.text(school.motto || "", 105, 26, { align: "center" });
                docPdf.setFontSize(9);
                docPdf.setFont("helvetica", "normal");
                docPdf.text(school.contact || "", 105, 32, { align: "center" });

                // Student Info Box
                docPdf.setTextColor(0, 0, 0);
                docPdf.setFontSize(12);
                docPdf.setFont("helvetica", "bold");
                docPdf.text(`STUDENT PROGRESS REPORT`, 105, 60, { align: "center" });
                
                docPdf.setFontSize(10);
                docPdf.text(`Student Name: ${student.name}`, 20, 75);
                docPdf.text(`Admission No: ${student.studentId}`, 20, 82);
                docPdf.text(`Class: ${className}`, 130, 75);
                docPdf.text(`Academic Period: ${term} ${year}`, 130, 82);

                // Results Table
                const examSnap = await getDocs(query(collection(db, "exams"), 
                    where("schoolId", "==", currentSchoolId), 
                    where("studentId", "==", studentId),
                    where("term", "==", term),
                    where("year", "==", year)
                ));
                
                const rows = [];
                let totalMarks = 0;
                const useGrades = gradesEnabled();
                examSnap.forEach(d => {
                    const e = d.data();
                    const m = e.marks || 0;
                    totalMarks += m;
                    rows.push(useGrades ? [e.subject, m, getGrade(m)] : [e.subject, m]);
                });

                const average = rows.length > 0 ? (totalMarks / rows.length).toFixed(2) : 0;

                if (rows.length === 0) {
                    docPdf.setFont("helvetica", "italic");
                    docPdf.setFontSize(12);
                    docPdf.setTextColor(150, 150, 150);
                    docPdf.text(`No exam results recorded for ${term} ${year}.`, 105, 95, { align: "center" });
                    docPdf.save(`Report_${student.name.replace(/\s/g, '_')}.pdf`);
                    showToast("No results recorded for this student in the selected term.", "warning");
                    return;
                }

                docPdf.autoTable({
                    startY: 95,
                    head: [useGrades ? ['Subject', 'Marks Obtained', 'Grade'] : ['Subject', 'Marks Obtained']],
                    body: rows,
                    theme: 'striped',
                    headStyles: { fillColor: primaryColor }
                });

                // Summary Section
                const finalY = docPdf.lastAutoTable.finalY + 12;
                docPdf.setFont("helvetica", "bold");
                docPdf.text(`Total Score: ${totalMarks}`, 20, finalY);
                docPdf.text(`Mean Average: ${average}%`, 80, finalY);
                if (useGrades) docPdf.text(`Final Grade: ${getGrade(average)}`, 140, finalY);
                docPdf.text(`Class Rank: ${position} out of ${totalInClass}`, 20, finalY + 8);
                
                docPdf.text(`Fee Balance: ${fmtKES(feeSummary.balance)}`, 130, finalY + 8);

                docPdf.setFont("helvetica", "italic");
                docPdf.text(`Teacher's Remark: ${getRemark(average)}`, 20, finalY + 18);

                const signY = finalY + 40;
                docPdf.setFont("helvetica", "normal");
                docPdf.text("Class Teacher's Signature: ________________________________", 20, signY);
                docPdf.text("Principal's Signature: _______________________", 20, signY + 15);
                docPdf.text("Official School Stamp", 140, signY + 15);

                // LEGITIMACY QR CODE
                const verifyData = `VERIFIED: ${school.name} | Student: ${student.name} | Period: ${term} ${year} | Avg: ${average}% | Rank: ${position}/${totalInClass}`;
                const qrUrl = `https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=${encodeURIComponent(verifyData)}`;
                
                const img = new Image();
                img.crossOrigin = "Anonymous";
                img.src = qrUrl;
                // Never let an unreachable QR service hang the report â€” resolve after 4s either way.
                await Promise.race([
                    new Promise((resolve) => { img.onload = resolve; img.onerror = resolve; }),
                    new Promise((resolve) => setTimeout(resolve, 4000))
                ]);
                
                if(img.complete && img.naturalWidth !== 0) {
                    docPdf.addImage(img, 'PNG', 165, finalY + 10, 25, 25);
                    docPdf.setFontSize(7);
                    docPdf.text("Scan to Verify", 177.5, finalY + 38, { align: "center" });
                }

                docPdf.save(`Report_${student.name.replace(/\s/g, '_')}.pdf`);
            } catch (err) {
                console.error(err);
                showToast("Error generating report: " + err.message, "error");
            } finally {
                showLoader(false);
            }
        };

        // --- BULK PERSONALIZED NEWSLETTER ENGINE ---
        // --- BULK TERM REPORTS ENGINE (PDF / WhatsApp / Email) ---
        window.populateBulkReportForm = async () => {
            const select = document.getElementById('bulk-report-class-filter');
            if (select && select.options.length <= 1) {
                try {
                    const snap = await getDocs(query(collection(db, 'classes'), where('schoolId', '==', currentSchoolId)));
                    snap.forEach(d => {
                        const opt = document.createElement('option');
                        opt.value = d.id;
                        opt.textContent = d.data().name;
                        select.appendChild(opt);
                    });
                } catch (err) { /* silent */ }
            }
            const yearEl = document.getElementById('bulk-report-year');
            if (yearEl && !yearEl.value) yearEl.value = currentAcademicYear;
        };

        async function collectBulkReportData() {
            const term = document.getElementById('bulk-report-term').value;
            const year = parseInt(document.getElementById('bulk-report-year').value) || currentAcademicYear;
            const classFilter = document.getElementById('bulk-report-class-filter').value;
            const perfFilter = document.getElementById('bulk-report-performance-filter').value;
            const openingDate = document.getElementById('bulk-report-opening-date').value || '';
            const closingDate = document.getElementById('bulk-report-closing-date').value || '';

            const studSnap = await getDocs(query(collection(db, 'students'), where('schoolId', '==', currentSchoolId)));
            const classSnap = await getDocs(query(collection(db, 'classes'), where('schoolId', '==', currentSchoolId)));
            const classMap = {};
            classSnap.forEach(d => classMap[d.id] = d.data().name);

            // Build per-student exam rows + class rankings
            const students = [];
            const rankByClass = {};
            for (const sd of studSnap.docs) {
                const s = sd.data();
                if (classFilter && classFilter !== 'all' && s.classId !== classFilter) continue;
                const examQ = query(collection(db, 'exams'),
                    where('schoolId', '==', currentSchoolId),
                    where('studentId', '==', sd.id),
                    where('term', '==', term),
                    where('year', '==', year));
                const exSnap = await getDocs(examQ);
                const rows = [];
                let total = 0;
                exSnap.forEach(d => { const r = d.data(); rows.push({ subject: r.subject, marks: r.marks, grade: gradesEnabled() ? (r.grade || getGrade(r.marks)) : '' }); total += (r.marks || 0); });
                rows.sort((a, b) => String(a.subject).localeCompare(String(b.subject)));
                const avg = rows.length ? (total / rows.length) : 0;
                const fee = await getStudentFeeSummary(sd.id, s.classId, term, year);
                students.push({ id: sd.id, studentId: s.studentId || sd.id, name: s.name, className: classMap[s.classId] || 'Unassigned', classId: s.classId, parentContact: s.parentContact || '', rows, total, avg, grade: gradesEnabled() ? getGrade(avg) : '', remark: getRemark(avg), fee });
            }
            // Rank within each class (top avg first)
            const classGroups = {};
            students.forEach(s => { (classGroups[s.classId || 'x'] = classGroups[s.classId || 'x'] || []).push(s); });
            Object.values(classGroups).forEach(list => {
                list.sort((a, b) => b.avg - a.avg);
                list.forEach((s, i) => s.position = i + 1);
            });
            // Attendance summary per student (from the attendance collection, term/year scoped)
            let attendanceByStudent = {};
            try {
                const attSnap = await getDocs(query(collection(db, 'attendance'), where('schoolId', '==', currentSchoolId)));
                const c = (v) => String(v || 'Absent').toLowerCase();
                attSnap.forEach(d => {
                    const r = d.data();
                    const inTerm = (r.term && r.term === term && String(r.year) === String(year)) ||
                        (r.date && openingDate && closingDate && r.date >= openingDate && r.date <= closingDate);
                    if (!inTerm) return;
                    Object.entries(r.records || {}).forEach(([sid, st]) => {
                        if (!attendanceByStudent[sid]) attendanceByStudent[sid] = { present: 0, late: 0, absent: 0, excused: 0, total: 0 };
                        const k = c(st); if (k in attendanceByStudent[sid]) attendanceByStudent[sid][k]++;
                        attendanceByStudent[sid].total++;
                    });
                });
            } catch (e) { attendanceByStudent = {}; }
            students.forEach(s => {
                const a = attendanceByStudent[s.id] || { present: 0, late: 0, absent: 0, excused: 0, total: 0 };
                const attended = a.present + a.late;
                s.attendance = { ...a, rate: a.total ? Math.round((attended / a.total) * 100) : 0 };
            });

            // Performance filter
            let filtered = students;
            if (perfFilter === 'top') filtered = students.filter(s => (s.position || 99) === 1);
            else if (perfFilter === 'needs-improvement') filtered = students.filter(s => s.avg < 50);

            // Term announcements for the "news" section
            let announcements = [];
            try {
                const annSnap = await getDocs(query(collection(db, 'announcements'), where('schoolId', '==', currentSchoolId), orderBy('date', 'desc'), limit(8)));
                announcements = annSnap.docs.map(d => d.data());
            } catch (e) { announcements = []; }

            const termMeta = {
                openingDate,
                closingDate,
                nextOpeningDate: document.getElementById('bulk-report-next-term-opening-date').value || '',
                summary: document.getElementById('bulk-report-term-summary').value.trim() || '',
                teacherComment: document.getElementById('bulk-report-teacher-comment').value.trim() || ''
            };
            return { term, year, students: filtered, termMeta, announcements, classMap };
        }

        window.generateBulkReports = async (mode) => {
            if(!hasPermission('edit')) return showToast("Permission denied", "error");
            showLoader(true);
            try {
                const { term, year, students, termMeta, announcements, classMap } = await collectBulkReportData();
                const school = await getSchoolInfo();
                const principalName = document.getElementById('bulk-report-principal-name').value.trim() || school.principalName || 'Principal';

                if (mode === 'pdf') {
                    if (students.length === 0) { showToast("No students match the filters", "warning"); return; }
                    const { jsPDF } = window.jspdf;
                    const doc = new jsPDF();
                    const accent = hexToRgb(schoolThemeColor);
                    const pageW = 210;
                    const maxY = 278;

                    // Ensure remaining content fits before the bottom of the page
                    const ensureSpace = (needed, currentY) => {
                        if (currentY + needed > maxY) { doc.addPage(); return 20; }
                        return currentY;
                    };
                    // Section heading helper
                    const sectionHeading = (y, text) => {
                        y = ensureSpace(26, y);
                        doc.setFillColor(240, 240, 240);
                        doc.rect(14, y - 5, pageW - 28, 8, 'F');
                        doc.setFont('helvetica', 'bold'); doc.setFontSize(10);
                        doc.setTextColor(50, 50, 50);
                        doc.text(text.toUpperCase(), 18, y);
                        doc.setFont('helvetica', 'normal');
                        return y + 8;
                    };

                    students.forEach((s, idx) => {
                        if (idx > 0) doc.addPage();

                        // ===== Masthead / Header band =====
                        doc.setFillColor(...accent);
                        doc.rect(0, 0, pageW, 44, 'F');
                        doc.setFillColor(255, 255, 255);
                        doc.rect(0, 44, pageW, 1.5, 'F');
                        doc.setTextColor(255, 255, 255);
                        doc.setFont('helvetica', 'bold'); doc.setFontSize(18);
                        doc.text(school.name || 'SCHOOL NEWSLETTER', 105, 18, { align: 'center' });
                        doc.setFontSize(9); doc.setFont('helvetica', 'italic');
                        doc.text(`${school.motto || ''}`, 105, 25, { align: 'center' });
                        doc.setFont('helvetica', 'normal'); doc.setFontSize(8);

                        // Term ribbon (gold accent) under the masthead
                        doc.setFillColor(233, 185, 75);
                        doc.rect(0, 31, pageW, 13, 'F');
                        doc.setTextColor(60, 40, 0);
                        doc.setFont('helvetica', 'bold'); doc.setFontSize(10);
                        doc.text(`TERM NEWSLETTER  â€¢  ${term} ${year}`, 105, 39, { align: 'center' });

                        // ===== Intro / term dates =====
                        let y = 55;
                        doc.setTextColor(0, 0, 0);
                        doc.setFont('helvetica', 'italic'); doc.setFontSize(9);
                        const datesBits = [
                            termMeta.openingDate ? `Opened: ${termMeta.openingDate}` : '',
                            termMeta.closingDate ? `Closed: ${termMeta.closingDate}` : '',
                            termMeta.nextOpeningDate ? `Next term opens: ${termMeta.nextOpeningDate}` : ''
                        ].filter(Boolean);
                        doc.text(datesBits.join('   |   '), 105, 55, { align: 'center' });

                        // ===== A Message from the Head =====
                        y = sectionHeading(64, `A message from ${principalName}`);
                        doc.setFont('helvetica', 'normal'); doc.setFontSize(9.5);
                        doc.setTextColor(60, 60, 60);
                        if (termMeta.teacherComment) {
                            const msgLines = doc.splitTextToSize(termMeta.teacherComment, pageW - 40);
                            msgLines.slice(0, 3).forEach((ln) => { doc.text(ln, 20, y); y += 5; });
                        } else {
                            doc.text('Dear parents, thank you for your continued support this term.', 20, y); y += 5;
                        }

                        // ===== Term Highlights =====
                        y = sectionHeading(y + 6, 'Term Highlights & Announcements');
                        if (announcements.length) {
                            announcements.slice(0, 4).forEach(a => {
                                y = ensureSpace(20, y);
                                doc.setFont('helvetica', 'bold'); doc.setFontSize(9.5);
                                doc.setTextColor(accent[0], accent[1], accent[2]);
                                const title = doc.splitTextToSize(a.title || 'Announcement', pageW - 36);
                                doc.text(title[0], 20, y); y += 5;
                                doc.setFont('helvetica', 'normal'); doc.setFontSize(8.5);
                                doc.setTextColor(70, 70, 70);
                                const body = doc.splitTextToSize(a.content || '', pageW - 36);
                                body.slice(0, 2).forEach(ln => { doc.text(ln, 20, y); y += 4; });
                                y += 3;
                            });
                        } else {
                            doc.setFont('helvetica', 'italic'); doc.setFontSize(9);
                            doc.text('No announcements published this term.', 20, y); y += 5;
                        }

                        // ===== Personalised student progress =====
                        y = sectionHeading(y + 6, 'Your Child\'s Progress');
                        doc.setFillColor(245, 245, 248);
                        doc.rect(14, y - 1, pageW - 28, 34, 'F');
                        doc.setDrawColor(200, 200, 200);
                        doc.rect(14, y - 1, pageW - 28, 34, 'S');
                        doc.setFont('helvetica', 'bold'); doc.setFontSize(11);
                        doc.setTextColor(0, 0, 0);
                        doc.text(s.name, 20, y + 9);
                        doc.setFont('helvetica', 'normal'); doc.setFontSize(9);
                        doc.text(`Adm No: ${s.studentId}    â€¢    Class: ${s.className}`, 20, y + 16);
                        doc.text(`Average: ${s.avg.toFixed(1)}%     Grade: ${s.grade}`, 20, y + 23);
                        doc.text(`Class Position: ${(s.position ? String(s.position) : '-')}`, 20, y + 30);

                        // Subject marks table
                        y = ensureSpace(20, y + 38);
                        if (s.rows && s.rows.length) {
                            doc.autoTable({
                                startY: y,
                                margin: { left: 16, right: 16 },
                                head: [gradesEnabled() ? ['Subject', 'Marks', 'Grade'] : ['Subject', 'Marks']],
                                body: s.rows.map(r => gradesEnabled() ? [r.subject, String(r.marks), r.grade || '-'] : [r.subject, String(r.marks)]),
                                theme: 'grid',
                                styles: { fontSize: 9, cellPadding: 2 },
                                headStyles: { fillColor: accent, textColor: 255 },
                                alternateRowStyles: { fillColor: [248, 248, 250] }
                            });
                            y = (doc.lastAutoTable ? doc.lastAutoTable.finalY : y) + 4;
                            doc.setFont('helvetica', 'bold'); doc.setFontSize(10);
                            doc.setTextColor(0, 0, 0);
                            doc.text(`Total: ${s.total} / ${s.rows.length * 100}     Mean: ${s.avg.toFixed(1)}%` + (gradesEnabled() ? `     Grade: ${s.grade}` : ''), 18, y + 4);
                            y += 12;
                        } else {
                            doc.setFont('helvetica', 'italic'); doc.setFontSize(9);
                            doc.text('No exam results recorded for this student in the selected term.', 20, y);
                            y += 8;
                        }

                        // ===== Attendance summary =====
                        y = sectionHeading(y + 8, 'Attendance Summary');
                        const att = s.attendance || { present: 0, late: 0, absent: 0, excused: 0, rate: 0 };
                        y = ensureSpace(14, y);
                        doc.setFont('helvetica', 'normal'); doc.setFontSize(9.5);
                        doc.setTextColor(0, 0, 0);
                        const attBits = [
                            `Present: ${att.present}`,
                            `Late: ${att.late}`,
                            `Absent: ${att.absent}`,
                            `Excused: ${att.excused}`
                        ];
                        doc.setFont('helvetica', 'bold');
                        doc.text(`Attendance: ${att.rate}%`, 172, y, { align: 'right' });
                        doc.text(attBits.join('    '), 18, y);
                        y += 6;


// ===== Financial / Fee statement =====
                        y = sectionHeading(y + 4, 'Fee Statement');
                        y = ensureSpace(20, y);
                        doc.setFont('helvetica', 'normal'); doc.setFontSize(9.5);
                        doc.setTextColor(0, 0, 0);
                        doc.text(`Fees for ${term}: ${fmtKES(s.fee.total)}`, 18, y);
                        doc.text(`Paid to date: ${fmtKES(s.fee.paid)}`, 115, y);
                        y += 6;
                        doc.setFont('helvetica', 'bold');
                        doc.setTextColor(...(s.fee.balance > 0 ? [200, 40, 40] : [0, 120, 60]));
                        doc.text(`Balance: ${fmtKES(s.fee.balance)}`, 18, y);
                        doc.setFont('helvetica', 'normal'); doc.setFontSize(8.5);
                        doc.setTextColor(60, 60, 60);
                        doc.text(s.fee.balance > 0
                            ? `Please clear the outstanding balance of ${fmtKES(s.fee.balance)} before ${termMeta.nextOpeningDate || 'the next term'}.`
                            : 'Thank you â€” this term\'s fees are fully settled.', 80, y);
                        y += 10;

                        // ===== Term summary =====
                        if (termMeta.summary) {
                            y = sectionHeading(y + 2, 'Term Summary');
                            y = ensureSpace(22, y);
                            doc.setFont('helvetica', 'normal'); doc.setFontSize(9);
                            doc.setTextColor(50, 50, 50);
                            const sumLines = doc.splitTextToSize(termMeta.summary, pageW - 40);
                            sumLines.forEach(ln => { doc.text(ln, 18, y); y += 4.5; });
                            y += 5;
                        }

                        // ===== Sign-off =====
                        y = sectionHeading(y, 'Thank you for your partnership');
                        y = Math.max(y + 10, 240);
                        y = ensureSpace(30, y);
                        doc.setFont('helvetica', 'normal'); doc.setFontSize(10);
                        doc.setTextColor(0, 0, 0);
                        doc.text('Warm regards,', 20, y);
                        doc.setFont('helvetica', 'italic');
                        doc.text(principalName, 20, y + 14);
                        doc.setFont('helvetica', 'normal');
                        doc.text('Principal', 20, y + 19);

                        // Footer
                        doc.setFont('helvetica', 'italic'); doc.setFontSize(7.5);
                        doc.setTextColor(130, 130, 130);
                        doc.text('This is an official newsletter generated by the School Management System.', 105, 292, { align: 'center' });
                    });
                    doc.save(`TermNewsletter_${term.replace(/\s/g, '')}_${year}.pdf`);
                    showToast(`Generated ${students.length} personalised term newsletter(s)`, "success");
                } else {
                    const lines = [];
                    students.forEach(s => {
                        lines.push(`*${school.name || 'School'}* Â· ${term} ${year} REPORT`);
                        lines.push(`Student: ${s.name} (${s.className}) | Adm No: ${s.studentId}`);
                        lines.push(`Average: ${s.avg}%${gradesEnabled() ? ` | Grade: ${s.grade}` : ''} | ${s.remark}`);
                        lines.push(`Fees: ${fmtKES(s.fee.paid)} paid | Balance ${fmtKES(s.fee.balance)}`);
                        if (mode === 'whatsapp' && s.parentContact) {
                            const phone = s.parentContact.replace(/[^0-9+]/g, '');
                            const waPhone = phone.startsWith('0') ? '254' + phone.slice(1) : phone.replace(/^\+/g, '');
                            lines.push(`WhatsApp: https://wa.me/${waPhone}`);
                        } else if (mode === 'email') {
                            lines.push(`Email: send via school office`);
                        }
                        lines.push('----------------------------------------');
                    });
                    const outEl = document.getElementById('bulk-report-output-content');
                    const outBox = document.getElementById('bulk-report-output');
                    if (outEl) outEl.innerText = lines.join('\n');
                    if (outBox) outBox.style.display = 'block';
                    showToast(`Generated ${students.length} message(s)`, "success");
                }
            } catch (err) { showToast(getFriendlyErrorMessage(err), "error"); }
            finally { showLoader(false); }
        };

        // --- PARENT WHATSAPP BROADCAST ---
        window.openParentBroadcast = async () => {
            const sel = document.getElementById('pb-class');
            if (sel && sel.options.length <= 1) {
                try {
                    const snap = await getDocs(query(collection(db, 'classes'), where('schoolId', '==', currentSchoolId)));
                    snap.forEach(d => {
                        const opt = document.createElement('option');
                        opt.value = d.id; opt.textContent = d.data().name; sel.appendChild(opt);
                    });
                } catch (err) { /* silent */ }
            }
            openModal('modal-parent-broadcast');
        };

        window.generateParentBroadcast = async () => {
            const classFilter = document.getElementById('pb-class').value;
            const message = document.getElementById('pb-message').value.trim();
            const studSnap = await getDocs(query(collection(db, 'students'), where('schoolId', '==', currentSchoolId)));
            const school = await getSchoolInfo();
            const text = message.length ? message : 'Dear parent/guardian, please see the latest school notice.';
            const encoded = encodeURIComponent(text + '\n\n' + (school.name || ''));

            const html = [];
            const copy = [];
            const seen = new Set();
            studSnap.forEach(d => {
                const s = d.data();
                if (classFilter && s.classId !== classFilter) return;
                const raw = (s.parentContact || '').trim();
                const phone = raw.replace(/[^0-9+]/g, '');
                if (!phone || seen.has(phone)) return;
                seen.add(phone);
                const waPhone = phone.startsWith('0') ? '254' + phone.slice(1) : phone.replace(/^\+/, '');
                const link = `https://wa.me/${waPhone}?text=${encoded}`;
                html.push(`<div style="line-height:1.7;"><b>${s.name.split(' ')[0]}'s guardian</b> Â· <a href="${link}" target="_blank" rel="noopener" style="color:var(--success);">${waPhone}</a> â†’ WhatsApp</div>`);
                copy.push(`${waPhone} -> ${link}`);
            });
            const box = document.getElementById('pb-list');
            if (!box) return;
            box.innerHTML = html.length ? html.join('') : '<p class="text-muted">No parent contact numbers found â€” add them in student profiles.</p>';
            window.__pbLines = copy;
        };

        window.copyParentBroadcast = () => {
            if (window.__pbLines && window.__pbLines.length) {
                navigator.clipboard.writeText(window.__pbLines.join('\n'));
                showToast("Parent WhatsApp list copied", "success");
            } else {
                showToast("Generate the parent list first", "warning");
            }
        };

        window.generateBulkClosingNewsletters = async (e) => {
            if(e) e.preventDefault();
            const term = document.getElementById('bulk-news-term').value;
            const year = parseInt(document.getElementById('bulk-news-year').value);
            
            if(!term || !year) return;
            
            closeModal('modal-bulk-newsletter');
            
            showLoader(true);
            try {
                const { jsPDF } = window.jspdf;
                const docPdf = new jsPDF();
                const school = await getSchoolInfo();
                const primaryColor = hexToRgb(schoolThemeColor);

                // 1. Fetch Master Data
                const studentsSnap = await getDocs(query(collection(db, "students"), where("schoolId", "==", currentSchoolId)));
                const classesSnap = await getDocs(query(collection(db, "classes"), where("schoolId", "==", currentSchoolId)));
                const annSnap = await getDocs(query(collection(db, "announcements"), where("schoolId", "==", currentSchoolId), orderBy("date", "desc"), limit(5)));
                
                if(studentsSnap.empty) throw new Error("No students found to generate newsletters.");

                const classMap = {};
                classesSnap.forEach(d => classMap[d.id] = d.data().name);

                // 2. Pre-calculate Ranks per Class (Optimized to save Firestore reads)
                const classRanks = {};
                for(let cDoc of classesSnap.docs) {
                    const classId = cDoc.id;
                    const rankings = [];
                    const classStudents = studentsSnap.docs.filter(s => s.data().classId === classId);
                    
                    for(let s of classStudents) {
                        const exSnap = await getDocs(query(collection(db, "exams"), 
                            where("schoolId", "==", currentSchoolId),
                            where("studentId", "==", s.id), 
                            where("term", "==", term), 
                            where("year", "==", year)
                        ));
                        let total = 0; let count = 0;
                        exSnap.forEach(ed => { total += (ed.data().marks || 0); count++; });
                        rankings.push({ id: s.id, avg: count > 0 ? (total/count) : 0 });
                    }
                    rankings.sort((a,b) => b.avg - a.avg);
                    classRanks[classId] = rankings;
                }

                // 3. Process Each Student
                let isFirstPage = true;
                for(let sDoc of studentsSnap.docs) {
                    const student = sDoc.data();
                    const studentId = sDoc.id;
                    const rankings = classRanks[student.classId] || [];
                    const studRank = rankings.find(r => r.id === studentId);
                    const position = rankings.findIndex(r => r.id === studentId) + 1;
                    const feeSummary = await getStudentFeeSummary(studentId, student.classId, term, year);

                    if(!isFirstPage) docPdf.addPage();
                    isFirstPage = false;

                    // Branded Header
                    docPdf.setFillColor(...primaryColor);
                    docPdf.rect(0, 0, 210, 40, 'F');
                    docPdf.setTextColor(255, 255, 255);
                    docPdf.setFontSize(22);
                    docPdf.setFont("helvetica", "bold");
                    docPdf.text(school.name || "SCHOOL NEWSLETTER", 105, 18, { align: "center" });
                    docPdf.setFontSize(10);
                    docPdf.text(school.motto || "", 105, 26, { align: "center" });
                    docPdf.text(school.contact || "", 105, 32, { align: "center" });

                    // Closing Message Section
                    docPdf.setTextColor(0, 0, 0);
                    docPdf.setFontSize(14);
                    docPdf.text("End of Term Closing Notice", 20, 55);
                    docPdf.setDrawColor(...primaryColor);
                    docPdf.line(20, 57, 85, 57);

                    let annY = 65;
                    annSnap.forEach(d => {
                        const a = d.data();
                        docPdf.setFontSize(10);
                        docPdf.setFont("helvetica", "bold");
                        docPdf.text(a.title, 20, annY);
                        docPdf.setFont("helvetica", "normal");
                        const splitContent = docPdf.splitTextToSize(a.content, 170);
                        docPdf.text(splitContent, 20, annY + 5);
                        annY += (splitContent.length * 5) + 10;
                    });

                    // Student Personalized Section
                    const statsY = annY + 5;
                    docPdf.setFillColor(245, 245, 245);
                    docPdf.rect(15, statsY, 180, 45, 'F');
                    docPdf.setDrawColor(200, 200, 200);
                    docPdf.rect(15, statsY, 180, 45, 'S');

                    docPdf.setFontSize(11);
                    docPdf.setFont("helvetica", "bold");
                    docPdf.text(`STUDENT PROGRESS: ${student.name}`, 20, statsY + 10);
                    docPdf.setFont("helvetica", "normal");
                    docPdf.setFontSize(10);
                    docPdf.text(`Admission No: ${student.studentId}`, 20, statsY + 18);
                    docPdf.text(`Class: ${classMap[student.classId] || 'N/A'}`, 20, statsY + 24);
                    
                    docPdf.text(`Mean Average: ${studRank ? studRank.avg.toFixed(1) : 0}%`, 110, statsY + 18);
                    docPdf.text(`Position: ${position} out of ${rankings.length}`, 110, statsY + 24);
                    if (gradesEnabled()) docPdf.text(`Grade: ${getGrade(studRank ? studRank.avg : 0)}`, 110, statsY + 30);
                    docPdf.text(`Remark: ${getRemark(studRank ? studRank.avg : 0)}`, 20, statsY + 30);

                    // Financial Section
                    const feeY = statsY + 55;
                    docPdf.setFontSize(11);
                    docPdf.setFont("helvetica", "bold");
                    docPdf.text("Financial Statement", 20, feeY);
                    docPdf.setFont("helvetica", "normal");
                    docPdf.setFontSize(10);
                    docPdf.text(`Total Fees for ${term}: ${fmtKES(feeSummary.total)}`, 20, feeY + 8);
                    docPdf.text(`Total Paid: ${fmtKES(feeSummary.paid)}`, 20, feeY + 14);
                    
                    docPdf.setTextColor(...(feeSummary.balance > 0 ? [128, 0, 0] : [0, 100, 0]));
                    docPdf.setFont("helvetica", "bold");
                    docPdf.text(`Outstanding Balance: ${fmtKES(feeSummary.balance)}`, 20, feeY + 22);
                    docPdf.setTextColor(0, 0, 0);

                    // Footer
                    docPdf.setFont("helvetica", "italic");
                    docPdf.setFontSize(9);
                    docPdf.text("This is an official document generated by the School Management System.", 105, 280, { align: "center" });
                }

                docPdf.save(`Closing_Newsletters_${term.replace(/\s/g, '_')}_${year}.pdf`);
                showToast("Bulk newsletters generated successfully!", "success");
            } catch (err) {
                console.error(err);
                showToast("Error generating bulk newsletters: " + err.message, "error");
            } finally {
                showLoader(false);
            }
        };

        /* =====================================================================
           SCHOOL OPERATIONS MODULE (extension)
           Granular permissions, academic structure, student enrichment,
           promotions/transfers, teacher assignments, admin management,
           import/export and audit logging. All records are school-scoped.
           ===================================================================== */

        // --- Ops state ---
        let currentUserPermissions = null;      // map of {key:true} or {all:true}
        let allStreams = [];
        let allSubjects = [];
        let allAcademicYears = [];
        let allTerms = [];
        let allTeacherAssignments = [];
        let allSchoolAdmins = [];
        let currentProfileStudentId = null;
        let pendingImportStudents = { valid: [], errors: [] };
        let roleEditorTarget = '';

        // Permissions catalog: module -> list of action grants
        const PERMS = {
            students: [
                {k:'students.view', label:'View Students'},
                {k:'students.create',label:'Add Students'},
                {k:'students.edit',label:'Edit Students'},
                {k:'students.archive',label:'Archive / Change Status'},
                {k:'students.transfer',label:'Transfer / Change Class'},
                {k:'students.promote',label:'Promote'},
                {k:'students.import',label:'Import / Export'}
            ],
            staff: [
                {k:'staff.view',label:'View Staff & Teachers'},
                {k:'staff.create',label:'Add / Edit Staff & Teachers'},
                {k:'staff.deactivate',label:'Deactivate Staff'}
            ],
            academics: [
                {k:'academics.view',label:'View Academic Setup'},
                {k:'academic_year.manage',label:'Manage Academic Years'},
                {k:'terms.manage',label:'Manage Terms'},
                {k:'grades.manage',label:'Manage Grades / Classes'},
                {k:'streams.manage',label:'Manage Streams'},
                {k:'subjects.manage',label:'Manage Subjects'},
                {k:'teacher_assignments.manage',label:'Manage Teacher Assignments'}
            ],
            attendance: [
                {k:'attendance.view',label:'View Attendance'},
                {k:'attendance.take',label:'Take Attendance'},
                {k:'attendance.edit',label:'Edit Attendance'},
                {k:'attendance.export',label:'Export Attendance Reports'}
            ],
            assessments: [
                {k:'assessments.view',label:'View Assessments'},
                {k:'assessments.create',label:'Create Assessments'},
                {k:'assessments.edit',label:'Enter / Edit Results'},
                {k:'assessments.approve',label:'Approve / Lock Results'},
                {k:'report_cards.generate',label:'Generate Report Cards'}
            ],
            finance: [
                {k:'fees.view',label:'View Fees'},
                {k:'fees.manage',label:'Manage Fee Structures'},
                {k:'invoices.create',label:'Create Invoices'},
                {k:'payments.view',label:'View Payments'},
                {k:'payments.record',label:'Record Payments'},
                {k:'receipts.view',label:'View Receipts'},
                {k:'finance.reports',label:'Finance Reports'}
            ],
            admin: [
                {k:'admin.manage_admins',label:'Manage School Admins'},
                {k:'admin.permissions',label:'Assign Permissions'},
                {k:'admin.audit',label:'View Audit Logs'}
            ]
        };

        const isOwnerRole = () => currentUserRole === 'owner';

        function hasPerm(module, action) {
            if (isOwnerRole()) return true;
            // An admin with no permissions map (or full) keeps complete access by default.
            if (currentUserRole === 'admin') {
                if (!currentUserPermissions) return true;
                if (currentUserPermissions.all === true) return true;
                return currentUserPermissions[module + '.' + action] === true;
            }
            if (currentUserRole === 'teacher') {
                if (currentUserPermissions) {
                    if (currentUserPermissions.all === true) return true;
                    if (currentUserPermissions[module + '.' + action] === true) return true;
                }
                return teacherDefaultPerms[module + '.' + action] === true;
            }
            return false;
        }

        // Enforce granular permissions for school *admins* only when the owner has
        // explicitly saved a permissions map for them. Legacy admins (no map) and
        // owners keep their existing full access, so nothing existing breaks.
        function enforcePerm(module, action) {
            if (isOwnerRole()) return true;
            if (currentUserRole === 'admin' && currentUserPermissions) return hasPerm(module, action);
            return true;
        }

        // Append a school-scoped audit record (best-effort).
        async function logAudit(module, action, recordId, prev, next) {
            try {
                const who = currentUserData ? (currentUserData.displayName || currentUserData.email || currentUserData.uid || 'User') : 'User';
                await addDoc(collection(db, 'audit_logs'), {
                    schoolId: currentSchoolId,
                    userId: currentUserData ? (currentUserData.email || currentUserData.uid || '') : '',
                    userName: who,
                    module, action, recordId,
                    previousValue: prev || '',
                    newValue: next || '',
                    timestamp: new Date().toISOString()
                });
            } catch (e) { /* audits are best-effort */ }
        }

        const escapeRegExp = (s) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

        // --- Admission number generation / uniqueness ---
        function nextAdmissionNo() {
            const cfg = schoolSettings.admissionConfig || {};
            const prefix = (cfg.prefix || 'ADM').toString().toUpperCase().replace(/[^A-Z0-9]/g, '');
            const year = currentAcademicYear || new Date().getFullYear();
            const used = allStudents.map(s => String(s.admissionNo || s.studentId || ''));
            const re = new RegExp('^' + escapeRegExp(prefix) + '/' + year + '/(\\d+)$');
            let maxSeq = 0;
            used.forEach(u => { const m = u.match(re); if (m) maxSeq = Math.max(maxSeq, parseInt(m[1])); });
            return `${prefix}/${year}/${String(maxSeq + 1).padStart(4, '0')}`;
        }

        window.autoFillAdmissionNo = () => { const e = document.getElementById('student-admission'); if (e) e.value = nextAdmissionNo(); };

        // Default grants for a teacher account (own classes / marks / attendance)
        const teacherDefaultPerms = {
            'students.view': true,
            'attendance.view': true,
            'attendance.take': true,
            'attendance.edit': true,
            'assessments.view': true,
            'assessments.create': true,
            'assessments.edit': true,
            'staff.view': true,
            'academics.view': true
        };

        // --- Selector helpers ---
        function populateStreamSelect(sel, current, classId) {
            if (!sel) return;
            const list = classId ? allStreams.filter(s => s.classId === classId && !s.archived) : allStreams.filter(s => !s.archived);
            sel.innerHTML = '<option value="">No stream</option>' + list.map(s => `<option value="${s.id}" ${current === s.id ? 'selected' : ''}>${s.name}</option>`).join('');
        }
        function populateAcademicYearSelect(sel, current) {
            if (!sel) return;
            const fallback = String(currentAcademicYear || new Date().getFullYear());
            sel.innerHTML = allAcademicYears.length
                ? allAcademicYears.map(y => `<option value="${y.name}" ${String(current) === String(y.name) ? 'selected' : ''}>${y.name}</option>`).join('')
                : `<option value="${fallback}">${fallback}</option>`;
        }
        function populateClassMultiSelect(selId, selected) {
            const el = document.getElementById(selId); if (!el) return;
            const selectedSet = new Set(selected || []);
            el.innerHTML = Object.entries(window.__opsClassMap || {})
                .map(([id, name]) => `<option value="${id}" ${selectedSet.has(id) ? 'selected' : ''}>${name}</option>`).join('');
        }

        const opsStatusBadge = (st) => {
            const cls = { 'Active':'badge-success','Graduated':'badge-active','Archived':'badge-inactive','Inactive':'badge-inactive','Transferred':'badge-warning','Left School':'badge-inactive' };
            return `<span class="badge ${cls[st] || 'badge-inactive'}">${st || 'Active'}</span>`;
        };

        // Build stream / class / year filter dropdowns (preserve current selections)
        function populateStudentFilters() {
            const classSel = document.getElementById('ops-student-class');
            if (classSel) {
                const cur = classSel.value;
                classSel.innerHTML = '<option value="">All Classes</option>' + Object.entries(window.__opsClassMap || {})
                    .map(([id, name]) => `<option value="${id}" ${cur === id ? 'selected' : ''}>${name}</option>`).join('');
            }
            const streamSel = document.getElementById('ops-student-stream');
            if (streamSel) {
                const cur = streamSel.value;
                streamSel.innerHTML = '<option value="">All Streams</option>' + allStreams
                    .map(s => `<option value="${s.id}" ${cur === s.id ? 'selected' : ''}>${s.name}</option>`).join('');
            }
            const yearSel = document.getElementById('ops-student-year');
            if (yearSel) {
                const cur = yearSel.value;
                const years = [...new Set(allStudents.map(s => String(s.academicYear || currentAcademicYear)).filter(Boolean))];
                const opts = allAcademicYears.length ? allAcademicYears.map(y => String(y.name)) : years;
                yearSel.innerHTML = '<option value="">All Years</option>' + [...new Set([...opts, ...years])]
                    .map(y => `<option value="${y}" ${cur === y ? 'selected' : ''}>${y}</option>`).join('');
            }
        }

        window.resetStudentListFilters = () => {
            ['ops-student-search','ops-student-class','ops-student-stream','ops-student-status','ops-student-year'].forEach(id => {
                const e = document.getElementById(id); if (e) e.value = '';
            });
            renderStudentList();
        };

        function renderStudentList() {
            const tbody = document.getElementById('student-list-body');
            if (!tbody) return;
            const qq = String(document.getElementById('ops-student-search').value || '').toLowerCase();
            const fClass = document.getElementById('ops-student-class').value;
            const fStream = document.getElementById('ops-student-stream').value;
            const fStatus = document.getElementById('ops-student-status').value;
            const fYear = document.getElementById('ops-student-year').value;
            const classMap = window.__opsClassMap || {};
            const streamMap = window.__opsStreamMap || {};
            const rows = allStudents.filter(s => {
                if (qq) {
                    const hay = (s.name + ' ' + (s.admissionNo || s.studentId || '') + ' ' + (s.firstName||'') + ' ' + (s.lastName||'')).toLowerCase();
                    if (!hay.includes(qq)) return false;
                }
                if (fClass && s.classId !== fClass) return false;
                if (fStream && s.streamId !== fStream) return false;
                if (fStatus && (s.status || 'Active') !== fStatus) return false;
                if (fYear && String(s.academicYear || currentAcademicYear) !== String(fYear)) return false;
                return true;
            });
            document.getElementById('count-students').innerText = allStudents.length;
            tbody.innerHTML = '';
            if (!rows.length) {
                tbody.innerHTML = '<tr><td colspan="10" style="text-align:center; color:var(--text-muted);">No students match the current filters.</td></tr>';
                return;
            }
            const canEditS = hasPerm('students', 'edit') || currentUserRole === 'admin';
            const canDel = hasPermission('delete');
            rows.slice(0, 200).forEach(s => {
                tbody.innerHTML += `
                    <tr>
                        <td><img src="${s.photoUrl || 'https://ui-avatars.com/api/?name=' + s.name}" class="student-thumb" onerror="this.style.display='none'"></td>
                        <td><span style="font-family:'Space Mono'; font-size:0.78rem;">${s.admissionNo || s.studentId || '-'}</span></td>
                        <td><b>${s.name}</b></td>
                        <td>${s.gender || '-'}</td>
                        <td>${classMap[s.classId] || 'Unassigned'}</td>
                        <td>${streamMap[s.streamId] || '-'}</td>
                        <td>${s.academicYear || currentAcademicYear}</td>
                        <td>${s.parentContact || '-'}</td>
                        <td>${opsStatusBadge(s.status || 'Active')}</td>
                        <td style="white-space:nowrap;">
                            <i class="fas fa-user" style="color:var(--primary); cursor:pointer; margin-right:8px;" title="View Profile" onclick="openStudentProfile('${s.docId}')"></i>
                            <i class="fas fa-file-invoice-dollar" style="color:var(--success); cursor:pointer; margin-right:8px;" title="Fee Statement" onclick="window.quickViewFinancials('${s.docId}')"></i>
                            ${canEditS ? `<i class="fas fa-edit" style="color:var(--primary); cursor:pointer; margin-right:8px;" onclick="editStudent('${s.docId}')"></i>` : ''}
                            ${canDel ? `<i class="fas fa-trash" style="color:var(--danger); cursor:pointer;" onclick="deleteStudent('${s.docId}')"></i>` : ''}
                        </td>
                    </tr>`;
            });
        }

        // Export filtered students to CSV
        window.exportStudentsCSV = () => {
            const classMap = window.__opsClassMap || {};
            const streamMap = window.__opsStreamMap || {};
            const header = ['AdmissionNo','Name','Gender','Grade','Stream','AcademicYear','DOB','GuardianContact','Status'];
            const rows = [header];
            allStudents.forEach(s => rows.push([
                s.admissionNo || s.studentId || '',
                s.name || '',
                s.gender || '',
                classMap[s.classId] || '',
                streamMap[s.streamId] || '',
                s.academicYear || currentAcademicYear,
                s.dob || '',
                s.parentContact || '',
                s.status || 'Active'
            ]));
            downloadCSV('Students_List.csv', rows);
            logAudit('students','export','all','','CSV export');
            showToast("Students exported", "success");
        };

        // --- Student Profile + Archive + History ---
        window.openStudentProfile = async (id) => {
            const own = await getScopedDoc("students", id);
            if (!own) return showToast("Record not found in your school", "error");
            currentProfileStudentId = id;
            const s = own.data;
            const classMap = window.__opsClassMap || {};
            const streamMap = window.__opsStreamMap || {};
            const histSnap = await getDocs(query(collection(db, "student_histories"), where("schoolId", "==", currentSchoolId), where("studentId", "==", id)).limit(20));
            const histories = histSnap.docs.map(d => d.data()).sort((a,b) => String(b.date||b.timestamp).localeCompare(String(a.date||a.timestamp)));
            openModal('modal-student-profile');
            document.getElementById('student-profile-content').innerHTML = `
                <div style="display:flex; gap:20px; align-items:center; margin-bottom:16px; flex-wrap:wrap;">
                    <img src="${s.photoUrl || 'https://ui-avatars.com/api/?name=' + s.name}" class="student-thumb" style="width:72px; height:72px; border-radius:50%; object-fit:cover;">
                    <div>
                        <h4 style="margin:0;">${s.name}</h4>
                        <div style="margin-top:4px;">Adm No: <b>${s.admissionNo || s.studentId || '-'}</b> &nbsp;|&nbsp; ${opsStatusBadge(s.status || 'Active')}</div>
                    </div>
                </div>
                <div class="flex gap-10" style="flex-wrap:wrap;">
                    <div class="card" style="flex:1; min-width:220px; padding:1rem;">
                        <h5 style="margin:0 0 8px;">Academic</h5>
                        <p class="text-muted" style="font-size:0.9rem;">Grade: <b>${classMap[s.classId] || 'Unassigned'}</b><br>Stream: <b>${streamMap[s.streamId] || '-'}</b><br>Academic Year: <b>${s.academicYear || currentAcademicYear}</b><br>Admission: <b>${s.admissionDate || '-'}</b><br>DOB: <b>${s.dob || '-'}</b><br>Gender: <b>${s.gender || '-'}</b></p>
                    </div>
                    <div class="card" style="flex:1; min-width:260px; margin:1rem;">
                        <h5 style="margin:0 0 6px;">Guardian</h5>
                        <p class="text-muted" style="font-size:0.9rem;">Contact: <b>${s.parentContact || '-'}</b></p>
                        <h5 style="margin:10px 0 6px;">Fee Balance</h5>
                        <p class="text-muted" style="font-size:0.9rem;">Total: <b>${fmtKES((s.fees||{}).total)}</b> &nbsp; Paid: <b>${fmtKES((s.fees||{}).paid)}</b> &nbsp; Balance: <b>${fmtKES((s.fees||{}).balance)}</b></p>
                    </div>
                </div>
                <h5 style="margin:4px 0 6px;">History</h5>
                <div id="student-history-box" style="max-height:180px; overflow:auto;">${histories.length ? histories.map(h =>
                    `<div style="font-size:0.82rem; border-bottom:1px solid var(--border); padding:4px 0;"><b>${h.type}</b> â€” ${h.notes || ''} <span class="text-muted">(${h.date ? new Date(h.date).toLocaleDateString() : ''})</span></div>`
                ).join('') : '<p class="text-muted">No prior academic records.</p>'}</div>
            `;
        };

        window.archiveStudentFromProfile = () => {
            if (!currentProfileStudentId) return;
            if (!hasPerm('students', 'archive') && currentUserRole !== 'admin') return showToast("Permission denied", "error");
            if (!confirm("Archive this student? Record is preserved (not deleted).")) return;
            updateStudentStatus(currentProfileStudentId, 'Archived', 'Student archived from profile');
        };

        window.editStudentFromProfile = () => {
            if (!currentProfileStudentId) return showToast("Open a student profile first", "warning");
            if (!enforcePerm('students', 'edit')) return showToast("Permission denied", "error");
            closeModal('modal-student-profile');
            editStudent(currentProfileStudentId);
        };

        async function archiveStudentDirect(id) {
            if (!hasPerm('students', 'archive') && currentUserRole !== 'admin') return showToast("Permission denied", "error");
            if (!confirm("Archive this student? The record is kept for historical reference.")) return;
            await updateStudentStatus(id, 'Archived', 'Student archived from directory');
        }

        async function updateStudentStatus(id, status, note) {
            try {
                const own = await getScopedDoc("students", id);
                if (!own) return showToast("Record not found in your school", "error");
                await updateDoc(doc(db, "students", id), { status, updatedAt: new Date().toISOString() });
                await addDoc(collection(db, "student_histories"), {
                    schoolId: currentSchoolId, studentId: id, type: 'status',
                    toData: { status }, notes: note, date: new Date().toISOString(),
                    byUser: currentUserData ? currentUserData.email : ''
                });
                logAudit('students', status.toLowerCase().replace(' ','_'), id, '', status);
                showToast("Student status updated", "success");
            } catch (err) { showToast(getFriendlyErrorMessage(err), "error"); }
        }

        // --- Transfer ---
        window.openTransferModal = () => {
            if (!currentProfileStudentId) return showToast("Open a student profile first", "warning");
            document.getElementById('transfer-student-id').value = currentProfileStudentId;
            document.getElementById('transfer-class').innerHTML = '<option value="">Select grade</option>' +
                Object.entries(window.__opsClassMap || {}).map(([id, name]) => `<option value="${id}">${name}</option>`).join('');
            populateStreamSelect(document.getElementById('transfer-stream'), '', '');
            document.getElementById('transfer-date').value = new Date().toISOString().slice(0,10);
            document.getElementById('transfer-type').value = 'Internal';
            openModal('modal-transfer');
        };

        window.saveStudentTransfer = async (e) => {
            e.preventDefault();
            if (!hasPerm('students', 'transfer') && currentUserRole !== 'admin') return showToast("Permission denied", "error");
            const id = document.getElementById('transfer-student-id').value;
            const classId = document.getElementById('transfer-class').value;
            const streamId = document.getElementById('transfer-stream').value;
            const type = document.getElementById('transfer-type').value;
            const destSchool = document.getElementById('transfer-dest-school').value;
            const reason = document.getElementById('transfer-reason').value;
            const date = document.getElementById('transfer-date').value;
            if (!classId) return showToast("Select a destination grade/class", "error");
            if (streamId) {
                const st = allStreams.find(s => s.id === streamId);
                if (!st || st.schoolId !== currentSchoolId) return showToast("Invalid stream for this school", "error");
                if (st.classId && st.classId !== classId) return showToast("Stream does not belong to the selected grade/class", "error");
            }
            try {
                const own = await getScopedDoc("students", id);
                if (!own) return showToast("Record not found in your school", "error");
                const prev = own.data;
                await updateDoc(doc(db, "students", id), { classId, streamId, status: type === 'Transferred Out' ? 'Transferred' : (prev.status || 'Active'), updatedAt: new Date().toISOString() });
                await addDoc(collection(db, "student_histories"), {
                    schoolId: currentSchoolId, studentId: id, type: type === 'Transferred Out' ? 'transfer_out' : 'transfer',
                    fromData: { classId: prev.classId, streamId: prev.streamId }, toData: { classId, streamId, destinationSchool: destSchool },
                    notes: reason, date: (date ? new Date(date) : new Date()).toISOString(),
                    byUser: currentUserData ? currentUserData.email : ''
                });
                } catch (err) { showToast(getFriendlyErrorMessage(err), "error"); }
        };

        // --- Promotion ---
        window.openPromoteModal = () => {
            if (!currentProfileStudentId) return showToast("Open a student profile first", "warning");
            document.getElementById('promote-student-id').value = currentProfileStudentId;
            document.getElementById('promote-class').innerHTML = '<option value="">Select destination grade</option>' +
                Object.entries(window.__opsClassMap || {}).map(([id, name]) => `<option value="${id}">${name}</option>`).join('');
            populateAcademicYearSelect(document.getElementById('promote-year'), currentAcademicYear);
            populateStreamSelect(document.getElementById('promote-stream'), '', '');
            openModal('modal-promote');
        };

        window.confirmPromote = async (e) => {
            e.preventDefault();
            if (!hasPerm('students', 'promote') && currentUserRole !== 'admin') return showToast("Permission denied", "error");
            const id = document.getElementById('promote-student-id').value;
            const destClass = document.getElementById('promote-class').value;
            const destStream = document.getElementById('promote-stream').value;
            const year = parseInt(document.getElementById('promote-year').value) || currentAcademicYear;
            if (!destClass) return showToast("Select a destination grade", "error");
            try {
                const own = await getScopedDoc("students", id);
                if (!own) return showToast("Record not found in your school", "error");
                const histSnap = await getDocs(query(collection(db, "student_histories"), where("schoolId", "==", currentSchoolId), where("studentId", "==", id), where("type", "==", "promotion")));
                const already = histSnap.docs.find(d => { const t = d.data().toData || {}; return (t.year || d.data().year) == year; });
                if (already) { showToast("This student was already promoted for " + year, "error"); return; }
                const prev = own.data;
                await updateDoc(doc(db, "students", id), { classId: destClass, streamId: destStream, academicYear: year, updatedAt: new Date().toISOString() });
                await addDoc(collection(db, "student_histories"), {
                    schoolId: currentSchoolId, studentId: id, type: 'promotion',
                    fromData: { classId: prev.classId, streamId: prev.streamId, year: prev.academicYear },
                    toData: { classId: destClass, streamId: destStream, year },
                    notes: 'Promoted to ' + ((window.__opsClassMap || {})[destClass] || destClass),
                    date: new Date().toISOString(),
                    byUser: currentUserData ? currentUserData.email : ''
                });
                logAudit('students', 'promote', id, JSON.stringify(prev.classId), JSON.stringify(destClass) + ' / ' + year);
                closeModal('modal-promote');
                showToast("Student promoted successfully", "success");
            } catch (err) { showToast(getFriendlyErrorMessage(err), "error"); }
        };

        // --- Bulk Student Import (CSV) ---
        function parseSimpleCsv(text) {
            const rows = []; let row = [], field = '', inQ = false;
            for (let i = 0; i < text.length; i++) {
                const ch = i === 0 && text[i] === '\uFEFF' ? '' : text[i];
                if (ch === '"') { if (inQ && text[i+1] === '"') { field += '"'; i++; } else inQ = !inQ; }
                else if (ch === ',' && !inQ) { row.push(field); field = ''; }
                else if ((ch === '\n' || ch === '\r') && !inQ) {
                    if (text[i] === '\r' && text[i+1] === '\n') i++;
                    row.push(field); field = '';
                    if (row.some ? row.some(v => v !== '') : true) rows.push(row.map(x=>x.trim()));
                    row = [];
                } else field += ch;
            }
            if (field !== '' || row.length) { row.push(field); if (row.some(v => v !== '')) rows.push(row.map(x=>x.trim())); }
            return rows;
        }

        window.downloadStudentTemplate = () => {
            const head = ['FirstName','MiddleName','LastName','Gender','DateOfBirth','AdmissionNo','Class','Stream','AcademicYear','Status','GuardianPhone'];
            downloadCSV('Student_Import_Template.csv', [head]);
        };

        window.parseStudentImport = (input) => {
            const file = input.files ? input.files[0] : null;
            if (!file) return;
            if (!hasPerm('students', 'import') && currentUserRole !== 'admin') { showToast("Permission denied", "error"); return; }
            const reader = new FileReader();
            reader.readAsText(file).then(text => {
                pendingImportStudents = { valid: [], errors: [] };
                validateImportCsv(text);
                renderImportPreview();
            }).catch(err => showToast("Could not read file: " + err.message, "error"));
        };

        function validateImportCsv(text) {
            const rows = parseSimpleCsv(text);
            pendingImportStudents = { valid: [], errors: [] };
            if (rows.length < 2) { pendingImportStudents.errors.push({ line: 0, msg: 'No data rows found in the file.' }); return; }
            const header = rows[0].map(h => String(h || '').toLowerCase().replace(/\s+/g, ''));
            const idx = (name) => header.indexOf(name.toLowerCase());
            const ci = {
                first: idx('firstname'), middle: idx('middlename'), last: idx('lastname'),
                gender: idx('gender'), dob: idx('dateofbirth'), adm: idx('admissionno'),
                cls: idx('class'), stream: idx('stream'), year: idx('academicyear'),
                status: idx('status'), phone: idx('guardianphone')
            };
            const classMap = {};
            Object.entries(window.__opsClassMap || {}).forEach(([id, name]) => {
                classMap[id.toLowerCase()] = id; classMap[String(name || '').toLowerCase()] = id;
            });
            const streamMap = {};
            allStreams.forEach(s => { streamMap[String(s.name || '').toLowerCase()] = s; });
            const seenAdm = new Set(allStudents.map(s => String(s.admissionNo || s.studentId || '').toLowerCase()));
            const seenRows = new Set();
            rows.slice(1).filter(r => r.some(c => String(c || '').trim() !== '')).forEach((r, ri) => {
                const line = ri + 2;
                const get = (k) => (ci[k] || -1) >= 0 ? String(r[ci[k]] || '').trim() : '';
                const first = get('first'), middle = get('middle'), last = get('last');
                if (!(first || last)) { pendingImportStudents.errors.push({ line, msg: 'FirstName / LastName is required' }); return; }
                const clsName = get('cls');
                let classId = '';
                if (clsName) {
                    classId = classMap[clsName.toLowerCase()] || '';
                    if (!classId) { pendingImportStudents.errors.push({ line, msg: 'Class "' + clsName + '" does not exist in this school' }); return; }
                }
                const streamName = get('stream');
                let streamId = '';
                if (streamName) {
                    const st = streamMap[streamName.toLowerCase()];
                    if (!st) { pendingImportStudents.errors.push({ line, msg: 'Stream "' + streamName + '" does not exist' }); return; }
                    if (classId && st.classId && st.classId !== classId) { pendingImportStudents.errors.push({ line, msg: 'Stream "' + streamName + '" does not belong to the selected class' }); return; }
                    streamId = st.id;
                }
                let adm = get('adm');
                if (!adm) adm = nextAdmissionNo();
                const admKey = adm.toLowerCase();
                if (seenRows.has(admKey)) { pendingImportStudents.errors.push({ line, msg: 'Duplicate admission number "' + adm + '" in this file' }); return; }
                if (seenAdm.has(admKey)) { pendingImportStudents.errors.push({ line, msg: 'Admission number "' + adm + '" already exists in this school' }); return; }
                seenRows.add(admKey); seenAdm.add(admKey);
                pendingImportStudents.valid.push({
                    name: [first, middle, last].filter(Boolean).join(' '),
                    firstName: first, middleName: middle, lastName: last,
                    gender: get('gender'), dob: get('dob'), admissionNo: adm,
                    classId, streamId,
                    academicYear: parseInt(get('year')) || currentAcademicYear,
                    status: get('status') || 'Active', phone: get('phone')
                });
            });
        }

        function renderImportPreview() {
            const box = document.getElementById('ops-import-result');
            if (!box) return;
            const valid = pendingImportStudents.valid || [];
            const errors = pendingImportStudents.errors || [];
            let html = '';
            if (errors.length) {
                html += '<div style="background:#fceaea; border:1px solid var(--danger); border-radius:8px; padding:10px; margin:8px 0;"><b style="color:var(--danger);">' + errors.length + ' row(s) failed validation:</b><br>' +
                    errors.slice(0, 10).map(e => '<span style="font-size:0.78rem;">Row ' + e.line + ': ' + e.msg + '</span>').join('<br>') +
                    (errors.length > 10 ? '<br>...and ' + (errors.length - 10) + ' more' : '') + '</div>';
            }
            if (valid.length) {
                html += '<div style="border:1px solid var(--success); background:#d4f8e2; border-radius:8px; padding:10px; margin:8px 0; color:#1e7e34;"><b>' + valid.length + ' valid row(s)</b> ready to import.</div>';
            } else if (!errors.length) {
                html += '<p class="text-muted">No valid rows found.</p>';
            }
            box.classList.remove('hidden');
            box.innerHTML = html || '<p class="text-muted">No rows parsed.</p>';
            const btn = document.getElementById('ops-import-confirm');
            if (btn) { btn.style.display = valid.length ? 'flex' : 'none'; btn.innerText = 'Confirm Import (' + valid.length + ')'; }
        }

        window.confirmStudentImport = async () => {
            if (!hasPerm('students', 'import') && currentUserRole !== 'admin') return showToast("Permission denied", "error");
            const valid = pendingImportStudents.valid || [];
            if (!valid.length) return showToast("Nothing to import", "warning");
            if (!confirm("Import " + valid.length + " student(s)?")) return;
            showLoader(true);
            let created = 0;
            try {
                for (const v of valid) {
                    const avatar = 'https://ui-avatars.com/api/?background=800000&color=fff&name=' + encodeURIComponent([v.firstName, v.lastName].filter(Boolean).join(' ') || v.name);
                    await addDoc(collection(db, "students"), {
                        schoolId: currentSchoolId,
                        name: v.name, firstName: v.firstName, middleName: v.middleName, lastName: v.lastName,
                        gender: v.gender, dob: v.dob,
                        admissionNo: v.admissionNo, studentId: v.admissionNo,
                        classId: v.classId, streamId: v.streamId,
                        academicYear: v.academicYear, status: v.status,
                        parentContact: v.phone, admissionDate: new Date().toISOString().slice(0, 10),
                        photoUrl: avatar, updatedAt: new Date().toISOString()
                    });
                    created++;
                }
                await addDoc(collection(db, "student_histories"), {
                    schoolId: currentSchoolId, type: 'import',
                    notes: 'Bulk import of ' + created + ' student(s)', date: new Date().toISOString()
                });
                logAudit('students', 'import', 'bulk', '', 'Imported ' + created);
                closeModal('modal-student-import');
                showToast(created + " students imported successfully", "success");
            } catch (err) { showToast(getFriendlyErrorMessage(err), "error"); }
            finally { showLoader(false); pendingImportStudents = { valid: [], errors: [] }; }
        };

        // --- Academic Years ---
        function renderAcademicYears() {
            const tbody = document.getElementById('academic-year-list-body');
            if (!tbody) return;
            tbody.innerHTML = '';
            if (!allAcademicYears.length) { tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; color:var(--text-muted);">No academic years yet. Add one to get started.</td></tr>'; return; }
            [...allAcademicYears].sort((a, b) => String(b.name).localeCompare(String(a.name))).forEach(y => {
                const isArch = y.status === 'Archived';
                tbody.innerHTML += `<tr>
                        <td><b>${y.name}</b></td>
                        <td>${y.startDate || '-'}</td>
                        <td>${y.endDate || '-'}</td>
                        <td>${isArch ? '<span class="badge badge-inactive">Archived</span>' : '<span class="badge badge-active">Active</span>'}</td>
                        <td>${y.active ? '<span class="badge badge-success">Current</span>' : ''}</td>
                        <td style="white-space:nowrap;">
                            ${y.active ? '' : '<i class="fas fa-check-circle" style="color:var(--success); cursor:pointer; margin-right:10px;" title="Set Active" onclick="activateAcademicYear(\'' + y.id + '\')"></i>'}
                            <i class="fas fa-edit" style="color:var(--primary); cursor:pointer; margin-right:10px;" onclick="openAcademicYearModal('${y.id}')"></i>
                            ${isArch ? '' : '<i class="fas fa-archive" style="color:var(--warning); cursor:pointer;" title="Archive" onclick="archiveAcademicYear(\'' + y.id + '\')"></i>'}
                        </td>
                    </tr>`;
            });
        }

        window.openAcademicYearModal = (id) => {
            if (!hasPerm('academics', 'academic_year.manage') && currentUserRole !== 'admin') return showToast("Permission denied", "error");
            document.getElementById('ay-edit-id').value = id || '';
            document.getElementById('academic-year-modal-title').innerText = id ? 'Edit Academic Year' : 'Add Academic Year';
            if (id) {
                const y = allAcademicYears.find(a => a.id === id);
                if (!y) return showToast("Academic year not found", "error");
                document.getElementById('ay-name').value = y.name || '';
                document.getElementById('ay-start').value = y.startDate || '';
                document.getElementById('ay-end').value = y.endDate || '';
                document.getElementById('ay-status').value = y.status === 'Archived' ? 'Archived' : 'Active';
                document.getElementById('ay-active').checked = !!y.active;
            } else {
                document.getElementById('ay-name').value = String(currentAcademicYear + 1);
                document.getElementById('ay-start').value = '';
                document.getElementById('ay-end').value = '';
                document.getElementById('ay-status').value = 'Active';
                document.getElementById('ay-active').checked = true;
            }
            openModal('modal-academic-year');
        };

        window.saveAcademicYear = async (e) => {
            e.preventDefault();
            if (!hasPerm('academics', 'academic_year.manage') && currentUserRole !== 'admin') return showToast("Permission denied", "error");
            const id = document.getElementById('ay-edit-id').value;
            const name = document.getElementById('ay-name').value.trim();
            if (!name) return showToast("Year is required", "error");
            const active = document.getElementById('ay-active').checked;
            const isArch = document.getElementById('ay-status').value === 'Archived';
            const data = {
                schoolId: currentSchoolId, name,
                startDate: document.getElementById('ay-start').value,
                endDate: document.getElementById('ay-end').value,
                status: isArch ? 'Archived' : 'Active',
                active: !!active && !isArch,
                updatedAt: new Date().toISOString()
            };
            try {
                if (data.active) {
                    const snap = await getDocs(query(collection(db, "academic_years"), where("schoolId", "==", currentSchoolId), where("active", "==", true)));
                    const jobs = snap.docs.filter(d => d.id !== id).map(d => updateDoc(doc(db, "academic_years", d.id), { active: false }));
                    await Promise.all(jobs);
                }
                if (id) {
                    const own = await getScopedDoc("academic_years", id);
                    if (!own) return showToast("Record not found in your school", "error");
                    await updateDoc(doc(db, "academic_years", id), data);
                } else {
                    const snap = await getDocs(query(collection(db, "academic_years"), where("schoolId", "==", currentSchoolId), where("name", "==", name)));
                    if (snap.size) return showToast("This academic year already exists", "error");
                    await addDoc(collection(db, "academic_years"), data);
                }
                logAudit('academics', 'academic_year_save', id || name, '', name);
                closeModal('modal-academic-year');
                showToast("Academic year saved", "success");
            } catch (err) { showToast(getFriendlyErrorMessage(err), "error"); }
        };

        window.activateAcademicYear = async (id) => {
            if (!hasPerm('academics', 'academic_year.manage') && currentUserRole !== 'admin') return showToast("Permission denied", "error");
            try {
                const snap = await getDocs(query(collection(db, "academic_years"), where("schoolId", "==", currentSchoolId), where("active", "==", true)));
                const jobs = snap.docs.filter(d => d.id !== id).map(d => updateDoc(doc(db, "academic_years", d.id), { active: false }));
                await Promise.all(jobs);
                await updateDoc(doc(db, "academic_years", id), { active: true, status: 'Active' });
                logAudit('academics', 'academic_year_activate', id, '', 'true');
                showToast("Academic year activated", "success");
            } catch (err) { showToast(getFriendlyErrorMessage(err), "error"); }
        };

        window.archiveAcademicYear = async (id) => {
            if (!hasPerm('academics', 'academic_year.manage') && currentUserRole !== 'admin') return showToast("Permission denied", "error");
            if (!confirm("Archive this academic year? Records linked to it stay in the database.")) return;
            try {
                await updateDoc(doc(db, "academic_years", id), { status: 'Archived', active: false });
                logAudit('academics', 'academic_year_archive', id, 'Active', 'Archived');
                showToast("Academic year archived", "success");
            } catch (err) { showToast(getFriendlyErrorMessage(err), "error"); }
        };

        // --- Streams ---
        function renderStreams() {
            const tbody = document.getElementById('stream-list-body');
            if (!tbody) return;
            const classMap = window.__opsClassMap || {};
            tbody.innerHTML = '';
            if (!allStreams.length) { tbody.innerHTML = '<tr><td colspan="7" style="text-align:center; color:var(--text-muted);">No streams yet. Add one to group students within a grade.</td></tr>'; return; }
            allStreams.forEach(s => {
                const students = allStudents.filter(x => x.streamId === s.id).length;
                tbody.innerHTML += `<tr>
                        <td><b>${s.name}</b></td>
                        <td>${classMap[s.classId] || 'Unassigned'}</td>
                        <td>${s.classTeacherName || '-'}</td>
                        <td>${s.capacity || '-'}</td>
                        <td><span class="badge badge-active">${students}</span></td>
                        <td>${s.archived ? '<span class="badge badge-inactive">Yes</span>' : '<span class="badge badge-success">No</span>'}</td>
                        <td style="white-space:nowrap;">
                            <i class="fas fa-edit" style="color:var(--primary); cursor:pointer; margin-right:10px;" onclick="openStreamModal('${s.id}')"></i>
                            ${s.archived ? '' : '<i class="fas fa-archive" style="color:var(--warning); cursor:pointer;" title="Archive" onclick="archiveStream(\'' + s.id + '\')"></i>'}
                        </td>
                    </tr>`;
            });
        }

        window.openStreamModal = (id) => {
            if (!hasPerm('academics', 'streams.manage') && currentUserRole !== 'admin') return showToast("Permission denied", "error");
            const classSel = document.getElementById('stream-class');
            if (classSel) classSel.innerHTML = '<option value="">Select grade</option>' +
                Object.entries(window.__opsClassMap || {}).map(([cid, name]) => `<option value="${cid}">${name}</option>`).join('');
            const teachSel = document.getElementById('stream-teacher');
            if (teachSel) teachSel.innerHTML = '<option value="">None</option>' +
                (allTeachers || []).map(t => `<option value="${t.id}">${t.name}</option>`).join('');
            document.getElementById('stream-edit-id').value = id || '';
            if (id) {
                const s = allStreams.find(x => x.id === id);
                if (!s) return showToast("Stream not found", "error");
                document.getElementById('stream-name').value = s.name || '';
                if (classSel) classSel.value = s.classId || '';
                if (teachSel) teachSel.value = s.classTeacherId || '';
                document.getElementById('stream-capacity').value = s.capacity || 40;
                document.getElementById('stream-archived').value = s.archived ? 'true' : 'false';
            } else {
                document.getElementById('stream-name').value = '';
                if (classSel) classSel.value = '';
                document.getElementById('stream-capacity').value = 40;
                document.getElementById('stream-archived').value = 'false';
            }
            openModal('modal-stream');
        };
        window.saveStream = async (e) => {
            e.preventDefault();
            if (!hasPerm('academics', 'streams.manage') && currentUserRole !== 'admin') return showToast("Permission denied", "error");
            const id = document.getElementById('stream-edit-id').value;
            const name = document.getElementById('stream-name').value.trim();
            if (!name) return showToast("Stream name is required", "error");
            const capacity = parseInt(document.getElementById('stream-capacity').value) || 40;
            const classId = document.getElementById('stream-class').value;
            const classTeacherId = document.getElementById('stream-teacher').value;
            const archived = document.getElementById('stream-archived').value === 'true';
            const data = {
                schoolId: currentSchoolId,
                name,
                capacity,
                classId,
                classTeacherId,
                archived,
                updatedAt: new Date().toISOString()
            };
            try {
                if (id) {
                    const own = await getScopedDoc('streams', id);
                    if (!own) return showToast("Record not found in your school", "error");
                    await updateDoc(doc(db, 'streams', id), data);
                } else {
                    await addDoc(collection(db, 'streams'), data);
                }
                logAudit('academics', 'stream_save', id || name, '', JSON.stringify({ name, capacity }));
                closeModal('modal-stream');
                showToast("Stream saved", "success");
            } catch (err) { showToast(getFriendlyErrorMessage(err), "error"); }
        };

        window.archiveStream = async (id) => {
            if (!confirm("Archive this stream?")) return;
            try {
                await updateDoc(doc(db, 'streams', id), { archived: true });
                logAudit('academics', 'stream_archive', id, 'false', 'true');
                showToast("Stream archived", "success");
            } catch (err) { showToast(getFriendlyErrorMessage(err), "error"); }
        };



        // --- Terms ---
        function renderTerms() {
            const tbody = document.getElementById('term-list-body');
            if (!tbody) return;
            tbody.innerHTML = '';
            if (!allTerms.length) { tbody.innerHTML = '<tr><td colspan="7" style="text-align:center; color:var(--text-muted);">No terms configured. Add one to get started.</td></tr>'; return; }
            [...allTerms].sort((a, b) => String(a.academicYear || '').localeCompare(String(b.academicYear || '')) || String(a.name || '').localeCompare(String(b.name || ''))).forEach(t => {
                const isArch = t.status === 'Archived';
                tbody.innerHTML += `<tr>
                        <td><b>${t.name}</b></td>
                        <td>${t.academicYear || '-'}</td>
                        <td>${t.startDate || '-'}</td>
                        <td>${t.endDate || '-'}</td>
                        <td>${isArch ? '<span class="badge badge-inactive">Archived</span>' : '<span class="badge badge-active">Open</span>'}</td>
                        <td>${t.active ? '<span class="badge badge-success">Current</span>' : ''}</td>
                        <td style="white-space:nowrap;">
                            ${t.active ? '' : '<i class="fas fa-check-circle" style="color:var(--success); cursor:pointer; margin-right:10px;" title="Set Active" onclick="activateTerm(\'' + t.id + '\')"></i>'}
                            <i class="fas fa-edit" style="color:var(--primary); cursor:pointer; margin-right:10px;" onclick="openTermModal('${t.id}')"></i>
                            ${isArch ? '' : '<i class="fas fa-archive" style="color:var(--warning); cursor:pointer;" title="Archive" onclick="archiveTerm(\'' + t.id + '\')"></i>'}
                        </td>
                    </tr>`;
            });
        }

        window.openTermModal = (id) => {
            if (!hasPerm('academics', 'terms.manage') && currentUserRole !== 'admin') return showToast("Permission denied", "error");
            const yearSel = document.getElementById('term-year');
            if (yearSel) yearSel.innerHTML = allAcademicYears.length
                ? allAcademicYears.map(y => `<option value="${y.name}">${y.name}</option>`).join('')
                : `<option value="${currentAcademicYear}">${currentAcademicYear}</option>`;
            document.getElementById('term-edit-id').value = id || '';
            if (id) {
                const t = allTerms.find(x => x.id === id);
                if (!t) return showToast("Term not found", "error");
                document.getElementById('term-name').value = t.name || '';
                if (yearSel) yearSel.value = t.academicYear || currentAcademicYear;
                document.getElementById('term-start').value = t.startDate || '';
                document.getElementById('term-end').value = t.endDate || '';
                document.getElementById('term-active').checked = !!t.active;
            } else {
                document.getElementById('term-name').value = '';
                if (yearSel) yearSel.value = currentAcademicYear;
                document.getElementById('term-start').value = '';
                document.getElementById('term-end').value = '';
                document.getElementById('term-active').checked = true;
            }
            openModal('modal-term');
        };

        window.saveTerm = async (e) => {
            e.preventDefault();
            if (!hasPerm('academics', 'terms.manage') && currentUserRole !== 'admin') return showToast("Permission denied", "error");
            const id = document.getElementById('term-edit-id').value;
            const name = document.getElementById('term-name').value.trim();
            if (!name) return showToast("Term name is required", "error");
            const active = document.getElementById('term-active').checked;
            const data = {
                schoolId: currentSchoolId, name,
                academicYear: document.getElementById('term-year').value || String(currentAcademicYear),
                startDate: document.getElementById('term-start').value,
                endDate: document.getElementById('term-end').value,
                active: !!active, status: 'Open',
                updatedAt: new Date().toISOString()
            };
            try {
                if (data.active) {
                    const snap = await getDocs(query(collection(db, "terms"), where("schoolId", "==", currentSchoolId), where("active", "==", true)));
                    const jobs = snap.docs.filter(d => d.id !== id).map(d => updateDoc(doc(db, "terms", d.id), { active: false }));
                    await Promise.all(jobs);
                }
                if (id) {
                    const own = await getScopedDoc("terms", id);
                    if (!own) return showToast("Record not found in your school", "error");
                    await updateDoc(doc(db, "terms", id), data);
                } else {
                    const snap = await getDocs(query(collection(db, "terms"), where("schoolId", "==", currentSchoolId), where("name", "==", data.name), where("academicYear", "==", data.academicYear)));
                    if (snap.size) return showToast("This term already exists for the selected year", "error");
                    await addDoc(collection(db, "terms"), data);
                }
                logAudit('academics', 'term_save', id || data.name, '', JSON.stringify({ name: data.name, year: data.academicYear }));
                closeModal('modal-term');
                showToast("Term saved", "success");
            } catch (err) { showToast(getFriendlyErrorMessage(err), "error"); }
        };

        // --- School-scoped realtime caches for the ops module ---
        async function initOpsListeners() {
            try {
                if (currentUserData && currentUserData.email) {
                    const me = await getDoc(doc(db, 'school_admins', currentUserData.email));
                    if (me.exists()) {
                        const d = me.data();
                        currentUserPermissions = d.permissions || null;
                        if (d.role) currentUserRole = d.role;
                        const last = d.lastLogin ? new Date(d.lastLogin).getTime() : 0;
                        if (Date.now() - last > 3600000) {
                            updateDoc(doc(db, 'school_admins', currentUserData.email), { lastLogin: new Date().toISOString() }).catch(() => {});
                        }
                    }
                }
            } catch (e) { /* keep defaults */ }
            applyOpsPermissions();

            onSnapshot(query(collection(db, 'school_admins'), where('schoolId', '==', currentSchoolId)), snap => {
                allSchoolAdmins = snap.docs.map(d => ({ email: d.id, ...d.data() }));
                renderSchoolAdmins();
                populateRoleAdmins();
            });

            onSnapshot(query(collection(db, 'academic_years'), where('schoolId', '==', currentSchoolId)), snap => {
                allAcademicYears = snap.docs.map(d => ({ id: d.id, ...d.data() }));
                renderAcademicYears();
                const sel = document.getElementById('student-academic-year');
                if (sel) populateAcademicYearSelect(sel, sel.value || currentAcademicYear);
            });

            onSnapshot(query(collection(db, 'terms'), where('schoolId', '==', currentSchoolId)), snap => {
                allTerms = snap.docs.map(d => ({ id: d.id, ...d.data() }));
                renderTerms();
                const activeTerm = allTerms.find(t => t.active) || allTerms[0];
                if (activeTerm) { currentTerm = activeTerm.name; currentAcademicYear = parseInt(activeTerm.academicYear) || currentAcademicYear; }
            });

            onSnapshot(query(collection(db, 'streams'), where('schoolId', '==', currentSchoolId)), snap => {
                allStreams = snap.docs.map(d => ({ id: d.id, ...d.data() }));
                const streamMap = {}; allStreams.forEach(s => streamMap[s.id] = s.name);
                window.__opsStreamMap = streamMap;
                renderStreams();
                ['student-stream', 'transfer-stream', 'promote-stream', 'tassign-stream'].forEach(id => {
                    const el = document.getElementById(id);
                    if (el) populateStreamSelect(el, el.value || '', '');
                });
                renderStudentList();
            });

            onSnapshot(query(collection(db, 'subjects'), where('schoolId', '==', currentSchoolId)), snap => {
                allSubjects = snap.docs.map(d => ({ id: d.id, ...d.data() }));
                renderSubjects();
            });

            onSnapshot(query(collection(db, 'teacher_assignments'), where('schoolId', '==', currentSchoolId)), snap => {
                allTeacherAssignments = snap.docs.map(d => ({ id: d.id, ...d.data() }));
                renderTeacherAssignments();
            });

            if (hasPerm('admin', 'audit')) {
                onSnapshot(query(collection(db, 'audit_logs'), where('schoolId', '==', currentSchoolId)), snap => {
                    window.__allAuditLogs = snap.docs.map(d => ({ id: d.id, ...d.data() }));
                    renderAuditLogs();
                });
            }
        }

        // Permission-aware sidebar (hide modules the user cannot access AND
        // modules not enabled for this school).
        function applyOpsPermissions() {
            // Map each sidebar view to the school module key that controls whether
            // it is enabled for this school. Views NOT listed here — dashboard,
            // school-admins, roles, audit, settings — are structural/administrative
            // and are always shown (still subject to the role checks below).
            const viewToModule = {
                students: 'students',
                teachers: 'teachers',
                classes: 'classes',
                attendance: 'attendance',
                exams: 'exams',
                fees: 'fees',
                'fee-structures': 'fees',
                'fee-summary': 'fees',
                library: 'library',
                transport: 'transport',
                hostel: 'hostel',
                inventory: 'inventory',
                timetable: 'classes',
                'academic-structure': 'classes',
                streams: 'classes',
                subjects: 'classes',
                'teacher-assignments': 'classes'
            };
            const DEFAULT_MODULES = ['students', 'teachers', 'classes', 'attendance', 'exams', 'fees'];
            const enabledModules = (schoolSettings && Array.isArray(schoolSettings.enabledModules)
                && schoolSettings.enabledModules.length)
                ? schoolSettings.enabledModules
                : DEFAULT_MODULES;

            const menuMap = {
                'fees': () => hasPerm('fees', 'view'),
                'fee-structures': () => hasPerm('fees', 'view') || hasPerm('fees', 'manage'),
                'students': () => hasPerm('students', 'view'),
                'teachers': () => hasPerm('staff', 'view'),
                'academic-structure': () => hasPerm('academics', 'view') || currentUserRole === 'admin',
                'streams': () => hasPerm('academics', 'view') || currentUserRole === 'admin',
                'subjects': () => hasPerm('academics', 'view') || currentUserRole === 'admin',
                'teacher-assignments': () => hasPerm('academics', 'view') || currentUserRole === 'admin',
                'school-admins': () => hasPerm('admin', 'manage_admins'),
                'roles': () => hasPerm('admin', 'permissions'),
                'audit': () => hasPerm('admin', 'audit'),
                'settings': () => currentUserRole === 'admin'
            };

            const redirectAway = (item) => {
                if (item.classList.contains('active')) {
                    const dash = document.querySelector('.menu-item[data-view="dashboard"]');
                    if (dash) dash.click();
                }
            };

            document.querySelectorAll('.menu-item').forEach(item => {
                const view = item.getAttribute('data-view');

                // Hide the view when its module is not enabled for this school.
                const moduleKey = viewToModule[view];
                if (moduleKey && !enabledModules.includes(moduleKey)) {
                    item.classList.add('hidden');
                    redirectAway(item);
                    return;
                }

                const check = menuMap[view];
                if (!check) return;
                if (check()) {
                    item.classList.remove('hidden');
                } else {
                    item.classList.add('hidden');
                    redirectAway(item);
                }
            });
            if (currentUserRole === 'teacher') {
                ['settings', 'school-admins', 'roles', 'audit', 'fees', 'fee-structures', 'library', 'transport', 'hostel', 'inventory'].forEach(v => {
                    const el = document.querySelector('.menu-item[data-view="' + v + '"]');
                    if (el) el.classList.add('hidden');
                });
            }
        }

        window.activateTerm = async (id) => {
            if (!hasPerm('academics', 'terms.manage') && currentUserRole !== 'admin') return showToast("Permission denied", "error");
            try {
                const snap = await getDocs(query(collection(db, "terms"), where("schoolId", "==", currentSchoolId), where("active", "==", true)));
                const jobs = snap.docs.filter(d => d.id !== id).map(d => updateDoc(doc(db, "terms", d.id), { active: false }));
                await Promise.all(jobs);
                await updateDoc(doc(db, "terms", id), { active: true, status: 'Open' });
                const t = allTerms.find(x => x.id === id);
                if (t) currentTerm = t.name || currentTerm;
                logAudit('academics', 'term_activate', id, '', 'true');
                showToast("Term activated", "success");
            } catch (err) { showToast(getFriendlyErrorMessage(err), "error"); }
        };

        window.archiveTerm = async (id) => {
            if (!hasPerm('academics', 'terms.manage') && currentUserRole !== 'admin') return showToast("Permission denied", "error");
            if (!confirm("Archive this term active? Its records stay in the database.")) return;
            try {
                await updateDoc(doc(db, "terms", id), { status: 'Archived', active: false });
                logAudit('academics', 'term_archive', id, 'Open', 'Archived');
                showToast("Term archived", "success");
            } catch (err) { showToast(getFriendlyErrorMessage(err), "error"); }
        };

        // --- Subjects ---
        function renderSubjects() {
            const tbody = document.getElementById('subject-list-body');
            if (!tbody) return;
            const classMap = window.__opsClassMap || {};
            tbody.innerHTML = '';
            if (!allSubjects.length) { tbody.innerHTML = '<tr><td colspan="5" style="text-align:center; color:var(--text-muted);">No subjects configured. Add subjects/learning areas for your school.</td></tr>'; return; }
            allSubjects.forEach(s => {
                const grades = (s.applicableClassIds || []).map(id => classMap[id] || id).join(', ') || 'All grades';
                tbody.innerHTML += `<tr>
                        <td><b>${s.name}</b></td>
                        <td>${s.code || '-'}</td>
                        <td>${grades}</td>
                        <td>${s.active === false ? '<span class="badge badge-inactive">Inactive</span>' : '<span class="badge badge-success">Active</span>'}</td>
                        <td style="white-space:nowrap;">
                            <i class="fas fa-edit" style="color:var(--primary); cursor:pointer; margin-right:10px;" onclick="openSubjectModal('${s.id}')"></i>
                            <i class="fas fa-trash" style="color:var(--danger); cursor:pointer;" onclick="deleteSubject('${s.id}')"></i>
                        </td>
                    </tr>`;
            });
        }

        window.openSubjectModal = (id) => {
            if (!hasPerm('academics', 'subjects.manage') && currentUserRole !== 'admin') return showToast("Permission denied", "error");
            populateClassMultiSelect('subject-classes', id ? (allSubjects.find(x => x.id === id) || {}).applicableClassIds : []);
            document.getElementById('subject-edit-id').value = id || '';
            if (id) {
                const s = allSubjects.find(x => x.id === id);
                if (!s) return showToast("Subject not found", "error");
                document.getElementById('subject-name').value = s.name || '';
                document.getElementById('subject-code').value = s.code || '';
                document.getElementById('subject-active').checked = s.active !== false;
            } else {
                document.getElementById('subject-name').value = '';
                document.getElementById('subject-code').value = '';
                document.getElementById('subject-active').checked = true;
            }
            openModal('modal-subject');
        };

        window.saveSubject = async (e) => {
            e.preventDefault();
            if (!hasPerm('academics', 'subjects.manage') && currentUserRole !== 'admin') return showToast("Permission denied", "error");
            const id = document.getElementById('subject-edit-id').value;
            const name = document.getElementById('subject-name').value.trim();
            if (!name) return showToast("Subject name is required", "error");
            const classesEl = document.getElementById('subject-classes');
            const applicableClassIds = Array.from(classesEl.selectedOptions || []).map(o => o.value);
            const data = {
                schoolId: currentSchoolId,
                name, code: document.getElementById('subject-code').value.trim(),
                applicableClassIds, active: document.getElementById('subject-active').checked,
                updatedAt: new Date().toISOString()
            };
            try {
                if (id) {
                    const own = await getScopedDoc("subjects", id);
                    if (!own) return showToast("Record not found in your school", "error");
                    await updateDoc(doc(db, "subjects", id), data);
                } else {
                    const snap = await getDocs(query(collection(db, "subjects"), where("schoolId", "==", currentSchoolId), where("name", "==", name)));
                    if (snap.size) return showToast("Subject already exists in this school", "error");
                    await addDoc(collection(db, "subjects"), data);
                }
                logAudit('academics', 'subject_save', id || name, '', name);
                closeModal('modal-subject');
                showToast("Subject saved", "success");
            } catch (err) { showToast(getFriendlyErrorMessage(err), "error"); }
        };

        window.deleteSubject = async (id) => {
            if (!hasPerm('academics', 'subjects.manage') && currentUserRole !== 'admin') return showToast("Permission denied", "error");
            if (!confirm("Delete this subject? Related historical results are kept.")) return;
            try {
                const own = await getScopedDoc("subjects", id);
                if (!own) return showToast("Record not found in your school", "error");
                await deleteDoc(doc(db, "subjects", id));
                logAudit('academics', 'subject_delete', id, '', 'deleted');
                showToast("Subject deleted", "success");
            } catch (err) { showToast(getFriendlyErrorMessage(err), "error"); }
        };

        // --- Teacher Assignments ---
        function renderTeacherAssignments() {
            const tbody = document.getElementById('teacher-assignment-list-body');
            if (!tbody) return;
            const classMap = window.__opsClassMap || {};
            const streamMap = {}; (allStreams || []).forEach(s => streamMap[s.id] = s.name);
            const teachMap = {}; (allTeachers || []).forEach(t => teachMap[t.id] = t.name);
            tbody.innerHTML = '';
            if (!allTeacherAssignments.length) { tbody.innerHTML = '<tr><td colspan="5" style="text-align:center; color:var(--text-muted);">No teacher assignments yet. Assign teachers to grades, streams and subjects.</td></tr>'; return; }
            allTeacherAssignments.forEach(a => {
                tbody.innerHTML += `<tr>
                        <td><b>${teachMap[a.teacherId] || 'Teacher'}</b></td>
                        <td>${classMap[a.classId] || 'Unassigned'}</td>
                        <td>${streamMap[a.streamId] || 'Any'}</td>
                        <td>${a.subject || '-'}</td>
                        <td style="white-space:nowrap;">
                            <i class="fas fa-edit" style="color:var(--primary); cursor:pointer; margin-right:10px;" onclick="openTeacherAssignmentModal('${a.id}')"></i>
                            <i class="fas fa-trash" style="color:var(--danger); cursor:pointer;" onclick="deleteTeacherAssignment('${a.id}')"></i>
                        </td>
                    </tr>`;
            });
        }

        window.openTeacherAssignmentModal = (id) => {
            if (!hasPerm('academics', 'teacher_assignments.manage') && currentUserRole !== 'admin') return showToast("Permission denied", "error");
            const tSel = document.getElementById('tassign-teacher');
            if (tSel) tSel.innerHTML = '<option value="">Select teacher</option>' +
                (allTeachers || []).map(t => `<option value="${t.id}">${t.name}</option>`).join('');
            const cSel = document.getElementById('tassign-class');
            if (cSel) cSel.innerHTML = '<option value="">Select grade</option>' +
                Object.entries(window.__opsClassMap || {}).map(([cid, name]) => `<option value="${cid}">${name}</option>`).join('');
            populateStreamSelect(document.getElementById('tassign-stream'), '', '');
            const sSel = document.getElementById('tassign-subject');
            if (sSel) sSel.innerHTML = '<option value="">Select subject</option>' +
                allSubjects.filter(x => x.active !== false).map(x => `<option value="${x.name}">${x.name}</option>`).join('') +
                '<option value="Class Teacher">Class Teacher</option>';
            document.getElementById('tassign-edit-id').value = id || '';
            if (id) {
                const a = allTeacherAssignments.find(x => x.id === id);
                if (!a) return showToast("Assignment not found", "error");
                if (tSel) tSel.value = a.teacherId || '';
                if (cSel) cSel.value = a.classId || '';
                const stSel = document.getElementById('tassign-stream');
                if (stSel) stSel.value = a.streamId || '';
                if (sSel) sSel.value = a.subject || '';
            }
            openModal('modal-teacher-assign');
        };

        window.saveTeacherAssignment = async (e) => {
            e.preventDefault();
            if (!hasPerm('academics', 'teacher_assignments.manage') && currentUserRole !== 'admin') return showToast("Permission denied", "error");
            const id = document.getElementById('tassign-edit-id').value;
            const teacherId = document.getElementById('tassign-teacher').value;
            const classId = document.getElementById('tassign-class').value;
            const streamId = document.getElementById('tassign-stream').value;
            const subject = document.getElementById('tassign-subject').value;
            if (!teacherId || !classId || !subject) return showToast("Teacher, grade and subject are required", "error");
            try {
                const data = { schoolId: currentSchoolId, teacherId, classId, streamId, subject, updatedAt: new Date().toISOString() };
                if (id) {
                    const own = await getScopedDoc("teacher_assignments", id);
                    if (!own) return showToast("Record not found in your school", "error");
                    await updateDoc(doc(db, "teacher_assignments", id), data);
                } else {
                    await addDoc(collection(db, "teacher_assignments"), data);
                }
                logAudit('staff', 'teacher_assignment_save', id || teacherId, '', JSON.stringify({ classId, streamId, subject }));
                closeModal('modal-teacher-assign');
                showToast("Assignment saved", "success");
            } catch (err) { showToast(getFriendlyErrorMessage(err), "error"); }
        };

        window.deleteTeacherAssignment = async (id) => {
            if (!hasPerm('academics', 'teacher_assignments.manage') && currentUserRole !== 'admin') return showToast("Permission denied", "error");
            if (!confirm("Remove this teacher assignment?")) return;
            try {
                const own = await getScopedDoc("teacher_assignments", id);
                if (!own) return showToast("Record not found in your school", "error");
                await deleteDoc(doc(db, "teacher_assignments", id));
                logAudit('academics', 'assignment_delete', id, '', 'removed');
                showToast("Assignment removed", "success");
            } catch (err) { showToast(getFriendlyErrorMessage(err), "error"); }
        };

        // --- School Admins (Owner self-service) ---
        function renderSchoolAdmins() {
            const tbody = document.getElementById('school-admin-list-body');
            if (!tbody) return;
            tbody.innerHTML = '';
            const me = (currentUserData && currentUserData.email);
            if (!allSchoolAdmins.length) { tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; color:var(--text-muted);">No administrators assigned to this school yet.</td></tr>'; return; }
            allSchoolAdmins.forEach(a => {
                const own = a.email === me;
                const act = own ? '<span class="text-muted" style="font-size:0.72rem;">(you)</span>' :
                    '<i class="fas fa-edit" style="color:var(--primary); cursor:pointer; margin-right:10px;" title="Edit" onclick="openAdminUserModal(\'' + a.email + '\')"></i>' +
                    (a.status === 'inactive'
                        ? '<i class="fas fa-user-check" style="color:var(--success); cursor:pointer; margin-right:10px;" title="Activate" onclick="setAdminUserStatus(\'' + a.email + '\', \'active\')"></i>'
                        : '<i class="fas fa-user-slash" style="color:var(--warning); cursor:pointer; margin-right:10px;" title="Deactivate" onclick="setAdminUserStatus(\'' + a.email + '\', \'inactive\')"></i>') +
                    '<i class="fas fa-trash" style="color:var(--danger); cursor:pointer;" title="Remove" onclick="removeAdminUser(\'' + a.email + '\')"></i>';
                tbody.innerHTML += `<tr>
                        <td><b>${a.email}</b>${a.isOwner ? ' <span class="badge badge-warning">Owner</span>' : ''}</td>
                        <td>${a.role || 'admin'}</td>
                        <td>${a.status === 'inactive' ? '<span class="badge badge-inactive">Inactive</span>' : '<span class="badge badge-success">Active</span>'}</td>
                        <td>${a.createdAt ? new Date(a.createdAt).toLocaleDateString() : '-'}</td>
                        <td>${a.lastLogin ? new Date(a.lastLogin).toLocaleString() : 'Never'}</td>
                        <td style="white-space:nowrap;">${act}</td>
                    </tr>`;
            });
        }

        window.openAdminUserModal = (email) => {
            if (!hasPerm('admin', 'manage_admins') && currentUserRole !== 'admin') return showToast("Permission denied", "error");
            const e = (allSchoolAdmins || []).find(a => a.email === email);
            document.getElementById('admuser-original-email').value = email || '';
            document.getElementById('admin-user-modal-title').innerText = email ? 'Edit School Administrator' : 'Add School Administrator';
            document.getElementById('admuser-email').value = e ? e.email : '';
            document.getElementById('admuser-email').readOnly = !!e;
            document.getElementById('admuser-role').value = e ? e.role || 'admin' : 'admin';
            document.getElementById('admuser-status').value = e ? e.status || 'active' : 'active';
            openModal('modal-admin-user');
        };

        window.saveAdminUser = async (ev) => {
            ev.preventDefault();
            if (!hasPerm('admin', 'manage_admins') && currentUserRole !== 'admin') return showToast("Permission denied", "error");
            const orig = document.getElementById('admuser-original-email').value;
            const email = document.getElementById('admuser-email').value.trim().toLowerCase();
            if (!email) return showToast("Email is required", "error");
            const role = document.getElementById('admuser-role').value;
            const status = document.getElementById('admuser-status').value;
            const existing = (allSchoolAdmins || []).find(a => a.email === (orig || email));
            const data = {
                schoolId: currentSchoolId, role, status,
                updatedAt: new Date().toISOString(),
                createdAt: existing && existing.createdAt ? existing.createdAt : new Date().toISOString(),
                isOwner: existing && existing.isOwner ? existing.isOwner : false
            };
            try {
                if (orig && orig !== email) {
                    const own = await getScopedDoc('school_admins', orig);
                    if (!own) return showToast("Record not found in your school", "error");
                    try { await deleteDoc(doc(db, 'school_admins', orig)); } catch (e2) {}
                }
                await setDoc(doc(db, 'school_admins', email), data);
                logAudit('admin', 'admin_user_save', email, orig || '', JSON.stringify({ role, status }));
                closeModal('modal-admin-user');
                showToast("Administrator saved", "success");
            } catch (err) { showToast(getFriendlyErrorMessage(err), "error"); }
        };

        window.setAdminUserStatus = async (email, status) => {
            if (!hasPerm('admin', 'manage_admins') && currentUserRole !== 'admin') return showToast("Permission denied", "error");
            try {
                const own = await getScopedDoc('school_admins', email);
                if (!own) return showToast("Record not found in your school", "error");
                if (currentUserData && currentUserData.email === email) return showToast("You cannot deactivate your own account", "warning");
                await updateDoc(doc(db, 'school_admins', email), { status, updatedAt: new Date().toISOString() });
                logAudit('admin', status === 'active' ? 'admin_activate' : 'admin_deactivate', email, status === 'active' ? 'inactive' : 'active', status);
                showToast(status === 'active' ? "Administrator activated" : "Administrator deactivated", "success");
            } catch (err) { showToast(getFriendlyErrorMessage(err), "error"); }
        };

        window.removeAdminUser = async (email) => {
            if (!hasPerm('admin', 'manage_admins') && currentUserRole !== 'admin') return showToast("Permission denied", "error");
            if (currentUserData && currentUserData.email === email) return showToast("You cannot remove your own account", "warning");
            if (!confirm("Remove " + email + " from this school?")) return;
            try {
                const own = await getScopedDoc('school_admins', email);
                if (!own) return showToast("Record not found in your school", "error");
                await deleteDoc(doc(db, 'school_admins', email));
                logAudit('admin', 'admin_remove', email, '', 'removed');
                showToast("Administrator removed", "success");
            } catch (err) { showToast(getFriendlyErrorMessage(err), "error"); }
        };

        // --- Roles & Permissions ---
        function populateRoleAdmins() {
            const sel = document.getElementById('role-admin-select');
            if (!sel) return;
            const cur = sel.value;
            sel.innerHTML = '<option value="">Select an administrator...</option>' +
                (allSchoolAdmins || []).map(a => `<option value="${a.email}" ${a.email === cur ? 'selected' : ''}>${a.email} (${a.role || 'admin'})</option>`).join('');
        }

        window.loadRolePermissions = async () => {
            const target = document.getElementById('role-admin-select').value;
            const editor = document.getElementById('permission-editor');
            if (!editor) return;
            if (!target) { editor.innerHTML = '<p class="text-muted" style="text-align:center;">Select an administrator to edit their permissions.</p>'; return; }
            const snap = await getDoc(doc(db, 'school_admins', target));
            if (!snap.exists()) { editor.innerHTML = '<p class="text-muted">Record not found.</p>'; return; }
            const perms = Object.assign({}, snap.data().permissions || {});
            roleEditorTarget = target;
            const isFull = perms.all === true;
            if (isFull) { Object.keys(PERMS).forEach(m => PERMS[m].forEach(p => perms[p.k] = true)); }
            let html = '<div class="form-group"><label style="font-weight:700;">Full access</label>' +
                '<label class="perm-check"><input type="checkbox" id="perm-all" ' + (isFull ? 'checked' : '') + '> Grant every module &amp; action to this user</label></div>';
            Object.entries(PERMS).forEach(([module, actions]) => {
                html += `<div class="card" style="padding:1rem; margin-bottom:0.8rem;">
                    <h5 style="margin:0 0 8px; text-transform:uppercase; font-size:0.75rem; letter-spacing:1px; color:var(--primary);">${module}</h5>
                    <div class="perm-grid">${actions.map(a => `<label class="perm-check"><input type="checkbox" class="perm-box" data-key="${a.k}" ${perms[a.k] === true ? 'checked' : ''}> ${a.label}</label>`).join('')}</div>
                </div>`;
            });
            html += '<button type="button" class="btn btn-primary" style="width:100%;" onclick="saveRolePermissions()"><i class="fas fa-save"></i> Save Permissions</button>';
            editor.innerHTML = html;
        };

        window.saveRolePermissions = async () => {
            if (!roleEditorTarget) return showToast("Select an administrator first", "warning");
            if (!hasPerm('admin', 'permissions') && currentUserRole !== 'admin') return showToast("Permission denied", "error");
            const email = roleEditorTarget;
            if (currentUserData && currentUserData.email === email && !(allSchoolAdmins.find(a => a.email === email) || {}).isOwner) {
                // allowed to change others; block changing your own full-access account only when it's the school owner record
                if ((allSchoolAdmins.find(a => a.email === email) || {}).isOwner) {
                    return showToast("The School Owner record keeps full access.", "warning");
                }
            }
            const allCheck = document.getElementById('perm-all');
            try {
                if (allCheck && allCheck.checked) {
                    await updateDoc(doc(db, 'school_admins', email), { permissions: { all: true }, updatedAt: new Date().toISOString() });
                } else {
                    const map = {};
                    document.querySelectorAll('.perm-box:checked').forEach(cb => map[cb.getAttribute('data-key')] = true);
                    await updateDoc(doc(db, 'school_admins', email), { permissions: map, updatedAt: new Date().toISOString() });
                }
                logAudit('admin', 'permissions_changed', email, '', 'permissions updated');
                showToast("Permissions updated", "success");
            } catch (err) { showToast(getFriendlyErrorMessage(err), "error"); }
        };

        // --- Audit Logs ---
        function renderAuditLogs() {
            const tbody = document.getElementById('audit-list-body');
            if (!tbody) return;
            tbody.innerHTML = '';
            const docs = window.__allAuditLogs || [];
            if (!docs.length) { tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; color:var(--text-muted);">No activity recorded yet.</td></tr>'; return; }
            [...docs].sort((a, b) => String(b.timestamp).localeCompare(String(a.timestamp))).slice(0, 100).forEach(a => {
                const detail = a.newValue ? (a.previousValue ? a.previousValue + ' &rarr; ' + a.newValue : String(a.newValue)) : (a.previousValue || '-');
                tbody.innerHTML += `<tr>
                        <td style="white-space:nowrap;">${a.timestamp ? new Date(a.timestamp).toLocaleString() : '-'}</td>
                        <td>${a.userName || a.userId || '-'}</td>
                        <td>${a.module || '-'}</td>
                        <td>${a.action || '-'}</td>
                        <td style="font-family:'Space Mono'; font-size:0.78rem;">${String(a.recordId || '-').slice(0, 40)}</td>
                        <td style="font-size:0.78rem;">${String(detail).slice(0, 90)}</td>
                    </tr>`;
            });
        }

        window.exportAuditCSV = () => {
            const docs = window.__allAuditLogs || [];
            const rows = [['Timestamp', 'User', 'Module', 'Action', 'Record', 'Details']];
            docs.forEach(a => rows.push([a.timestamp || '', a.userName || '', a.module || '', a.action || '', a.recordId || '', a.newValue || a.previousValue || '']));
            downloadCSV('Audit_Logs.csv', rows);
            showToast("Audit log exported", "success");
        };
    

