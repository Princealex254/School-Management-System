        window.saveBook = async (e) => {
            e.preventDefault();
            if (!canOp()) return showToast("Permissions: administrators only", "error");
            const id = document.getElementById('book-edit-id').value;
            const totalCopies = parseInt(document.getElementById('book-copies').value) || 1;
            const data = {
                schoolId: currentSchoolId,
                title: document.getElementById('book-title').value.trim(),
                author: document.getElementById('book-author').value.trim(),
                category: document.getElementById('book-category').value.trim(),
                totalCopies,
                shelf: document.getElementById('book-shelf').value.trim(),
                updatedAt: new Date().toISOString()
            };
            try {
                if (id) {
                    const prev = await getScopedDoc('books', id);
                    if(!prev) return showToast("Record not found in your school", "error");
                    const borrowed = (prev.data.totalCopies || 0) - (prev.data.availableCopies || 0);
                    data.availableCopies = Math.max(0, totalCopies - borrowed);
                    await updateDoc(doc(db, 'books', id), data);
                } else {
                    data.availableCopies = totalCopies;
                    await addDoc(collection(db, 'books'), data);
                }
                closeModal('modal-book');
                showToast("Book saved", "success");
            } catch (err) { showToast(getFriendlyErrorMessage(err), "error"); }
        };

        window.editBook = async (id) => {
            const own = await getScopedDoc('books', id);
            if (!own) return showToast("Record not found in your school", "error");
            const b = own.data;
            document.getElementById('book-edit-id').value = id;
            document.getElementById('book-title').value = b.title;
            document.getElementById('book-author').value = b.author || '';
            document.getElementById('book-category').value = b.category || '';
            document.getElementById('book-copies').value = b.totalCopies || 1;
            document.getElementById('book-shelf').value = b.shelf || '';
            document.getElementById('book-modal-title').textContent = "Edit Book";
            openModal('modal-book');
        };

