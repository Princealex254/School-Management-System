
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
        import { getAuth, signInWithEmailAndPassword, onAuthStateChanged, signOut } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";
        import { getFirestore, collection, addDoc, getDocs, doc, getDoc, updateDoc, deleteDoc, query, orderBy, onSnapshot, where, setDoc, limit } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";
        import { getStorage, ref, uploadBytes, getDownloadURL } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-storage.js";

        // --- FIREBASE CONFIGURATION ---
        const firebaseConfig = {
            apiKey: "AIzaSyCe4zBkbLEMTobEPiqfDtVmEImDTB6GbGM",
            authDomain: "schoolmanagementsaas-a7bad.firebaseapp.com",
            projectId: "schoolmanagementsaas-a7bad",
            storageBucket: "schoolmanagementsaas-a7bad.firebasestorage.app",
            messagingSenderId: "133538484653",
            appId: "1:133538484653:web:d8634d4485e56ad0379124",
            measurementId: "G-DSDCG8MY5E"
        };

        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);
        const db = getFirestore(app);
        const storage = getStorage(app);

        // --- APP STATE ---
        let currentUserData = null;
        let currentSchoolId = null;
        let currentUserRole = null; // New: Store the current user's role
        let allTeachers = []; // Cache teachers for dropdowns
        let teacherOptionsHTML = ""; // Cache for dynamic rows
        let allClasses = []; // Cache classes for dropdowns
        let allStudents = []; // Cache students for dropdowns
        let currentAcademicYear = new Date().getFullYear();
        let currentTerm = 'Term 1';
        let schoolSettings = {};
        let examGroupsCache = {}; // Grouped exam records keyed by encoded exam+student+term+year
        let currentExamViewKey = '';

        // --- THEME ENGINE ---
        let schoolThemeColor = "#800000";

        function applyTheme(hexColor) {
            if (!hexColor) return;
            schoolThemeColor = hexColor;
            document.documentElement.style.setProperty('--primary', hexColor);
        }

        function hexToRgb(hex) {
            const r = parseInt(hex.slice(1, 3), 16);
            const g = parseInt(hex.slice(3, 5), 16);
            const b = parseInt(hex.slice(5, 7), 16);
            return [r, g, b];
        }

        // Helper to format currency
        const fmtKES = (amount) => `KES ${parseFloat(amount || 0).toLocaleString('en-KE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;


        // SaaS Role-Based Access Control (RBAC)
        function hasPermission(action) {
            if(currentUserRole === 'admin') return true;
            if(currentUserRole === 'teacher' && (action === 'view' || action === 'edit')) return true;
            return false;
        }

        // Resource-specific access control
        function canEdit(resource) {
            if(currentUserRole === 'admin') return true;
            if(currentUserRole === 'teacher' && ['exams', 'attendance', 'students', 'announcements'].includes(resource)) return true;
            return false;
        }

        // --- MULTI-TENANT GUARDS (defense-in-depth) ---
        // Every tenant record carries a `schoolId`. Any operation that touches
        // a document by its ID (edit / delete / reprint / lookup) must first
        // verify the record really belongs to the currently logged-in school.
        // The authoritative enforcement lives in firestore.rules; these guards
        // stop accidental cross-school operations at the UI level too.
        async function getScopedDoc(collectionName, docId) {
            if(!currentSchoolId || !docId) return null;
            const snap = await getDoc(doc(db, collectionName, docId));
            if(!snap.exists()) return null;
            const data = snap.data();
            if(data && data.schoolId && data.schoolId !== currentSchoolId) return null;
            return { id: docId, data, snap };
        }

        // Grading & Remarks Engine
        // Grade ranges are configurable per school via Settings. Defaults:
        // A>=80, B>=70, C>=60, D>=50, else E. Schools can turn letter grades OFF
        // entirely and work with marks only.
        function gradesEnabled() {
            const gc = (schoolSettings && schoolSettings.gradeConfig) || {};
            return gc.enabled !== false; // defaults to ON
        }

        function getGrade(marks) {
            if (!gradesEnabled()) return ""; // marks-only school
            const g = (schoolSettings && schoolSettings.gradeConfig) || {};
            const a = g.a != null && !isNaN(g.a) ? parseFloat(g.a) : 80;
            const b = g.b != null && !isNaN(g.b) ? parseFloat(g.b) : 70;
            const c = g.c != null && !isNaN(g.c) ? parseFloat(g.c) : 60;
            const d = g.d != null && !isNaN(g.d) ? parseFloat(g.d) : 50;
            if (marks >= a) return "A";
            if (marks >= b) return "B";
            if (marks >= c) return "C";
            if (marks >= d) return "D";
            return "E";
        }

        // Show/hide the grade-range inputs based on the "use grades" checkbox.
        // Attached to window because index.html calls it from an inline onchange handler.
        window.syncGradeRangesUI = () => {
            const box = document.getElementById('grade-ranges-box');
            const cb = document.getElementById('set-use-grades');
            if (box && cb) box.style.display = cb.checked ? '' : 'none';
        };

        function getRemark(avg) {
            if(avg >= 75) return "Excellent Performance";
            if(avg >= 60) return "Good, keep it up";
            if(avg >= 50) return "Fair, put in more effort";
            return "Needs Improvement";
        }

                // Super Owners are resolved from Firestore (collection `super_owners`,
        // doc ID = email) — see isOwner() in firestore.rules — not hardcoded here.

        // --- AUTHENTICATION ---
        function getFriendlyErrorMessage(error) {
            if (typeof error === 'string') return error;
            switch (error.code) {
                case 'auth/user-not-found': return "Account not found. Check your email.";
                case 'auth/wrong-password': return "Incorrect password. Try again.";
                case 'auth/invalid-credential': return "Incorrect login details provided.";
                case 'permission-denied': return "You do not have permission for this operation.";
                case 'unavailable': return "Server unreachable. Check your internet connection.";
                default: return error.message || "An unexpected error occurred.";
            }
        }

        window.handleAuth = async (e, mode) => {
            e.preventDefault();
            showLoader(true);
            
            const email = document.getElementById(`${mode}-email`).value;
            const password = document.getElementById(`${mode}-password`).value;

            try {
                if(mode === 'login') {
                    await signInWithEmailAndPassword(auth, email, password);
                    showToast("Welcome back!", "success");
                }
            } catch (error) {
                showToast(getFriendlyErrorMessage(error), "error");
            } finally {
                showLoader(false);
            }
        };

        onAuthStateChanged(auth, async (user) => {
            if (user) {
                currentUserData = user;
                
                // Multi-tenant check: Find school assignment
                const adminSnap = await getDoc(doc(db, "school_admins", user.email));
                                const ownerSnap = await getDoc(doc(db, 'super_owners', user.email));
                const isOwner = ownerSnap.exists();
                // School owners (managed from the Master panel) can log into their
                // assigned school dashboard. Only grant access when a school is set
                // and the owner account is active.
                const schoolOwnerSnap = await getDoc(doc(db, 'school_owners', user.email));
                const soData = schoolOwnerSnap.exists() ? schoolOwnerSnap.data() : null;
                const isSchoolOwner = !!soData && !!soData.schoolId && soData.status !== 'inactive';
                if(!adminSnap.exists() && !isOwner && !isSchoolOwner){
                    showAlert("You are not assigned to any school. Contact the system owner.", 'error', () => signOut(auth));
                    return;
                }

                if (adminSnap.exists()) {
                    const data = adminSnap.data();
                    currentSchoolId = data.schoolId;
                    currentUserRole = data.role || 'admin';
                } else if (isOwner) {
                    // Owners might be visiting a specific school via override from a master panel
                    const overrideId = sessionStorage.getItem('owner_override_school_id');
                    if (overrideId) {
                        currentSchoolId = overrideId;
                        document.getElementById('master-access-indicator').classList.remove('hidden');
                    } else {
                        showAlert("Master Admin access detected. Please select a school to manage from the Master Panel first.", 'warning', () => { window.location.href = 'admin.html'; });
                        return;
                    }
                    currentUserRole = 'admin';
                } else if (isSchoolOwner) {
                    // School owner: grant dashboard access to their assigned school.
                    currentSchoolId = soData.schoolId;
                    currentUserRole = 'admin';
                }

                // Enforce Teacher Role UI Restrictions
                if(currentUserRole === 'teacher') {
                    const restrictedMenus = ['fees', 'fee-structures', 'settings'];
                    
                    document.querySelectorAll('.menu-item').forEach(item => {
                        if(restrictedMenus.includes(item.getAttribute('data-view'))) {
                            item.classList.add('hidden');
                        }
                    });
                    
                    // Auto-redirect if teacher lands on restricted page
                    const currentActive = document.querySelector('.menu-item.active').getAttribute('data-view');
                    if(restrictedMenus.includes(currentActive)) {
                        document.querySelector('.menu-item[data-view="dashboard"]').click();
                    }
                }

                // If no role is explicitly set (e.g., for existing entries), default to 'admin'
                if (!currentUserRole) currentUserRole = 'admin';
                document.getElementById('auth-section').classList.add('hidden');
                document.getElementById('app-section').classList.remove('hidden');
                document.getElementById('landing-section').classList.add('hidden');
                
                // Load Settings
                const settingsSnap = await getDoc(doc(db, "schools", currentSchoolId));
                if(settingsSnap.exists()) {
                    if (settingsSnap.data().status === 'inactive' && !isOwner) {
                        showAlert("Your school's access has been suspended. Contact the system owner.", 'error', () => signOut(auth));
                        return;
                    }

                    const data = settingsSnap.data();
                    applyTheme(data.themeColor);
                    document.getElementById('school-name-sidebar').innerText = data.name;
                    
                    // Runtime academic settings
                    currentAcademicYear = parseInt(data.academicYear) || new Date().getFullYear();
                    currentTerm = data.currentTerm || 'Term 1';
                    schoolSettings = data;

                    // Pre-fill settings form
                    const setVal = (id, val) => { const el = document.getElementById(id); if (el) el.value = val || ''; };
                    setVal('set-school-name', data.name);
                    setVal('set-school-location', data.location);
                    setVal('set-school-motto', data.motto);
                    setVal('set-school-contact', data.contact);
                    setVal('set-admin-name', data.adminName);
                    setVal('set-academic-year', data.academicYear || new Date().getFullYear());
                    setVal('set-current-term', data.currentTerm || 'Term 1');
                    setVal('set-principal-name', data.principalName);
                    setVal('set-payment-info', data.paymentInfo);
                    setVal('set-admission-mode', (data.admissionConfig || {}).mode || 'auto');
                    setVal('set-admission-prefix', (data.admissionConfig || {}).prefix || '');
                    // Grade range config (defaults match the hardcoded original)
                    const gc = data.gradeConfig || {};
                    setVal('set-grade-a', gc.a != null ? gc.a : 80);
                    setVal('set-grade-b', gc.b != null ? gc.b : 70);
                    setVal('set-grade-c', gc.c != null ? gc.c : 60);
                    setVal('set-grade-d', gc.d != null ? gc.d : 50);
                    const useGradesEl = document.getElementById('set-use-grades');
                    if (useGradesEl) { useGradesEl.checked = gc.enabled !== false; syncGradeRangesUI(); }
                    // Hide the static Grade column header in the exam results table when grades are off.
                    const examGradeTh = document.getElementById('exam-th-grade');
                    if (examGradeTh) examGradeTh.style.display = gradesEnabled() ? '' : 'none';
                    const themeEl = document.getElementById('set-theme-color');
                    if (themeEl) themeEl.value = data.themeColor || '#800000';
                    const logoPreview = document.getElementById('school-logo-preview');
                    if (logoPreview) {
                        logoPreview.innerHTML = data.logoUrl ? `<img src="${data.logoUrl}">` : '<i class="fas fa-school" style="font-size:1.6rem;"></i>';
                    }
                }

                // Set User Info in Nav (The person logged in)
                const displayName = user.displayName || user.email.split('@')[0];
                document.getElementById('admin-name-nav').innerText = displayName;
                document.getElementById('admin-role-nav').innerText = currentUserRole.charAt(0).toUpperCase() + currentUserRole.slice(1);
                document.getElementById('admin-initials').innerText = displayName.substring(0, 2).toUpperCase();

                initRealtimeListeners();
                initOpsListeners();
            } else {
                document.getElementById('auth-section').classList.add('hidden');
                document.getElementById('app-section').classList.add('hidden');
                document.getElementById('landing-section').classList.remove('hidden');
            }
        });

        window.logout = () => {
            if(confirm("Logout from dashboard?")) signOut(auth);
        };

        window.exitMasterAccess = () => {
            sessionStorage.removeItem('owner_override_school_id');
            window.location.href = 'admin.html';
        };

        // --- LANDING PAGE CONTROLS ---
        window.showLoginView = () => {
            document.getElementById('landing-section').classList.add('hidden');
            document.getElementById('auth-section').classList.remove('hidden');
            document.getElementById('app-section').classList.add('hidden');
            document.body.classList.remove('dark-mode');
            window.scrollTo({ top: 0, left: 0, behavior: 'smooth' });
        };
        window.showLandingView = () => {
            document.getElementById('auth-section').classList.add('hidden');
            document.getElementById('app-section').classList.add('hidden');
            document.getElementById('landing-section').classList.remove('hidden');
            window.scrollTo({ top: 0, left: 0, behavior: 'smooth' });
        };
        window.lpToggleNav = () => {
            const links = document.getElementById('lpLinks');
            if (!links) return;
            const open = links.classList.toggle('open');
            const toggle = document.getElementById('lpToggle');
            if (toggle) toggle.innerHTML = open ? '<i class="fas fa-times"></i>' : '<i class="fas fa-bars"></i>';
        };
        (function initLandingPage() {
            document.body.classList.add('lp-js');
            const topbar = document.getElementById('lpTopbar');
            if (topbar) {
                window.addEventListener('scroll', () => topbar.classList.toggle('scrolled', window.scrollY > 40), { passive: true });
            }
            // FAQ accordion
            document.querySelectorAll('.lp-faq-q').forEach(q => {
                q.addEventListener('click', () => {
                    const item = q.parentElement;
                    const wasOpen = item.classList.contains('open');
                    document.querySelectorAll('.lp-faq.open').forEach(f => {
                        f.classList.remove('open');
                        const aEl = f.querySelector('.lp-faq-a');
                        if (aEl) aEl.style.maxHeight = null;
                    });
                    if (!wasOpen) {
                        item.classList.add('open');
                        const aEl = item.querySelector('.lp-faq-a');
                        if (aEl) aEl.style.maxHeight = aEl.scrollHeight + 'px';
                    }
                });
            });
            // Close mobile menu when navigating
            document.querySelectorAll('#lpLinks a').forEach(a => a.addEventListener('click', () => {
                const links = document.getElementById('lpLinks');
                if (links && links.classList.contains('open')) links.classList.remove('open');
            }));
            // Reveal on scroll
            const reveals = document.querySelectorAll('.lp-reveal');
            if ('IntersectionObserver' in window) {
                const io = new IntersectionObserver(entries => {
                    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
                }, { threshold: 0.12 });
                reveals.forEach(el => io.observe(el));
            } else {
                reveals.forEach(el => el.classList.add('in'));
            }
            // Contact form -> email app
            const cf = document.getElementById('lpContactForm');
            if (cf) {
                cf.addEventListener('submit', (ev) => {
                    ev.preventDefault();
                    const name = (document.getElementById('lp-name') || {}).value || '';
                    const school = (document.getElementById('lp-school') || {}).value || '';
                    const email = (document.getElementById('lp-email') || {}).value || '';
                    const message = (document.getElementById('lp-message') || {}).value || '';
                    const subject = encodeURIComponent('School Management System Enquiry - ' + name + (school ? ' (' + school + ')' : ''));
                    const body = encodeURIComponent('Name: ' + name + '\nSchool: ' + school + '\nYour Email: ' + email + '\n\n' + message);
                    window.location.href = 'mailto:princealexdigital@gmail.com?subject=' + subject + '&body=' + body;
                    if (typeof showToast === 'function') showToast("Opening your email appÃ¢â‚¬Â¦");
                });
            }
        })();

        // --- UI NAVIGATION ---
        document.querySelectorAll('.menu-item').forEach(item => {
            item.addEventListener('click', () => {
                const viewId = item.getAttribute('data-view');
                
                // Update Active State
                document.querySelectorAll('.menu-item').forEach(i => i.classList.remove('active'));
                item.classList.add('active');
                
                // Update Header
                document.getElementById('current-view-title').innerText = item.innerText;

                // Show View
                document.querySelectorAll('.view').forEach(v => v.classList.add('hidden'));
                document.getElementById(`view-${viewId}`).classList.remove('hidden');

                if(window.innerWidth <= 768) toggleSidebar();
            });
        });

        window.toggleSidebar = () => {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('sidebar-overlay');
            if (sidebar.classList.contains('active')) {
                sidebar.classList.remove('active');
                overlay.style.display = 'none';
            } else {
                sidebar.classList.add('active');
                overlay.style.display = 'block';
            }
        };
        document.getElementById('toggle-btn').onclick = toggleSidebar;

        // --- NOTIFICATIONS & LOADER ---
        window.showToast = (msg, type) => {
            const toast = document.createElement('div');
            toast.className = `toast ${type === 'success' ? 'btn-primary' : 'btn-danger'}`;
            toast.innerHTML = `<i class="fas ${type === 'success' ? 'fa-check-circle' : 'fa-exclamation-triangle'}"></i> ${msg}`;
            document.getElementById('toast-container').appendChild(toast);
            setTimeout(() => toast.remove(), 4000);
        };

        // Custom on-screen alert dialog (appears on top as a screen prompt)
        window.showAlert = (msg, type = 'info', onClose = null) => {
            const esc = (s) => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
            let overlay = document.getElementById('app-alert-overlay');
            if (!overlay) {
                overlay = document.createElement('div');
                overlay.id = 'app-alert-overlay';
                overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.55);display:flex;align-items:center;justify-content:center;z-index:99999;';
                overlay.innerHTML =
                    '<div style="background:#fff;border-radius:14px;max-width:420px;width:90%;padding:26px 24px;box-shadow:0 14px 50px rgba(0,0,0,0.35);text-align:center;font-family:inherit;">' +
                        '<div id="app-alert-icon" style="font-size:2.4rem;margin-bottom:12px;"></div>' +
                        '<p id="app-alert-msg" style="font-size:1rem;color:#2b2b2b;line-height:1.55;margin:0 0 20px;word-break:break-word;"></p>' +
                        '<button id="app-alert-btn" style="padding:11px 30px;border:none;border-radius:8px;color:#fff;font-weight:600;cursor:pointer;font-size:0.95rem;min-width:110px;">OK</button>' +
                    '</div>';
                document.body.appendChild(overlay);
            }
            const cfg = {
                error:   { icon: 'fa-exclamation-triangle', color: '#dc3545' },
                success: { icon: 'fa-check-circle',         color: '#28a745' },
                warning: { icon: 'fa-exclamation-circle',   color: '#f39c12' },
                info:    { icon: 'fa-info-circle',          color: '#0d6efd' }
            }[type] || { icon: 'fa-info-circle', color: '#0d6efd' };
            document.getElementById('app-alert-icon').innerHTML = '<i class="fas ' + cfg.icon + '" style="color:' + cfg.color + ';"></i>';
            document.getElementById('app-alert-msg').innerHTML = esc(msg).replace(/\n/g, '<br>');
            document.getElementById('app-alert-btn').style.background = cfg.color;
            overlay.style.display = 'flex';
            const close = () => { overlay.style.display = 'none'; if (onClose) onClose(); };
            document.getElementById('app-alert-btn').onclick = close;
            overlay.onclick = (e) => { if (e.target === overlay) close(); };
            document.onkeydown = (e) => { if (e.key === 'Escape') close(); };
        };

        window.showLoader = (status) => {
            document.getElementById('loader').style.display = status ? 'flex' : 'none';
        };

        // --- DATA OPERATIONS ---

        // 1. Students
        window.saveStudent = async (e) => {
            e.preventDefault();
            if(!canEdit('students')) {
                showToast("Permission denied", "error");
                return;
            }
            showLoader(true);
            try {
                const id = document.getElementById('student-edit-id').value;
                if (id ? !enforcePerm('students', 'edit') : !enforcePerm('students', 'create')) {
                    showToast("Permission denied", "error");
                    return;
                }
                const photoFile = document.getElementById('student-photo').files[0];
                
                // Safely handle potentially missing fields
                const feesTotalEl = document.getElementById('student-fees-total');
                const feesTotal = feesTotalEl ? parseFloat(feesTotalEl.value) || 0 : 0;
                
                const subjectsEl = document.getElementById('student-subjects');
                let studentSubjects = [];
                if (subjectsEl && subjectsEl.value) {
                    try { studentSubjects = JSON.parse(subjectsEl.value); } catch(e) { throw new Error("Invalid JSON format in subjects field."); }
                }

                let photoUrl = "";
                let feesPaid = 0;

                if(photoFile) {
                    // Namespace uploads by school so storage.rules can enforce isolation.
                    const storageRef = ref(storage, `students/${currentSchoolId}/${Date.now()}_${photoFile.name}`);
                    const upload = await uploadBytes(storageRef, photoFile);
                    photoUrl = await getDownloadURL(upload.ref);
                } else if(id) {
                    const old = await getScopedDoc("students", id);
                    if (!old) return showToast("Record not found in your school", "error");
                    photoUrl = old.data.photoUrl;
                    if (old.data.fees) feesPaid = old.data.fees.paid || 0;
                }

            const gv = (elId) => (document.getElementById(elId) || {}).value || '';
            const fname = gv('student-first');
            const mname = gv('student-middle');
            const lname = gv('student-last');
            const fullName = (gv('student-name') || [fname, mname, lname].filter(Boolean).join(' ')).trim();
            if (!fullName) { showToast("Student name is required.", "error"); return; }
            const gender = gv('student-gender');
            const streamId = gv('student-stream');
            const status = gv('student-status') || 'Active';
            const academicYear = parseInt(gv('student-academic-year')) || currentAcademicYear;
            const admissionDate = gv('student-admission-date') || new Date().toISOString().slice(0,10);

            // Admission: preserve on edit; otherwise auto/manual per school config
            let admissionNo = gv('student-admission').trim();
            if (id) {
                const oldRec = allStudents.find(s => s.docId === id);
                if (!admissionNo && oldRec) admissionNo = oldRec.admissionNo || oldRec.studentId || '';
            }
            if (!admissionNo) {
                if ((schoolSettings.admissionConfig || {}).mode === 'manual') {
                    showToast("Admission number is required in manual mode.", "error");
                    showLoader(false);
                    return;
                }
                admissionNo = nextAdmissionNo();
            }
            const dup = allStudents.find(s => s.docId !== id &&
                String(s.admissionNo || s.studentId || '').toLowerCase() === admissionNo.toLowerCase());
            if (dup) { showToast(`Admission number "${admissionNo}" already exists in this school.`, "error"); return; }

            const data = {
                schoolId: currentSchoolId,
                name: fullName,
                firstName: fname,
                middleName: mname,
                lastName: lname,
                gender,
                classId: document.getElementById('student-class').value,
                streamId,
                status,
                academicYear,
                admissionDate,
                admissionNo,
                photoUrl: photoUrl || "https://ui-avatars.com/api/?background=800000&color=fff&name=" + fullName,
                studentId: id ? (await getScopedDoc("students", id))?.data?.studentId || ("STU-" + Math.floor(1000 + Math.random()*9000)) : ("STU-" + Math.floor(1000 + Math.random()*9000)),
                updatedAt: new Date().toISOString(),
                dob: document.getElementById('student-dob').value,
                parentContact: document.getElementById('student-parent').value,
                studentSubjects: studentSubjects,
                fees: { total: feesTotal, paid: feesPaid, balance: feesTotal - feesPaid }
            };

            if(id) {
                await updateDoc(doc(db, "students", id), data);
            } else {
                await addDoc(collection(db, "students"), data);
            }
            
            closeModal('modal-student');
            showToast("Student profile saved", "success");

            } catch (err) { showToast(getFriendlyErrorMessage(err), "error"); }
            finally { showLoader(false); }
        };

        window.deleteStudent = async (id) => {
            if(!hasPermission('delete')) {
                showToast("Permission denied", "error");
                return;
            }
            if(!enforcePerm('students', 'archive')) { showToast("Permission denied", "error"); return; }

            if(!confirm("Delete student record permanently?")) return;
            try {
                const own = await getScopedDoc("students", id);
                if(!own) return showToast("Record not found in your school", "error");
                await deleteDoc(doc(db, "students", id));
                showToast("Student record deleted successfully", "success");
                // No need to reload, onSnapshot will update the UI
            } catch (err) { showToast(getFriendlyErrorMessage(err), "error"); }
        };

        window.editStudent = async (id) => {
            const own = await getScopedDoc("students", id);
            if(!own) return showToast("Record not found in your school", "error");
            const data = own.data;
            document.getElementById('student-edit-id').value = id;
            document.getElementById('student-name').value = data.name || '';
            document.getElementById('student-first').value = data.firstName || '';
            document.getElementById('student-middle').value = data.middleName || '';
            document.getElementById('student-last').value = data.lastName || '';
            document.getElementById('student-gender').value = data.gender || '';
            document.getElementById('student-class').value = data.classId || '';
            document.getElementById('student-dob').value = data.dob || '';
            document.getElementById('student-parent').value = data.parentContact || '';
            document.getElementById('student-admission').value = data.admissionNo || data.studentId || '';
            document.getElementById('student-status').value = data.status || 'Active';
            document.getElementById('student-admission-date').value = data.admissionDate || '';
            populateStreamSelect(document.getElementById('student-stream'), data.streamId, data.classId);
            populateAcademicYearSelect(document.getElementById('student-academic-year'), data.academicYear);
            document.getElementById('student-photo-preview').innerHTML = `<img src="${data.photoUrl}">`;
            openModal('modal-student');
        };

        window.openStudentModal = () => {
            document.getElementById('student-edit-id').value = '';
            ['student-name','student-first','student-middle','student-last','student-admission'].forEach(i => { const e=document.getElementById(i); if(e) e.value=''; });
            document.getElementById('student-gender').value = '';
            document.getElementById('student-dob').value = '';
            document.getElementById('student-parent').value = '';
            document.getElementById('student-status').value = 'Active';
            document.getElementById('student-admission-date').value = new Date().toISOString().slice(0,10);
            document.getElementById('student-photo-preview').innerHTML = '<i class="fas fa-camera"></i>';
            populateStreamSelect(document.getElementById('student-stream'), '', '');
            populateAcademicYearSelect(document.getElementById('student-academic-year'), currentAcademicYear);
            if ((schoolSettings.admissionConfig || {}).mode === 'auto') {
                const e = document.getElementById('student-admission'); if (e) e.value = nextAdmissionNo();
            }
            openModal('modal-student');
        };

        // 2. Teachers
        window.saveTeacher = async (e) => {
            e.preventDefault();
            if(!canEdit('teachers')) return showToast("Permission denied", "error");
            if(!enforcePerm('staff', 'create')) return showToast("Permission denied", "error");

            const id = document.getElementById('teacher-edit-id').value;
            const subjects = document.getElementById('teacher-subjects-csv').value.split(',').map(s => s.trim());

            const data = {
                schoolId: currentSchoolId,
                name: document.getElementById('teacher-name').value,
                email: document.getElementById('teacher-email').value,
                phone: document.getElementById('teacher-phone').value,
                employeeId: document.getElementById('teacher-emp-id').value || "TCH-" + Math.floor(1000 + Math.random() * 9000),
                subjects: subjects,
                role: 'teacher',
                status: 'active',
                updatedAt: new Date().toISOString()
            };

            try {
                if(id) {
                    const own = await getScopedDoc("teachers", id);
                    if(!own) return showToast("Record not found in your school", "error");
                    await updateDoc(doc(db, "teachers", id), data);
                } else {
                    data.createdAt = new Date().toISOString();
                    await addDoc(collection(db, "teachers"), data);
                }
                closeModal('modal-teacher');
                showToast(`Record for ${data.name} saved successfully`, "success");
            } catch (err) { showToast(getFriendlyErrorMessage(err), "error"); }
        };

        window.deleteTeacher = async (id) => {
            if(!hasPermission('delete')) {
                showToast("Permission denied", "error");
                return;
            }

            if(!confirm("Remove teacher?")) return;
            try {
                const own = await getScopedDoc("teachers", id);
                if(!own) return showToast("Record not found in your school", "error");
                await deleteDoc(doc(db, "teachers", id));
                showToast("Teacher record removed", "success");
                // No need to reload, onSnapshot will update the UI
            } catch (err) { showToast(getFriendlyErrorMessage(err), "error"); }
        };

        window.deleteFeeStructure = async (id) => {
            if(!hasPermission('delete')) return showToast("Permission denied", "error");
            if(!confirm("Remove this fee structure?")) return;
            try {
                const own = await getScopedDoc("fee_structures", id);
                if(!own) return showToast("Record not found in your school", "error");
                await deleteDoc(doc(db, "fee_structures", id));
                showToast("Fee structure removed", "success");
            } catch (err) { showToast(getFriendlyErrorMessage(err), "error"); }
        };

        window.editTeacher = async (id) => {
            const own = await getScopedDoc("teachers", id);
            if(!own) return showToast("Record not found in your school", "error");
            const data = own.data;
            document.getElementById('teacher-edit-id').value = id;
            document.getElementById('teacher-name').value = data.name;
            document.getElementById('teacher-email').value = data.email || '';
            document.getElementById('teacher-phone').value = data.phone;
            document.getElementById('teacher-emp-id').value = data.employeeId || '';
            document.getElementById('teacher-subjects-csv').value = (data.subjects || []).join(', ');
            openModal('modal-teacher');
        };

        // 3. Classes
        window.saveClass = async (e) => {
            e.preventDefault();
            if(!canEdit('classes')) return showToast("Permission denied", "error");
            if(!enforcePerm('academics', 'grades.manage')) return showToast("Permission denied", "error");

            const id = document.getElementById('class-edit-id').value;
            
            // Gather mapping from dynamic rows instead of JSON textarea
            const subjectMapping = [];
            const rows = document.querySelectorAll('#class-subject-teacher-rows .subject-teacher-row');
            rows.forEach(row => {
                const name = row.querySelector('.subject-name').value.trim();
                const teacherId = row.querySelector('.teacher-select').value;
                if (name && teacherId) {
                    subjectMapping.push({ name, teacherId });
                }
            });

            const data = {
                schoolId: currentSchoolId,
                name: document.getElementById('class-name').value,
                classTeacherId: document.getElementById('class-teacher-select').value,
                subjects: subjectMapping,
                updatedAt: new Date().toISOString()
            };
            try {
                if(id) {
                    const own = await getScopedDoc("classes", id);
                    if(!own) return showToast("Record not found in your school", "error");
                    await updateDoc(doc(db, "classes", id), data);
                }
                else await addDoc(collection(db, "classes"), data);
                closeModal('modal-class');
                showToast(`Class "${data.name}" configured successfully`, "success");
            } catch (err) { showToast(getFriendlyErrorMessage(err), "error"); }
        };

        window.addSubjectTeacherRow = (subjectData = null) => {
            const container = document.getElementById('class-subject-teacher-rows');
            const rowId = 'row-' + Date.now() + Math.floor(Math.random() * 1000);
            
            const row = document.createElement('div');
            row.className = 'flex gap-10 align-center subject-teacher-row';
            row.id = rowId;
            
            row.innerHTML = `
                <input type="text" class="form-control subject-name" placeholder="Subject Name" value="${subjectData ? subjectData.name : ''}" style="flex: 2;">
                <select class="form-control teacher-select" style="flex: 2;">
                    <option value="">Select Teacher</option>
                    ${teacherOptionsHTML}
                </select>
                <button type="button" class="btn btn-danger btn-sm" onclick="removeSubjectTeacherRow('${rowId}')">
                    <i class="fas fa-times"></i>
                </button>
            `;
            
            if (subjectData && subjectData.teacherId) {
                row.querySelector('.teacher-select').value = subjectData.teacherId;
            }
            
            container.appendChild(row);
        };

        window.removeSubjectTeacherRow = (rowId) => {
            const row = document.getElementById(rowId);
            if (row) row.remove();
        };

        window.editClass = async (id) => {
            const own = await getScopedDoc("classes", id);
            if (!own) return showToast("Record not found in your school", "error");
            const data = own.data;
            
            document.getElementById('class-edit-id').value = id;
            document.getElementById('class-name').value = data.name;
            document.getElementById('class-teacher-select').value = data.classTeacherId || '';
            
            document.getElementById('class-subject-teacher-rows').innerHTML = '';
            if (data.subjects) data.subjects.forEach(s => addSubjectTeacherRow(s));
            
            openModal('modal-class');
        };

        window.deleteClass = async (id) => {
            if(!hasPermission('delete')) {
                showToast("Permission denied", "error");
                return;
            }

            if(!confirm("Delete this class?")) return;
            try {
                const own = await getScopedDoc("classes", id);
                if(!own) return showToast("Record not found in your school", "error");
                await deleteDoc(doc(db, "classes", id));
                showToast("Class deleted successfully", "success");
                // No need to reload, onSnapshot will update the UI
            } catch (err) { showToast(getFriendlyErrorMessage(err), "error"); }
        };

        // 4. Attendance
        const ATT_STATUSES = ['Present', 'Late', 'Absent', 'Excused'];
        function attendanceDocId(classId, date) { return `att_${classId}_${date}`; }
        function todayStr() {
            const n = new Date();
            return n.getFullYear() + '-' + String(n.getMonth() + 1).padStart(2, '0') + '-' + String(n.getDate()).padStart(2, '0');
        }
        function formatDateStr(date) {
            if (!date) return '-';
            const d = new Date(date + 'T00:00:00');
            return isNaN(d.getTime()) ? date : d.toLocaleDateString();
        }
        function countStatuses(rec) {
            const c = { present: 0, late: 0, absent: 0, excused: 0, total: 0 };
            Object.values(rec || {}).forEach(v => { const k = String(v || 'Absent').toLowerCase(); c.total++; if (k in c) c[k]++; });
            return c;
        }
        function updateAttendanceCounts() {
            const list = document.getElementById('attendance-students-list');
            const sumEl = document.getElementById('attendance-form-summary');
            if (!list || !sumEl) return;
            const cc = { present: 0, late: 0, absent: 0, excused: 0, total: 0 };
            list.querySelectorAll('input[type="radio"]:checked').forEach(i => { const k = i.value.toLowerCase(); cc.total++; if (k in cc) cc[k]++; });
            const total = list.querySelectorAll('.attendance-row').length;
            sumEl.innerHTML = `<span class="status-pill status-present">Present: ${cc.present}</span><span class="status-pill status-late">Late: ${cc.late}</span><span class="status-pill status-absent">Absent: ${cc.absent}</span><span class="status-pill status-excused">Excused: ${cc.excused}</span><span class="status-pill" style="background:#f1f2f6; color:#7f8c8d;">Total: ${total}</span>`;
        }

        window.loadAttendanceForm = async (forceClassId, forceDate) => {
            if (!hasPermission('view')) { showToast("Permission denied", "error"); return; }
            const classEl = document.getElementById('attendance-class-select');
            const dateEl = document.getElementById('attendance-date');
            let classId = forceClassId || classEl.value;
            let date = forceDate || dateEl.value;
            if (!date) { date = todayStr(); dateEl.value = date; }
            if (!classId || !date) return showToast("Select class and date", "error");

            // Class must belong to this school (teacher can only mark their own class)
            const ownClass = await getScopedDoc("classes", classId);
            if (!ownClass) return showToast("Class not found in your school", "error");
            if (currentUserRole === 'teacher' && ownClass.data.classTeacherId !== currentUserData.uid) {
                return showToast("You can only mark attendance for your assigned class.", "error");
            }

            const q = query(collection(db, "students"), where("schoolId", "==", currentSchoolId), where("classId", "==", classId));
            const snap = await getDocs(q);

            // Load any existing record for this class+date so we can edit it
            let existing = null;
            try {
                const exSnap = await getDoc(doc(db, "attendance", attendanceDocId(classId, date)));
                if (exSnap.exists()) existing = exSnap.data().records || null;
            } catch (e) { existing = null; }

            let html = "";
            snap.forEach(d => {
                const st = d.data();
                const prev = (existing && existing[d.id]) || 'Present';
                const radios = ATT_STATUSES.map(s =>
                    `<label class="att-radio"><input type="radio" name="att-${d.id}" value="${s}" ${prev === s ? 'checked' : ''}> ${s}</label>`
                ).join('');
                html += `
                <div class="attendance-row">
                    <div>
                        <b>${st.name}</b>
                        <div style="font-size:0.72rem; color:var(--text-muted);">${st.studentId || ''}</div>
                    </div>
                    <div class="flex gap-10 align-center" style="flex-wrap:wrap;">${radios}</div>
                </div>`;
            });

            document.getElementById('attendance-students-list').innerHTML = html || "<p>No students in this class.</p>";
            document.getElementById('attendance-form-title').innerText = `Daily Roll Â· ${ownClass.data.name} Â· ${formatDateStr(date)}`;
            const note = document.getElementById('attendance-edit-note');
            if (note) note.innerText = existing ? "Editing an existing record for this date â€” saving will update it." : "New record for this date.";

            const listEl = document.getElementById('attendance-students-list');
            listEl.onchange = updateAttendanceCounts;
            updateAttendanceCounts();

            document.getElementById('attendance-form-card').classList.remove('hidden');
            document.getElementById('attendance-form-card').scrollIntoView({ behavior: 'smooth', block: 'start' });
        };

        window.markAllAttendance = (status) => {
            const list = document.getElementById('attendance-students-list');
            if (!list) return;
            list.querySelectorAll('input[type="radio"]').forEach(r => { if (r.value === status) r.checked = true; });
            updateAttendanceCounts();
        };
        window.clearAttendance = () => {
            const list = document.getElementById('attendance-students-list');
            if (!list) return;
            list.querySelectorAll('input[type="radio"]:checked').forEach(r => r.checked = false);
            updateAttendanceCounts();
        };
        window.cancelAttendanceForm = () => {
            document.getElementById('attendance-form-card').classList.add('hidden');
        };

        window.saveAttendance = async () => {
            if (!hasPermission('edit')) { showToast("Permission denied for attendance", "error"); return; }
            if (!enforcePerm('attendance', 'take')) { showToast("Permission denied for attendance", "error"); return; }
            const classId = document.getElementById('attendance-class-select').value;
            const date = document.getElementById('attendance-date').value;
            const list = document.getElementById('attendance-students-list');
            const records = {};
            list.querySelectorAll('input[type="radio"]:checked').forEach(input => {
                records[input.name.replace('att-', '')] = input.value;
            });
            if (Object.keys(records).length === 0) return showToast("No students marked for this day.", "warning");

            // Class ownership re-check before saving
            const ownClass = await getScopedDoc("classes", classId);
            if (!ownClass) return showToast("Class not found in your school", "error");
            if (currentUserRole === 'teacher' && ownClass.data.classTeacherId !== currentUserData.uid) {
                return showToast("You can only mark attendance for your assigned class.", "error");
            }

            const c = countStatuses(records);
            try {
                // Deterministic doc id means one record per class+date (edits update, no duplicates)
                await setDoc(doc(db, "attendance", attendanceDocId(classId, date)), {
                    schoolId: currentSchoolId,
                    classId,
                    date,
                    term: currentTerm,
                    year: currentAcademicYear,
                    records,
                    present: c.present,
                    late: c.late,
                    absent: c.absent,
                    excused: c.excused,
                    total: c.total,
                    updatedAt: new Date().toISOString()
                }, { merge: true });
                showToast(`Attendance for ${formatDateStr(date)} saved (${c.present + c.late} present of ${c.total})`, "success");
                document.getElementById('attendance-form-card').classList.add('hidden');
                renderAttendanceHistory();
            } catch (err) { showToast(getFriendlyErrorMessage(err), "error"); }
        };

        window.loadAttendanceFormFor = (classId, date) => {
            const classEl = document.getElementById('attendance-class-select');
            const dateEl = document.getElementById('attendance-date');
            if (classEl) classEl.value = classId;
            if (dateEl) dateEl.value = date;
            loadAttendanceForm(classId, date);
        };

        window.deleteAttendance = async (id) => {
            if (!hasPermission('delete')) return showToast("Permission denied", "error");
            if (!confirm("Delete this attendance record?")) return;
            try {
                const own = await getScopedDoc("attendance", id);
                if (!own) return showToast("Record not found in your school", "error");
                await deleteDoc(doc(db, "attendance", id));
                showToast("Attendance record deleted", "success");
                renderAttendanceHistory();
            } catch (err) { showToast(getFriendlyErrorMessage(err), "error"); }
        };

        window.renderAttendanceHistory = async () => {
            const tbody = document.getElementById('attendance-history-body');
            if (!tbody) return;
            try {
                const snap = await getDocs(query(collection(db, "attendance"), where("schoolId", "==", currentSchoolId)));
                const classMap = {}; allClasses.forEach(c => classMap[c.id] = c.name);
                const docs = snap.docs.map(d => ({ id: d.id, ...d.data() })).sort((a, b) => String(b.date).localeCompare(String(a.date)));

                tbody.innerHTML = "";
                if (docs.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="8" style="text-align:center; color:var(--text-muted);">No attendance has been recorded yet. Mark a class above to get started.</td></tr>';
                }
                const delIcon = hasPermission('delete') ? '' : ' style="display:none;"';
                docs.forEach(r => {
                    const c = countStatuses(r.records);
                    const attended = c.present + c.late;
                    const rate = c.total ? Math.round((attended / c.total) * 100) : 0;
                    tbody.innerHTML += `
                        <tr>
                            <td style="white-space:nowrap;">${formatDateStr(r.date)}</td>
                            <td><b>${classMap[r.classId] || 'Unassigned'}</b></td>
                            <td><span class="status-pill status-present">${c.present}</span></td>
                            <td><span class="status-pill status-late">${c.late}</span></td>
                            <td><span class="status-pill status-absent">${c.absent}</span></td>
                            <td><span class="status-pill status-excused">${c.excused}</span></td>
                            <td><b style="color:${rate >= 80 ? 'var(--success)' : 'var(--warning)'};">${rate}%</b></td>
                            <td style="white-space:nowrap;">
                                <i class="fas fa-eye" style="color:var(--primary); cursor:pointer; margin-right:10px;" title="View / Edit" onclick="loadAttendanceFormFor('${r.classId}', '${r.date}')"></i>
                                <i class="fas fa-trash" style="color:var(--danger); cursor:pointer;" title="Delete"${delIcon} onclick="deleteAttendance('${r.id}')"></i>
                            </td>
                        </tr>`;
                });
                renderStudentAttendanceReport(docs, classMap);
            } catch (err) { /* ignore transient read errors */ }
        };

        function renderStudentAttendanceReport(docs, classMap) {
            const tbody = document.getElementById('attendance-report-body');
            if (!tbody) return;
            const filterEl = document.getElementById('attendance-report-class');
            const filterClass = filterEl ? filterEl.value : '';
            const studMap = {}; allStudents.forEach(s => studMap[s.docId] = s);
            const agg = {};
            docs.forEach(r => {
                Object.entries(r.records || {}).forEach(([sid, st]) => {
                    if (!agg[sid]) agg[sid] = { present: 0, late: 0, absent: 0, excused: 0, total: 0 };
                    const k = String(st || 'Absent').toLowerCase();
                    if (k in agg[sid]) agg[sid][k]++;
                    agg[sid].total++;
                });
            });

            let rows = Object.keys(agg).map(sid => {
                const s = studMap[sid];
                if (!s) return null;
                if (filterClass && s.classId !== filterClass) return null;
                const c = agg[sid];
                const attended = c.present + c.late;
                const rate = c.total ? Math.round((attended / c.total) * 100) : 0;
                return { s, c, rate };
            }).filter(Boolean);
            rows.sort((a, b) => b.rate - a.rate);

            tbody.innerHTML = rows.length ? rows.map(x => {
                const c = x.c;
                return `<tr>
                    <td><b>${x.s.name}</b><br><small class="text-muted">${x.s.studentId || ''}</small></td>
                    <td>${classMap[x.s.classId] || '-'}</td>
                    <td><span class="status-pill status-present">${c.present}</span></td>
                    <td><span class="status-pill status-late">${c.late}</span></td>
                    <td><span class="status-pill status-absent">${c.absent}</span></td>
                    <td><span class="status-pill status-excused">${c.excused}</span></td>
                    <td><b style="color:${x.rate >= 80 ? 'var(--success)' : 'var(--warning)'};">${x.rate}%</b></td>
                </tr>`;
            }).join('') : '<tr><td colspan="7" style="text-align:center; color:var(--text-muted);">No attendance data for this class yet.</td></tr>';
        }

        window.exportAttendanceHistoryCSV = () => {
            const table = document.getElementById('attendance-history-table');
            if (!table) return;
            const rows = [];
            table.querySelectorAll('tr').forEach(r => rows.push(Array.from(r.cells).map(c => c.innerText)));
            downloadCSV(`Attendance_History_${currentTerm.replace(/\s/g, '')}_${currentAcademicYear}.csv`, rows);
            showToast("Attendance history exported", "success");
        };

        window.exportAttendanceReportCSV = () => {
            const table = document.getElementById('attendance-report-table');
            if (!table) return;
            const rows = [];
            table.querySelectorAll('tr').forEach(r => rows.push(Array.from(r.cells).map(c => c.innerText)));
            downloadCSV(`Attendance_Student_Report_${currentTerm.replace(/\s/g, '')}_${currentAcademicYear}.csv`, rows);
            showToast("Attendance report exported", "success");
        };

        // 6. Fees
        window.addExtraFeeRow = (feeName = '', feeAmount = '') => {
            const container = document.getElementById('fs-extra-fees-container');
            const rowId = 'extra-fee-' + Date.now() + Math.floor(Math.random() * 1000);
            const row = document.createElement('div');
            row.className = 'flex gap-10 align-center extra-fee-row';
            row.id = rowId;
            row.style.marginBottom = '10px';
            row.innerHTML = `
                <input type="text" class="form-control fee-name" placeholder="Fee Name" value="${feeName}" style="flex: 2;">
                <input type="number" class="form-control fee-amount" placeholder="Amount" value="${feeAmount}" style="flex: 1;">
                <button type="button" class="btn btn-danger btn-sm" onclick="document.getElementById('${rowId}').remove()">
                    <i class="fas fa-times"></i>
                </button>
            `;
            container.appendChild(row);
        };

        window.editFeeStructure = async (id) => {
            const own = await getScopedDoc("fee_structures", id);
            if(!own) return showToast("Record not found in your school", "error");
            const data = own.data;

            document.getElementById('fs-edit-id').value = id;
            document.getElementById('fs-class').value = data.classId;
            document.getElementById('fs-term').value = data.term;
            document.getElementById('fs-year').value = data.year;
            document.getElementById('fs-tuition').value = data.tuition;

            const container = document.getElementById('fs-extra-fees-container');
            container.innerHTML = '';
            if (data.extraFees && Array.isArray(data.extraFees)) {
                data.extraFees.forEach(fee => addExtraFeeRow(fee.name, fee.amount));
            } else if (data.extra) {
                addExtraFeeRow('Other Fees', data.extra);
            }

            openModal('modal-fee-structure');
        };

        window.saveFeeStructure = async (e) => {
            e.preventDefault();
            if(!enforcePerm('fees', 'manage')) return showToast("Permission denied", "error");
            const tuition = parseFloat(document.getElementById('fs-tuition').value);

            const extraFees = [];
            let extraTotal = 0;
            document.querySelectorAll('.extra-fee-row').forEach(row => {
                const name = row.querySelector('.fee-name').value.trim();
                const amount = parseFloat(row.querySelector('.fee-amount').value) || 0;
                if (name) {
                    extraFees.push({ name, amount });
                    extraTotal += amount;
                }
            });

            const data = {
                schoolId: currentSchoolId,
                classId: document.getElementById('fs-class').value,
                term: document.getElementById('fs-term').value,
                year: parseInt(document.getElementById('fs-year').value),
                tuition, 
                extraFees,
                extra: extraTotal,
                total: tuition + extraTotal,
                updatedAt: new Date().toISOString()
            };

            try {
                const id = document.getElementById('fs-edit-id').value;
                if(id) {
                    const own = await getScopedDoc("fee_structures", id);
                    if(!own) return showToast("Record not found in your school", "error");
                    await updateDoc(doc(db, "fee_structures", id), data);
                }
                else await addDoc(collection(db, "fee_structures"), data);
                closeModal('modal-fee-structure');
                showToast("Fee structure saved", "success");
            } catch (err) { showToast(getFriendlyErrorMessage(err), "error"); }
        };

        async function getStudentFeeSummary(studentId, classId, term, year) {
            const fsQuery = query(collection(db, "fee_structures"), 
                where("schoolId", "==", currentSchoolId), 
                where("classId", "==", classId), 
                where("term", "==", term), 
                where("year", "==", year)
            );
            const fsSnap = await getDocs(fsQuery);
            const totalRequired = fsSnap.docs[0]?.data()?.total || 0;

            const payQuery = query(collection(db, "fees"), 
                where("schoolId", "==", currentSchoolId),
                where("studentId", "==", studentId),
                where("term", "==", term),
                where("year", "==", year)
            );
            const paySnap = await getDocs(payQuery);
            let paid = 0;
            paySnap.forEach(d => paid += (d.data().amount || 0));
            return { total: totalRequired, paid, balance: totalRequired - paid };
        }

        window.saveFee = async (e) => {
            e.preventDefault();
            if(!canEdit('fees')) return showToast("Permission denied", "error");
            const studentId = document.getElementById('fee-student-select').value;
            const amount = parseFloat(document.getElementById('fee-amount').value);
            const term = document.getElementById('fee-term').value;
            const year = parseInt(document.getElementById('fee-year').value);
            const method = document.getElementById('fee-method').value;
            const editId = document.getElementById('fee-edit-id').value;

            showLoader(true);
            try {
                const studentSnap = await getDoc(doc(db, "students", studentId));
                if (!studentSnap.exists()) throw new Error("Student record missing");
                if (!(studentSnap.data().schoolId && studentSnap.data().schoolId === currentSchoolId))
                    throw new Error("Student not found in your school");
                const student = studentSnap.data();

                // 1. Get Fee Structure for accurate balance calculation
                const fsQuery = query(collection(db, "fee_structures"), 
                    where("schoolId", "==", currentSchoolId), 
                    where("classId", "==", student.classId), 
                    where("term", "==", term), 
                    where("year", "==", year)
                );
                const fsSnap = await getDocs(fsQuery);
                const expected = fsSnap.empty ? 0 : (fsSnap.docs[0].data().total || 0);

                // 2. Calculate total paid so far for this period (excluding current record if editing)
                const payQuery = query(collection(db, "fees"), 
                    where("schoolId", "==", currentSchoolId),
                    where("studentId", "==", studentId),
                    where("term", "==", term),
                    where("year", "==", year)
                );
                const paySnap = await getDocs(payQuery);
                let paidSoFar = 0;
                paySnap.forEach(d => { if(d.id !== editId) paidSoFar += (d.data().amount || 0); });

                const totalPaidToDate = paidSoFar + amount;
                const balance = expected - totalPaidToDate;

                const data = {
                    schoolId: currentSchoolId,
                    studentId, amount, method, term, year,
                    expected, paid: totalPaidToDate, balance, // Snapshot data for performance
                    reference: document.getElementById('fee-ref').value || "N/A",
                    note: document.getElementById('fee-note').value,
                    date: new Date().toISOString()
                };

                if(editId) {
                    const own = await getScopedDoc("fees", editId);
                    if(!own) return showToast("Record not found in your school", "error");
                    await updateDoc(doc(db, "fees", editId), data);
                    showToast("Payment record updated", "success");
                } else {
                    await addDoc(collection(db, "fees"), data);
                    showToast(`Payment of KES ${amount} recorded`, "success");
                }
                
                await generateFeeReceiptPDF(student, amount, method, term, year, studentId);
                closeModal('modal-fee');
            } catch (err) { showToast(getFriendlyErrorMessage(err), "error"); }
            finally { showLoader(false); }
        };

        window.editFeeRecord = async (id) => {
            if(!canEdit('fees')) return showToast("Permission denied", "error");
            const own = await getScopedDoc("fees", id);
            if(!own) return showToast("Record not found in your school", "error");
            const data = own.data;
            
            document.getElementById('fee-edit-id').value = id;
            document.getElementById('fee-student-select').value = data.studentId;
            document.getElementById('fee-term').value = data.term;
            document.getElementById('fee-year').value = data.year;
            document.getElementById('fee-amount').value = data.amount;
            document.getElementById('fee-method').value = data.method;
            document.getElementById('fee-ref').value = data.reference;
            document.getElementById('fee-note').value = data.note || '';
            
            openModal('modal-fee');
        };

        // --- EXAMINATION MANAGEMENT (single canonical saveExam) ---
        window.saveExam = async (e) => {
            e.preventDefault();
            if(!hasPermission('edit')) {
                showToast("Permission denied", "error");
                return;
            }

            const id = document.getElementById('exam-edit-id').value;
            if (!enforcePerm('assessments', id ? 'edit' : 'create')) { showToast("Permission denied", "error"); return; }
            const examName = document.getElementById('exam-name').value;
            const term = document.getElementById('exam-term').value;
            const year = parseInt(document.getElementById('exam-year').value);
            const studentId = document.getElementById('exam-student-select').value;

            const rows = document.querySelectorAll('.exam-subject-row');
            if (rows.length === 0) {
                showToast("No marks were entered to save.", "error");
                return;
            }

            showLoader(true);
            try {
                if(id) {
                    // Edit Mode (Updates one document)
                    const own = await getScopedDoc("exams", id);
                    if(!own) return showToast("Record not found in your school", "error");
                    const row = rows[0];
                    const subject = row.querySelector('.subject-name').value.trim();
                    if (subject === "" || subject === "__custom__") { showToast("Please choose or enter a subject.", "error"); showLoader(false); return; }
                    const marks = parseInt(row.querySelector('.subject-marks-input').value);
                    const data = {
                        schoolId: currentSchoolId, examName, studentId, subject,
                        term, year, marks, grade: getGrade(marks), 
                        updatedAt: new Date().toISOString()
                    };
                    await updateDoc(doc(db, "exams", id), data);
                    showToast("Exam record updated", "success");
                } else {
                    // Add Mode (Saves multiple documents)
                    for (let row of rows) {
                        const subject = row.querySelector('.subject-name').value.trim();
                        const marksVal = row.querySelector('.subject-marks-input').value.trim();
                        if (subject === "" || subject === "__custom__" || marksVal === "") continue;

                        const marks = parseInt(marksVal);
                        const data = {
                            schoolId: currentSchoolId, examName, studentId, subject,
                            term, year, marks, grade: getGrade(marks), date: new Date().toISOString()
                        };
                        await addDoc(collection(db, "exams"), data);
                    }
                    showToast("Examination marks have been published", "success");
                }
                closeModal('modal-exam');
            } catch (err) { showToast(getFriendlyErrorMessage(err), "error"); }
            finally { showLoader(false); }
        };

        window.editExam = async (id) => {
            const own = await getScopedDoc("exams", id);
            if(!own) return showToast("Record not found in your school", "error");
            const data = own.data;
            document.getElementById('exam-edit-id').value = id;
            document.getElementById('exam-name').value = data.examName;
            document.getElementById('exam-term').value = data.term || 'Term 1';
            document.getElementById('exam-year').value = data.year || 2025;
            document.getElementById('exam-student-select').value = data.studentId;
            
            document.getElementById('exam-add-row-btn').classList.add('hidden');
            document.getElementById('exam-subjects-list').innerHTML = "";
            window.addExamSubjectRow(data);
            
            document.getElementById('exam-modal-title').innerText = "Edit Exam Mark";
            openModal('modal-exam');
        };

        window.addExamSubjectRow = (data = null) => {
            const listDiv = document.getElementById('exam-subjects-list');
            const editId = document.getElementById('exam-edit-id').value;
            const rowId = 'ex-row-' + Date.now() + Math.floor(Math.random() * 1000);

            const row = document.createElement('div');
            row.className = 'flex align-center gap-10 exam-subject-row';
            row.id = rowId;

            // Build the subject dropdown from the school's declared subjects (allSubjects).
            // Only show active subjects.
            const activeSubjects = (allSubjects || [])
                .filter(s => s.active !== false)
                .sort((a, b) => String(a.name).localeCompare(String(b.name)));

            const optionsHtml = activeSubjects.map(s =>
                `<option value="${s.name.replace(/"/g, '&quot;')}">${s.name}</option>`
            ).join('');

            const currentSubject = data ? data.subject : '';

            row.innerHTML = `
                <select class="form-control subject-name" style="flex: 2;" required onchange="window.examSubjectToggled('${rowId}')">
                    <option value="">-- Select Subject --</option>
                    ${optionsHtml}
                    <option value="__custom__">Other / Custom Subject...</option>
                </select>
                <input type="number" class="form-control subject-marks-input" placeholder="Marks" min="0" max="100" value="${data ? data.marks : ''}" style="flex: 1;" required>
                ${!editId ? `
                    <button type="button" class="btn btn-danger btn-sm" onclick="document.getElementById('${rowId}').remove()" title="Remove Entry">
                        <i class="fas fa-times"></i>
                    </button>
                ` : ''}
            `;

            // If editing with a subject that isn't in the declared list, add it as a custom option.
            const sel = row.querySelector('.subject-name');
            if (data && currentSubject && !activeSubjects.some(s => s.name === currentSubject)) {
                const opt = document.createElement('option');
                opt.value = currentSubject;
                opt.textContent = currentSubject;
                sel.appendChild(opt);
            }
            if (data && currentSubject) {
                sel.value = currentSubject;
            } else if (!data && activeSubjects.length) {
                // Pre-select the first declared subject for convenience.
                sel.value = activeSubjects[0].name;
            }

            listDiv.appendChild(row);
        };

        // Supports typing a custom subject when "Other / Custom Subject..." is chosen.
        window.examSubjectToggled = (rowId) => {
            const row = document.getElementById(rowId);
            if (!row) return;
            const sel = row.querySelector('.subject-name');
            if (sel && sel.value === '__custom__') {
                // Swap the select for a text input so any subject name can be entered.
                const marksInput = row.querySelector('.subject-marks-input');
                const textInput = document.createElement('input');
                textInput.type = 'text';
                textInput.className = 'form-control subject-name';
                textInput.placeholder = 'Subject Name';
                textInput.style.flex = '2';
                textInput.required = true;
                sel.replaceWith(textInput);
            }
        };

        window.populateExamSubjects = () => {
            if (document.getElementById('exam-edit-id').value) return;
            document.getElementById('exam-add-row-btn').classList.remove('hidden');
            document.getElementById('exam-subjects-list').innerHTML = "";
            window.addExamSubjectRow(); 
        };

        // ==================== EXAM GROUPS (View / Edit / Delete) ====================
        // Each subject mark is its own Firestore doc; we group by exam+student+term+year
        // so the table shows ONE row per student per exam.
        function examKeyOf(examName, studentId, term, year) { return [examName, studentId, term, year].join('\u0000'); }
        function examKeyEncode(examName, studentId, term, year) { return encodeURIComponent(JSON.stringify([examName, studentId, term, year])); }
        function examKeyDecode(enc) { const a = JSON.parse(decodeURIComponent(enc)); return examKeyOf(a[0], a[1], a[2], a[3]); }

        window.viewExamGroup = (enc) => {
            const key = examKeyDecode(enc);
            const g = window.__examGroups ? window.__examGroups[key] : null;
            if (!g) return showToast("Exam group not found. Refresh the page and try again.", "error");
            const meta = g.meta;
            const student = allStudents.find(s => s.docId === meta.studentId);
            window.currentExamViewKey = key;
            window.currentExamViewMeta = meta;
            window.currentExamViewDocs = g.docs.slice();
            window.currentExamViewEnc = enc;

            document.getElementById('exam-view-title').innerText = `Examination Results Â· ${meta.examName} Â· ${meta.term} ${meta.year}`;
            const sumEl = document.getElementById('exam-view-summary');
            if (sumEl) sumEl.innerHTML = `Student: <b>${student ? student.name : 'Unknown'}</b>${student && student.studentId ? ` (${student.studentId})` : ''} Â· <b>${g.docs.length}</b> subject(s)`;

            const listEl = document.getElementById('exam-view-subjects-list');
            listEl.innerHTML = "";
            g.docs.slice().sort((a, b) => String(a.subject).localeCompare(String(b.subject)))
                .forEach(d => addExamViewSubjectRow({ docId: d.id, subject: d.subject, marks: d.marks }));
            openModal('modal-exam-view');
        };

        window.addExamViewSubjectRow = (data = null) => {
            const listEl = document.getElementById('exam-view-subjects-list');
            const rowId = 'vex-row-' + Date.now() + Math.floor(Math.random() * 1000);
            const row = document.createElement('div');
            row.className = 'flex align-center gap-10 exam-subject-row';
            row.id = rowId;
            row.innerHTML = `
                <input type="hidden" class="view-exam-row-id" value="${data && data.docId ? data.docId : ''}">
                <input type="text" class="form-control subject-name" placeholder="Subject" value="${data ? (data.subject || '') : ''}" style="flex:2;" required>
                <input type="number" class="form-control subject-marks-input" placeholder="Marks" min="0" max="100" value="${data ? (data.marks || '') : ''}" style="flex:1;" required>
                <button type="button" class="btn btn-danger btn-sm" onclick="document.getElementById('${rowId}').remove()" title="Remove Subject"><i class="fas fa-times"></i></button>`;
            listEl.appendChild(row);
        };

        window.saveExamView = async () => {
            if (!hasPermission('edit')) return showToast("Permission denied", "error");
            const meta = window.currentExamViewMeta;
            const key = window.currentExamViewKey;
            const g = window.__examGroups ? window.__examGroups[key] : null;
            if (!meta || !g) return showToast("Exam group not found", "error");

            const rows = document.querySelectorAll('#exam-view-subjects-list .exam-subject-row');
            const keptIds = [];
            const toAdd = [];
            showLoader(true);
            try {
                for (const row of rows) {
                    const subject = row.querySelector('.subject-name').value.trim();
                    const marksVal = row.querySelector('.subject-marks-input').value.trim();
                    const docId = row.querySelector('.view-exam-row-id').value;
                    if (!subject || marksVal === '') continue;
                    const marks = parseInt(marksVal);
                    const grade = getGrade(marks);
                    if (docId) {
                        keptIds.push(docId);
                        await updateDoc(doc(db, "exams", docId), { subject, marks, grade, updatedAt: new Date().toISOString() });
                    } else {
                        toAdd.push({ subject, marks, grade });
                    }
                }
                for (const nd of toAdd) {
                    await addDoc(collection(db, "exams"), {
                        schoolId: currentSchoolId, examName: meta.examName, studentId: meta.studentId,
                        subject: nd.subject, term: meta.term, year: meta.year, marks: nd.marks, grade: nd.grade,
                        date: meta.date || new Date().toISOString()
                    });
                }
                // Delete subjects removed from the view (existing ids no longer present)
                for (const d of g.docs) {
                    if (!keptIds.includes(d.id)) await deleteDoc(doc(db, "exams", d.id));
                }
                showToast("Exam results updated", "success");
                closeModal('modal-exam-view');
            } catch (err) { showToast(getFriendlyErrorMessage(err), "error"); }
            finally { showLoader(false); }
        };

        window.deleteExamGroup = async (enc) => {
            if (!hasPermission('delete')) return showToast("Permission denied", "error");
            const key = examKeyDecode(enc);
            const g = window.__examGroups ? window.__examGroups[key] : null;
            if (!g) return showToast("Exam group not found", "error");
            if (!confirm(`Delete all ${g.docs.length} record(s) for â€œ${g.meta.examName}â€?`)) return;
            try {
                for (const d of g.docs) await deleteDoc(doc(db, "exams", d.id));
                showToast("Exam records deleted", "success");
            } catch (err) { showToast(getFriendlyErrorMessage(err), "error"); }
        };

        window.filterExamTable = () => {
            const q = (document.getElementById('exam-search').value || '').toLowerCase();
            const fExam = (document.getElementById('exam-filter-name').value || '').toLowerCase();
            const fClass = (document.getElementById('exam-filter-class').value || '').toLowerCase();
            document.querySelectorAll('#exam-list-table tbody tr').forEach(row => {
                const st = row.dataset.student || '';
                const sid = row.dataset.sid || '';
                const ex = row.dataset.exam || '';
                const cl = row.dataset.class || '';
                const matchQ = !q || st.includes(q) || sid.includes(q) || ex.includes(q);
                const matchExam = !fExam || ex === fExam;
                const matchClass = !fClass || cl === fClass;
                row.style.display = (matchQ && matchExam && matchClass) ? "" : "none";
            });
        };

        // ==================== TIMETABLE MODULE ====================
        let ttSlots = {};              // key: "day-period" -> { subject, teacherId, time }
        let ttTeacherMap = {};         // teacherId -> name (for export/display)
        const TT_DAYS = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri'];
        const TT_PERIODS = 8;

        window.loadTimetable = async () => {
            const classId = document.getElementById('tt-class-select').value;
            const term = document.getElementById('tt-term').value;
            const year = parseInt(document.getElementById('tt-year').value) || currentAcademicYear;
            const container = document.getElementById('timetable-container');
            const actions = document.getElementById('timetable-actions');
            if (!classId) {
                if (container) container.innerHTML = '<p class="text-muted">Select a class to build the timetable.</p>';
                if (actions) actions.style.display = 'none';
                return;
            }

            let slots = {};
            const ttDoc = await getScopedDoc('timetables', `tt_${classId}_${term}_${year}`);
            if (ttDoc) slots = ttDoc.data.slots || {};
            ttSlots = slots;
            ttTeacherMap = {};

            const ownClass = await getScopedDoc('classes', classId);
            if(!ownClass) {
                if (container) container.innerHTML = '<p class="text-muted">Class not found in your school.</p>';
                if (actions) actions.style.display = 'none';
                return;
            }
            const cls = ownClass.data;
            const subjects = cls.subjects || [];
            const teachSnap = await getDocs(query(collection(db, 'teachers'), where('schoolId', '==', currentSchoolId)));
            teachSnap.forEach(d => ttTeacherMap[d.id] = d.data().name);

            let html = `<div class="tt-grid">`;
            html += `<div class="tt-head">Period</div>`;
            TT_DAYS.forEach(d => html += `<div class="tt-head">${d}</div>`);
            for (let p = 1; p <= TT_PERIODS; p++) {
                html += `<div class="tt-period">P${p}</div>`;
                const startH = 7 + (p - 1);
                const startT = String(startH).padStart(2, '0') + ':00';
                const endT = String(startH + 1).padStart(2, '0') + ':00';
                TT_DAYS.forEach(day => {
                    const key = `${day}-${p}`;
                    const slot = slots[key] || {};
                    const time = (slot.time && slot.time.indexOf('-') > -1) ? slot.time : `${startT}-${endT}`;
                    let subjOpts = '<option value="">Subject</option>';
                    subjects.forEach(s => subjOpts += `<option value="${s.name}" ${slot.subject === s.name ? 'selected' : ''}>${s.name}</option>`);
                    let tOpts = '<option value="">â€” Teacher â€”</option>';
                    teachSnap.forEach(d => tOpts += `<option value="${d.id}" ${slot.teacherId === d.id ? 'selected' : ''}>${d.data().name}</option>`);
                    html += `<div class="tt-cell">
                        <select class="tt-subj" onchange="ttUpdate('${day}', ${p}, 'subject', this.value)">${subjOpts}</select>
                        <select class="tt-teach" onchange="ttUpdate('${day}', ${p}, 'teacherId', this.value)">${tOpts}</select>
                        <input class="tt-time" value="${time}" onchange="ttUpdate('${day}', ${p}, 'time', this.value)">
                    </div>`;
                });
            }
            html += `</div>`;
            if (container) container.innerHTML = html;
            if (actions) actions.style.display = 'flex';
        };

        window.ttUpdate = (day, period, field, value) => {
            const key = `${day}-${period}`;
            if (!ttSlots[key]) ttSlots[key] = { subject: '', teacherId: '', time: '' };
            ttSlots[key][field] = value;
        };

        window.saveTimetable = async () => {
            const classId = document.getElementById('tt-class-select').value;
            const term = document.getElementById('tt-term').value;
            const year = parseInt(document.getElementById('tt-year').value) || currentAcademicYear;
            if (!classId) return showToast("Select a class first", "warning");
            showLoader(true);
            try {
                const ownClass = await getScopedDoc('classes', classId);
                if(!ownClass) return showToast("Class not found in your school", "error");
                await setDoc(doc(db, 'timetables', `tt_${classId}_${term}_${year}`), {
                    schoolId: currentSchoolId, classId, term, year,
                    slots: ttSlots, updatedAt: new Date().toISOString()
                }, { merge: true });
                showToast("Timetable saved for " + term + " " + year, "success");
            } catch (err) { showToast(getFriendlyErrorMessage(err), "error"); }
            finally { showLoader(false); }
        };

        window.clearTimetableSlots = () => {
            if (!confirm("Clear every slot for this class timetable?")) return;
            ttSlots = {};
            loadTimetable();
            showToast("Timetable cleared â€” press Save to persist", "warning");
        };

        window.exportTimetableCSV = () => {
            const rows = [];
            rows.push(['Period', ...TT_DAYS]);
            for (let p = 1; p <= TT_PERIODS; p++) {
                const row = [`P${p}`];
                TT_DAYS.forEach(day => {
                    const s = ttSlots[`${day}-${p}`] || {};
                    row.push(`${s.subject || ''}${s.subject && s.teacherId ? ' (' + (ttTeacherMap[s.teacherId] || 'â€”') + ')' : ''}`);
                });
                rows.push(row);
            }
            downloadCSV(`Timetable_${currentTerm.replace(/\s/g, '')}_${currentAcademicYear}.csv`, rows);
            showToast("Timetable CSV exported", "success");
        };

        // ==================== FEE SUMMARY MODULE ====================
        function downloadCSV(filename, rows) {
            const csv = rows.map(r => r.map(c => `"${String(c || '').replace(/"/g, '""')}"`).join(',')).join('\n');
            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url; a.download = filename;
            document.body.appendChild(a); a.click();
            document.body.removeChild(a);
            setTimeout(() => URL.revokeObjectURL(url), 1000);
        }

        window.renderFeeSummary = async () => {
            showLoader(true);
            try {
                const classFilter = document.getElementById('fee-summary-class').value;
                const term = document.getElementById('fee-summary-term').value;
                const yearEl = document.getElementById('fee-summary-year');
                if (yearEl && !yearEl.value) yearEl.value = currentAcademicYear;
                const year = parseInt(yearEl.value) || currentAcademicYear;

                const studSnap = await getDocs(query(collection(db, 'students'), where('schoolId', '==', currentSchoolId)));
                const classSnap = await getDocs(query(collection(db, 'classes'), where('schoolId', '==', currentSchoolId)));
                const fsSnap = await getDocs(query(collection(db, 'fee_structures'), where('schoolId', '==', currentSchoolId), where('term', '==', term), where('year', '==', year)));
                const paySnap = await getDocs(query(collection(db, 'fees'), where('schoolId', '==', currentSchoolId), where('term', '==', term), where('year', '==', year)));

                const classMap = {};
                classSnap.forEach(d => classMap[d.id] = d.data().name);
                const expectedMap = {};
                fsSnap.forEach(d => { expectedMap[d.data().classId] = d.data().total || 0; });
                const paidMap = {};
                paySnap.forEach(d => { const f = d.data(); paidMap[f.studentId] = (paidMap[f.studentId] || 0) + (f.amount || 0); });

                const byClass = {};
                studSnap.forEach(d => {
                    const s = d.data();
                    if (classFilter && s.classId !== classFilter) return;
                    if (!byClass[s.classId]) byClass[s.classId] = { count: 0, expected: 0, paid: 0 };
                    const b = byClass[s.classId];
                    b.count++;
                    b.expected += expectedMap[s.classId] || 0;
                    b.paid += paidMap[d.id] || 0;
                });

                const tbody = document.getElementById('fee-summary-body');
                tbody.innerHTML = '';
                const cids = Object.keys(byClass).sort();
                if (cids.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; color:var(--text-muted);">No data found for the selected filters.</td></tr>';
                    return;
                }
                let tCount = 0, tExp = 0, tPaid = 0;
                cids.forEach(cid => {
                    const b = byClass[cid];
                    const bal = b.expected - b.paid;
                    const pct = b.expected > 0 ? Math.min(100, Math.round((b.paid / b.expected) * 100)) : 0;
                    tCount += b.count; tExp += b.expected; tPaid += b.paid;
                    tbody.innerHTML += `<tr>
                        <td><b>${classMap[cid] || 'Unassigned'}</b></td>
                        <td>${b.count}</td>
                        <td>${fmtKES(b.expected)}</td>
                        <td style="color:var(--success); font-weight:700;">${fmtKES(b.paid)}</td>
                        <td style="color:${bal > 0 ? 'var(--danger)' : 'var(--success)'}; font-weight:700;">${fmtKES(bal)}</td>
                        <td>${pct}%</td>
                    </tr>`;
                });
                tbody.innerHTML += `<tr class="fs-total">
                    <td>TOTAL Â· ${term} ${year}</td>
                    <td>${tCount}</td>
                    <td>${fmtKES(tExp)}</td>
                    <td>${fmtKES(tPaid)}</td>
                    <td>${fmtKES(tExp - tPaid)}</td>
                    <td>${tExp > 0 ? Math.round((tPaid / tExp) * 100) : 0}%</td>
                </tr>`;
            } catch (err) { showToast(getFriendlyErrorMessage(err), "error"); }
            finally { showLoader(false); }
        };

        window.exportFeeSummaryCSV = () => {
            const table = document.getElementById('fee-summary-table');
            if (!table) return;
            const rows = [];
            table.querySelectorAll('tr').forEach(r => rows.push(Array.from(r.cells).map(c => c.innerText)));
            downloadCSV(`FeeSummary_${currentTerm.replace(/\s/g, '')}_${currentAcademicYear}.csv`, rows);
            showToast("Fee summary exported", "success");
        };

