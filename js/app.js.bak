        window.saveBorrowing = async (e) => {
            e.preventDefault();
            if (!canOp()) return showToast("Permission denied", "error");
            const bookId = document.getElementById('borrow-book').value;
            const studentId = document.getElementById('borrow-student').value;
            if (!bookId || !studentId) return showToast("Select book and student", "warning");
            try {
                const ownBook = await getScopedDoc('books', bookId);
                if(!ownBook) return showToast("Book not found in your school", "error");
                const book = ownBook.data;
                const ownStudent = await getScopedDoc('students', studentId);
                if(!ownStudent) return showToast("Student not found in your school", "error");
                if (!book || book.availableCopies <= 0) return showToast("No copies available", "error");
                await addDoc(collection(db, 'borrowings'), {
                    schoolId: currentSchoolId, bookId, studentId,
                    borrowDate: new Date().toISOString().slice(0, 10),
                    dueDate: document.getElementById('borrow-due').value,
                    status: 'active'
                });
                await updateDoc(doc(db, 'books', bookId), { availableCopies: book.availableCopies - 1 });
                closeModal('modal-borrow');
                showToast("Book issued to student", "success");
            } catch (err) { showToast(getFriendlyErrorMessage(err), "error"); }
        };

        window.returnBook = async (borrowId) => {
            if (!confirm("Mark this book as returned?")) return;
            try {
                const bn = await getScopedDoc('borrowings', borrowId);
                if (!bn) return showToast("Record not found in your school", "error");
                const b = bn.data;
                const bk = await getScopedDoc('books', b.bookId);
                if(!bk) return showToast("Book not found in your school", "error");
                await updateDoc(doc(db, 'books', b.bookId), { availableCopies: bk.data.availableCopies + 1 });
                await updateDoc(doc(db, 'borrowings', borrowId), { status: 'returned', returnDate: new Date().toISOString().slice(0, 10) });
                showToast("Book returned", "success");
            } catch (err) { showToast(getFriendlyErrorMessage(err), "error"); }
