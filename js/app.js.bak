        // 8. Settings
        window.previewSchoolLogo = (input) => {
            const preview = document.getElementById('school-logo-preview');
            if (!preview) return;
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = (e) => { preview.innerHTML = `<img src="${e.target.result}">`; };
                reader.readAsDataURL(input.files[0]);
            }
        };

        window.saveSettings = async () => {
            if(!canEdit('settings')) {
                showToast("Permission denied", "error");
                return;
            }

            const name = document.getElementById('set-school-name').value;
            const location = document.getElementById('set-school-location').value;
            const motto = document.getElementById('set-school-motto').value;
            const contact = document.getElementById('set-school-contact').value;
            const adminName = document.getElementById('set-admin-name').value;
            const newYear = parseInt(document.getElementById('set-academic-year').value) || new Date().getFullYear();
            const newTerm = document.getElementById('set-current-term').value;
            const principalName = document.getElementById('set-principal-name').value;
            const themeColor = document.getElementById('set-theme-color').value || '#800000';
            const paymentInfo = document.getElementById('set-payment-info').value;
            const admMode = document.getElementById('set-admission-mode') ? document.getElementById('set-admission-mode').value : (schoolSettings.admissionConfig || {}).mode || 'auto';
            const admPrefix = (document.getElementById('set-admission-prefix') ? document.getElementById('set-admission-prefix').value : (schoolSettings.admissionConfig || {}).prefix || '');
            const admissionConfig = { mode: admMode, prefix: admPrefix };
            // Grade ranges: parse and order them so A >= B >= C >= D.
            const useGrades = document.getElementById('set-use-grades') ? document.getElementById('set-use-grades').checked : true;
            const gradeNum = (id) => { const v = parseFloat(document.getElementById(id)?.value); return !isNaN(v) ? v : 80; };
            let gd = gradeNum('set-grade-d'), gc = gradeNum('set-grade-c'), gb = gradeNum('set-grade-b'), ga = gradeNum('set-grade-a');
            // Ensure descending thresholds (A is the highest).
            gd = Math.max(0, gd); gc = Math.max(gd, gc); gb = Math.max(gc, gb); ga = Math.max(gb, ga);
            const gradeConfig = { enabled: useGrades, a: ga, b: gb, c: gc, d: gd };
            const logoInput = document.getElementById('set-school-logo');

            showLoader(true);
            try {
                let logoUrl = schoolSettings.logoUrl || '';
                if (logoInput && logoInput.files && logoInput.files[0]) {
                    const storageRef = ref(storage, `school_logos/${currentSchoolId}/${Date.now()}_${logoInput.files[0].name}`);
                    const upload = await uploadBytes(storageRef, logoInput.files[0]);
                    logoUrl = await getDownloadURL(upload.ref);
                }
                await updateDoc(doc(db, "schools", currentSchoolId), {
                    name, location, motto, contact, adminName,
                    academicYear: newYear, currentTerm: newTerm, principalName, themeColor, paymentInfo, logoUrl, admissionConfig, gradeConfig
                });
                currentAcademicYear = newYear;
                currentTerm = newTerm;
                schoolSettings = { ...schoolSettings, name, location, motto, contact, adminName, academicYear: newYear, currentTerm: newTerm, principalName, themeColor, paymentInfo, logoUrl, admissionConfig, gradeConfig };
                applyTheme(themeColor);
                document.getElementById('school-name-sidebar').innerText = name;
                showToast("Settings updated successfully", "success");
                // Use window.location explicitly: the local `location` string (school address) shadows it here.
                setTimeout(() => window.location.reload(), 1000);
            } catch (err) { showToast(getFriendlyErrorMessage(err), "error"); }
            finally { showLoader(false); }
        };

        // --- REALTIME LISTENERS & RENDERING ---
